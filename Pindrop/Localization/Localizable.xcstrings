            "state": "translated",
            "value": "Les vérifications de mise à jour sont temporairement indisponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקות עדכון אינן זמינות באופן זמני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
