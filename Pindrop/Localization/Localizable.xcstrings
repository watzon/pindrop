    "show_who_is_talking_in_the_live_transcript_names": {
      "comment": "Show who is talking in the live transcript. Names are checked again when the recording ends.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر من يتحدث في النص المباشر. يُعاد التحقق من الأسماء عند انتهاء التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ প্রতিলিপিতে কে কথা বলছে তা দেখান। রেকর্ডিং শেষ হলে নাম আবার যাচাই করা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukáže v živém přepisu, kdo mluví. Jména se po skončení nahrávání ověří znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis i liveudskriften, hvem der taler. Navnene tjekkes igen, når optagelsen slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt im Live-Transkript, wer spricht. Die Namen werden erneut geprüft, wenn die Aufnahme endet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείχνει ποιος μιλάει στη ζωντανή απομαγνητοφώνηση. Τα ονόματα ελέγχονται ξανά όταν τελειώσει η εγγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show who is talking in the live transcript. Names are checked again when the recording ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra quién habla en la transcripción en vivo. Los nombres se revisan otra vez cuando termina la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää reaaliaikaisessa tekstityksessä, kuka puhuu. Nimet tarkistetaan uudelleen, kun tallennus päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche qui parle dans la transcription en direct. Les noms sont revérifiés à la fin de l'enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת מי מדבר בתמליל החי. השמות נבדקים שוב בסיום ההקלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव प्रतिलेख में दिखाएँ कि कौन बोल रहा है। रिकॉर्डिंग खत्म होने पर नाम फिर से जाँचे जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megmutatja az élő átiratban, ki beszél. A neveket a felvétel végén újra ellenőrizzük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan siapa yang berbicara di transkrip langsung. Nama diperiksa lagi saat rekaman selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra chi parla nella trascrizione dal vivo. I nomi vengono ricontrollati quando la registrazione finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こしに誰が話しているかを表示します。名前は録音が終わるともう一度確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 대본에 누가 말하는지 표시합니다. 이름은 녹음이 끝나면 다시 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan siapa yang bercakap dalam transkrip langsung. Nama disemak semula apabila rakaman tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis i direktetranskriptet hvem som snakker. Navnene sjekkes på nytt når opptaket slutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont in het live transcript wie er praat. De namen worden opnieuw gecontroleerd als de opname stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje w transkrypcji na żywo, kto mówi. Imiona są sprawdzane ponownie po zakończeniu nagrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quem está falando na transcrição ao vivo. Os nomes são conferidos de novo quando a gravação termina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată cine vorbește în transcrierea în direct. Numele sunt verificate din nou când se termină înregistrarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает в живом транскрипте, кто говорит. Имена проверяются ещё раз, когда запись заканчивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar i livetranskriptet vem som talar. Namnen kontrolleras igen när inspelningen slutar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงว่าใครกำลังพูดในข้อความถอดเสียงสด ชื่อจะถูกตรวจอีกครั้งเมื่อการบันทึกสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı deşifrede kimin konuştuğunu gösterir. Adlar kayıt bitince yeniden denetlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує в живому транскрипті, хто говорить. Імена перевіряються ще раз, коли запис завершується."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện ai đang nói trong bản chép lời trực tiếp. Tên được kiểm tra lại khi bản ghi kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在实时转录中显示谁在说话。录音结束后会重新核对姓名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在即時逐字稿中顯示誰在說話。錄音結束後會重新核對名稱。"
          }
        }
      }
    },
    "shows_as_a_liquid_glass_orb_in_the_corner_of_the": {
