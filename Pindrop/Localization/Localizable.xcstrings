    "import_or_transcribe_media_while_this_folder_is": {
      "comment": "import_or_transcribe_media_while_this_folder_is",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم باستيراد الوسائط أو نسخها أثناء تحديد هذا المجلد لحفظ العناصر هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে আইটেমগুলি সংরক্ষণ করতে এই ফোল্ডারটি নির্বাচন করার সময় মিডিয়া আমদানি বা প্রতিলিপি করুন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importujte nebo přepisujte média, když je vybrána tato složka, aby se sem ukládaly položky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer eller transskriber medier, mens denne mappe er valgt for at gemme elementer her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren oder transkribieren Sie Medien, während dieser Ordner ausgewählt ist, um Elemente hier zu speichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγωγή ή μεταγραφή πολυμέσων ενώ αυτός ο φάκελος είναι επιλεγμένος για αποθήκευση στοιχείων εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import or transcribe media while this folder is selected to save items here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa o transcribe medios mientras esta carpeta esté seleccionada para guardar elementos aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo tai litteröi mediaa, kun tämä kansio on valittuna, jotta kohteet tallennetaan tähän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez ou transcrivez des médias lorsque ce dossier est sélectionné pour y enregistrer les éléments."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבא או תמלול מדיה בזמן שהתיקיה הזו נבחרת כדי לשמור פריטים כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहां आइटम सहेजने के लिए इस फ़ोल्डर का चयन करते समय मीडिया को आयात या ट्रांसक्राइब करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Amíg ez a mappa ki van választva, importáljon vagy írjon át médiát az elemek ide mentéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor atau transkripsikan media saat folder ini dipilih untuk menyimpan item di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa o trascrivi contenuti multimediali mentre questa cartella è selezionata per salvare qui gli elementi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーが選択されているときにメディアをインポートまたは転写して、アイテムをここに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 항목을 저장하려면 이 폴더를 선택한 동안 미디어를 가져오거나 복사하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Import atau transkripsi media semasa folder ini dipilih untuk menyimpan item di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer eller transkriber media mens denne mappen er valgt for å lagre elementer her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer of transcribeer media terwijl deze map is geselecteerd om items hier op te slaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj lub transkrybuj multimedia, gdy ten folder jest wybrany, aby zapisywać tutaj elementy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe ou transcreva mídia enquanto esta pasta estiver selecionada para salvar itens aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Importați sau transcrieți conținut media în timp ce acest dosar este selectat pentru a salva elemente aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте или расшифровывайте медиафайлы, пока выбрана эта папка, чтобы сохранять здесь элементы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera eller transkribera media medan den här mappen är vald för att spara objekt här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าหรือถอดเสียงสื่อในขณะที่เลือกโฟลเดอร์นี้เพื่อบันทึกรายการที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğeleri buraya kaydetmek için bu klasör seçiliyken medyayı içe aktarın veya metne dönüştürün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуйте або транскрибуйте медіафайли, коли вибрано цю папку, щоб зберігати тут елементи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập hoặc chép lại phương tiện trong khi thư mục này được chọn để lưu các mục tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此文件夹时导入或转录媒体以将项目保存在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇此資料夾時匯入或轉錄媒體以將專案儲存在此處。"
          }
        }
      }
    },
