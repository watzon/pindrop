    "u9_onboarding_ready_instruction_format": {
      "comment": "u9_onboarding_ready_instruction_format",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط %@ وابدأ التحدث — يكتب Pindrop أينما كان المؤشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ চাপুন এবং কথা বলা শুরু করুন — কার্সর যেখানে আছে Pindrop সেখানেই টাইপ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiskněte %@ a začněte mluvit — Pindrop píše všude, kde je kurzor."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på %@ og begynd at tale — Pindrop skriver, hvor markøren er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke %@ und sprich los — Pindrop schreibt dort, wo sich dein Cursor befindet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε %@ και αρχίστε να μιλάτε — το Pindrop πληκτρολογεί όπου βρίσκεται ο δρομέας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ and start talking — Pindrop types wherever your cursor is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ y empieza a hablar: Pindrop escribe donde esté el cursor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina %@ ja aloita puhuminen — Pindrop kirjoittaa kohdistimen kohdalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ et commencez à parler — Pindrop écrit là où se trouve votre curseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו על %@ והתחילו לדבר — Pindrop מקליד בכל מקום שבו נמצא הסמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दबाएँ और बोलना शुरू करें — कर्सर जहाँ हो, Pindrop वहीं टाइप करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja meg ezt: %@, és kezdjen beszélni — a Pindrop oda gépel, ahol a kurzor van."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan %@ dan mulailah berbicara — Pindrop mengetik di mana pun kursor berada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ e inizia a parlare: Pindrop scrive ovunque si trovi il cursore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を押して話し始めてください。Pindrop がカーソルの位置に入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을 누르고 말하기 시작하세요. Pindrop이 커서가 있는 곳에 입력합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan %@ dan mula bercakap — Pindrop menaip di mana sahaja kursor berada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk %@ og begynn å snakke — Pindrop skriver der markøren er."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op %@ en begin te praten — Pindrop typt waar je cursor staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij %@ i zacznij mówić — Pindrop pisze tam, gdzie znajduje się kursor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione %@ e comece a falar — o Pindrop digita onde estiver o cursor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați %@ și începeți să vorbiți — Pindrop scrie oriunde se află cursorul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите %@ и начинайте говорить — Pindrop печатает там, где находится курсор."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på %@ och börja prata — Pindrop skriver där markören är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด %@ แล้วเริ่มพูด — Pindrop จะพิมพ์ตรงตำแหน่งเคอร์เซอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'ye basın ve konuşmaya başlayın — Pindrop imlecinizin bulunduğu yere yazar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть %@ і починайте говорити — Pindrop друкує там, де розташований курсор."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn %@ và bắt đầu nói — Pindrop nhập tại vị trí con trỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 %@ 并开始说话 — Pindrop 会在光标所在位置输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下 %@ 並開始說話 — Pindrop 會在游標所在位置輸入。"
          }
        }
      }
    },
