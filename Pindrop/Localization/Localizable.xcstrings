    "u9_onboarding_download_background_hint": {
      "comment": "u9_onboarding_download_background_hint",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع الإعداد أثناء التنزيل — سنكمله في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাউনলোড চলার সময় সেটআপ চালিয়ে যান — আমরা পটভূমিতে শেষ করব।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračujte v nastavení během stahování — dokončíme ho na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsæt opsætningen, mens den downloader — vi gør den færdig i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fahre während des Downloads mit der Einrichtung fort — wir schließen sie im Hintergrund ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίστε τη ρύθμιση κατά τη λήψη — θα ολοκληρώσουμε στο παρασκήνιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep setting up while it downloads — we'll finish in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue configurando mientras se descarga; terminaremos en segundo plano."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatka määritystä latauksen aikana — viimeistelemme taustalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez la configuration pendant le téléchargement — nous terminerons en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להמשיך בהגדרה בזמן ההורדה — נסיים ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड के दौरान सेटअप जारी रखें — हम इसे बैकग्राउंड में पूरा कर देंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytassa a beállítást letöltés közben — a háttérben befejezzük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan penyiapan saat mengunduh — kami akan menyelesaikannya di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua la configurazione durante il download: termineremo in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード中も設定を続けられます。残りはバックグラウンドで完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하는 동안 설정을 계속하세요. 나머지는 백그라운드에서 완료됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teruskan persediaan semasa muat turun — kami akan menyelesaikannya di latar belakang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett oppsettet mens den lastes ned — vi fullfører i bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga door met instellen tijdens het downloaden — we ronden het op de achtergrond af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj konfigurację podczas pobierania — dokończymy w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue a configuração durante o download — terminaremos em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuați configurarea în timpul descărcării — vom finaliza în fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте настройку во время загрузки — мы завершим её в фоновом режиме."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt konfigurera medan hämtningen pågår — vi slutför i bakgrunden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าต่อได้ระหว่างดาวน์โหลด — เราจะดำเนินการให้เสร็จในเบื้องหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme sürerken kuruluma devam edin — arka planda tamamlayacağız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуйте налаштування під час завантаження — ми завершимо у фоновому режимі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục thiết lập trong khi tải xuống — chúng tôi sẽ hoàn tất trong nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载时可继续设置 — 我们将在后台完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載時可繼續設定 — 我們會在背景完成。"
          }
        }
      }
    },
