    "your_notes_and_the_enhanced_note_stay_the_transc": {
      "comment": "Your notes and the enhanced note stay. The transcript is hidden from this note.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملاحظاتك والملاحظة المعززة. يُخفى النص من هذه الملاحظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নোট আর উন্নত নোট থেকে যায়। এই নোটে প্রতিলিপি লুকানো থাকে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poznámky a vylepšená poznámka zůstanou. Přepis se v této poznámce skryje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine noter og den forbedrede note bliver. Udskriften skjules i denne note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Notizen und die verbesserte Notiz bleiben. Das Transkript wird in dieser Notiz ausgeblendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι σημειώσεις σας και η βελτιωμένη σημείωση μένουν. Η απομαγνητοφώνηση κρύβεται από αυτή τη σημείωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your notes and the enhanced note stay. The transcript is hidden from this note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas y la nota mejorada se quedan. La transcripción se oculta en esta nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanosi ja parannettu muistiinpano säilyvät. Tekstitys piilotetaan tästä muistiinpanosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes et la note améliorée restent. La transcription est masquée dans cette note."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפתקים שלכם והפתק המשופר נשארים. התמליל מוסתר בפתק הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके नोट्स और उन्नत नोट बने रहते हैं। इस नोट में प्रतिलेख छिपा दिया जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetei és a feljavított jegyzet megmaradnak. Az átirat elrejtve marad ebben a jegyzetben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan Anda dan catatan yang disempurnakan tetap ada. Transkrip disembunyikan dari catatan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue note e la nota migliorata restano. La trascrizione è nascosta in questa nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモと強化メモは残ります。文字起こしはこのメモから隠されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모와 보강 메모는 남습니다. 대본은 이 메모에서 숨겨집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota anda dan nota dipertingkat kekal. Transkrip disembunyikan daripada nota ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatene dine og det forbedrede notatet blir værende. Transkriptet skjules i dette notatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je notities en de verbeterde notitie blijven. Het transcript wordt in deze notitie verborgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje notatki i ulepszona notatka zostają. Transkrypcja zostaje ukryta w tej notatce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas notas e a nota aprimorada ficam. A transcrição fica oculta nesta nota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notițele dvs. și notița îmbunătățită rămân. Transcrierea este ascunsă în această notiță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши заметки и улучшенная заметка останутся. Транскрипт скрыт в этой заметке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina anteckningar och den förbättrade anteckningen blir kvar. Transkriptet döljs i den här anteckningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตของคุณและโน้ตที่ปรับปรุงแล้วยังอยู่ ข้อความถอดเสียงจะถูกซ่อนจากโน้ตนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notlarınız ve geliştirilmiş not kalır. Deşifre bu notta gizlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші нотатки й покращена нотатка залишаються. Транскрипт сховано в цій нотатці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú của bạn và ghi chú nâng cao vẫn còn. Bản chép lời được ẩn khỏi ghi chú này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的笔记和增强笔记会保留。转录会在这条笔记中隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的筆記和增強筆記會保留。逐字稿會在這則筆記中隱藏。"
          }
        }
      }
    },
