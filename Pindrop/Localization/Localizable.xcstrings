    "u8_settings_removes_kept_dictation_audio": {
      "comment": "u8_settings_removes_kept_dictation_audio",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف ملفات صوت الإملاء المحتفظ بها. تبقى النصوص في مكتبتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত ডিক্টেশন অডিও ফাইল মুছে দেয়। প্রতিলিপি আপনার লাইব্রেরিতে থেকে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní uložené zvukové soubory diktování. Přepisy zůstanou ve vaší knihovně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner gemte lydfiler fra diktering. Udskrifter forbliver i dit bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht gespeicherte Diktier-Audiodateien. Transkripte bleiben in der Bibliothek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράφει τα αποθηκευμένα αρχεία ήχου υπαγόρευσης. Οι μεταγραφές παραμένουν στη Βιβλιοθήκη σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes kept dictation audio files. Transcripts stay in your Library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los archivos de audio de dictado guardados. Las transcripciones permanecen en la Biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa tallennetut sanelun äänitiedostot. Transkriptiot säilyvät kirjastossasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les fichiers audio de dictée conservés. Les transcriptions restent dans la Bibliothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוחק את קובצי האודיו השמורים של ההכתבה. התמלולים נשארים בספרייה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखे गए श्रुतलेख ऑडियो फ़ाइलों को हटाता है। प्रतिलेख आपकी लाइब्रेरी में बने रहते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a megőrzött diktálási hangfájlokat. Az átiratok megmaradnak a Könyvtárban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus file audio dikte yang disimpan. Transkrip tetap ada di Pustaka Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove i file audio della dettatura conservati. Le trascrizioni restano nella tua Libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持されたディクテーション音声を削除します。文字起こしはライブラリに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 받아쓰기 오디오 파일을 삭제합니다. 전사 내용은 라이브러리에 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadamkan fail audio dikte yang disimpan. Transkrip kekal dalam Pustaka anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
