    "still_working_long_recordings_take_a_while": {
      "comment": "Still working. Long recordings take a while.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العمل جارٍ. التسجيلات الطويلة تستغرق وقتًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কাজ চলছে। দীর্ঘ রেকর্ডিংয়ে কিছুটা সময় লাগে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stále to běží. Dlouhé nahrávky chvíli trvají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejder stadig. Lange optagelser tager et stykke tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft noch. Lange Aufnahmen dauern eine Weile."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζεται. Οι μεγάλες εγγραφές θέλουν λίγη ώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still working. Long recordings take a while."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue en marcha. Las grabaciones largas tardan un rato."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työ jatkuu. Pitkät tallenteet vievät hetken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours en cours. Les longs enregistrements prennent du temps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין עובד. הקלטות ארוכות לוקחות זמן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम अब भी चल रहा है। लंबी रिकॉर्डिंग में कुछ समय लगता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még dolgozik. A hosszú felvételek eltartanak egy ideig."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih berjalan. Rekaman panjang butuh waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora in corso. Le registrazioni lunghe richiedono tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ処理中です。長い録音は時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 처리 중입니다. 긴 녹음은 시간이 걸립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masih berjalan. Rakaman panjang mengambil masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobber fortsatt. Lange opptak tar litt tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog bezig. Lange opnamen duren even."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wciąż trwa. Długie nagrania zajmują chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda processando. Gravações longas demoram um pouco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă lucrează. Înregistrările lungi durează o vreme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа продолжается. Длинные записи занимают время."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbetar fortfarande. Långa inspelningar tar en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังทำงานอยู่ การบันทึกที่ยาวใช้เวลาสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hâlâ çalışıyor. Uzun kayıtlar biraz sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Робота триває. Довгі записи потребують часу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn đang xử lý. Bản ghi dài cần một lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在处理。较长的录音需要一些时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在處理。較長的錄音需要一些時間。"
          }
        }
      }
    },
