            "state": "translated",
            "value": "Alcune scorciatoie sono in conflitto tra loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のショートカットが互いに競合しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 단축키가 서로 충돌합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesetengah pintasan berkonflik antara satu sama lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen snarveier er i konflikt med hverandre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige sneltoetsen conflicteren met elkaar."
          }
        },
        "pl": {
