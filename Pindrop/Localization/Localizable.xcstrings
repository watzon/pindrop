    "two_new_dictation_languages_fully_wired_into_mod": {
      "comment": "two_new_dictation_languages_fully_wired_into_mod",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لغتان جديدتان للإملاء، متصلتان بالكامل بتوصيات النماذج."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুটি নতুন ডিক্টেশন ভাষা, মডেল সুপারিশে সম্পূর্ণভাবে যুক্ত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva nové jazyky diktování, plně napojené na doporučení modelů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "To nye dikteringssprog, fuldt forbundet med modelanbefalinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei neue Diktiersprachen, vollständig in die Modellempfehlungen eingebunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δύο νέες γλώσσες υπαγόρευσης, πλήρως συνδεδεμένες με τις προτάσεις μοντέλων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two new dictation languages, fully wired into model recommendations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos nuevos idiomas de dictado, completamente integrados con las recomendaciones de modelos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaksi uutta sanelukieltä, täysin liitettynä mallisuosituksiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux nouvelles langues de dictée, entièrement reliées aux recommandations de modèles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתי שפות הכתבה חדשות, מחוברות במלואן להמלצות המודלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो नई डिक्टेशन भाषाएँ, मॉडल सिफारिशों से पूरी तरह जुड़ी हुई।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Két új diktálási nyelv, teljesen bekötve a modellajánlásokba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua bahasa dikte baru, sepenuhnya terhubung ke rekomendasi model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Due nuove lingue di dettatura, completamente collegate ai consigli sui modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの新しいディクテーション言語が、モデル推奨に完全に組み込まれました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 가지 새로운 받아쓰기 언어가 모델 추천에 완전히 연결되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dua bahasa imlak baharu, disambungkan sepenuhnya kepada cadangan model."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "To nye dikteringsspråk, fullt koblet til modellanbefalinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee nieuwe dicteertalen, volledig gekoppeld aan modelaanbevelingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa nowe języki dyktowania, w pełni zintegrowane z rekomendacjami modeli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois novos idiomas de ditado, totalmente integrados às recomendações de modelos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două limbi noi de dictare, complet conectate la recomandările de modele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два новых языка диктовки, полностью подключенные к рекомендациям моделей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Två nya dikteringsspråk, helt kopplade till modellrekommendationer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาษาป้อนตามคำบอกใหม่สองภาษา เชื่อมต่อกับคำแนะนำโมเดลอย่างสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model önerilerine tamamen bağlanmış iki yeni dikte dili."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дві нові мови диктування, повністю підключені до рекомендацій моделей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai ngôn ngữ đọc chính tả mới, được kết nối đầy đủ với đề xuất mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种新的听写语言，已完整接入模型推荐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩種新的聽寫語言，已完整接入模型建議。"
          }
        }
      }
    },
    "type_a_question_about_this_note_then_send_it_aga": {
      "comment": "Type a question about this note, then send it again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب سؤالًا عن هذه الملاحظة، ثم أرسله مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
