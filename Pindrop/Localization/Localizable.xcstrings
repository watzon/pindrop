            "state": "translated",
            "value": "Unele comenzi rapide sunt în conflict între ele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые сочетания клавиш конфликтуют друг с другом."
          }
        },
        "sv": {
          "stringUnit": {
