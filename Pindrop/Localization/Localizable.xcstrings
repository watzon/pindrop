    "finish_the_active_transcription_before_starting": {
      "comment": "Finish the active transcription before starting another one.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ النسخ الجاري قبل بدء نسخ آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন একটি শুরু করার আগে চলমান প্রতিলিপিকরণ শেষ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokončete probíhající přepis, než začnete další."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut den igangværende transskribering, før du starter en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie die laufende Transkription, bevor Sie eine neue starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώστε την ενεργή απομαγνητοφώνηση πριν ξεκινήσετε άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the active transcription before starting another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la transcripción en curso antes de empezar otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päätä käynnissä oleva litterointi ennen uuden aloittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la transcription en cours avant d'en lancer une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיימו את התמלול הפעיל לפני שתתחילו אחד נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा शुरू करने से पहले चल रहा प्रतिलेखन पूरा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejezze be a futó átírást, mielőtt újat indít."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan transkripsi yang berjalan sebelum memulai yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la trascrizione in corso prima di avviarne un'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次を始める前に、実行中の文字起こしを終わらせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 전사를 시작하기 전에 진행 중인 전사를 끝내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan transkripsi yang sedang berjalan sebelum memulakan yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullfør transkriberingen som pågår før du starter en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond de lopende transcriptie af voordat je een nieuwe start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ trwającą transkrypcję, zanim zaczniesz następną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a transcrição em andamento antes de começar outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizați transcrierea în curs înainte de a începe alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите текущую транскрипцию, прежде чем начать новую."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutför den pågående transkriberingen innan du startar en ny."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำการถอดเสียงที่ทำอยู่ให้เสร็จก่อนเริ่มรายการใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir deşifre başlatmadan önce süren deşifreyi bitirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть поточну транскрипцію, перш ніж почати іншу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hoàn tất bản chép lời đang chạy trước khi bắt đầu bản khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先完成进行中的转录，再开始下一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先完成進行中的轉錄，再開始下一個。"
          }
        }
      }
    },
