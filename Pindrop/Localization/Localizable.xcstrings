    "the_live_speaker_model_could_not_be_loaded_recor": {
      "comment": "The live speaker model could not be loaded. Recording continues, and the finished note still names everyone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل نموذج المتحدثين المباشر. التسجيل مستمر، والملاحظة النهائية تسمّي الجميع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ বক্তা মডেল লোড করা যায়নি। রেকর্ডিং চলছে, আর চূড়ান্ত নোটে সবার নাম থাকবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model živých mluvčích se nepodařilo načíst. Nahrávání pokračuje a hotová poznámka stále pojmenuje všechny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-talermodellen kunne ikke indlæses. Optagelsen fortsætter, og den færdige note navngiver stadig alle."
