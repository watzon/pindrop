        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את מודל הדוברים בזמן אמת. ההקלטה ממשיכה, והפתק המוגמר עדיין נותן שם לכולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव वक्ता मॉडल लोड नहीं हो सका। रिकॉर्डिंग जारी है, और तैयार नोट में सबके नाम फिर भी रहेंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő beszélőmodellt nem sikerült betölteni. A felvétel tovább megy, és az elkészült jegyzet így is mindenkit megnevez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model pembicara langsung tidak bisa dimuat. Perekaman tetap berjalan, dan catatan akhir tetap menyebut nama semua orang."
