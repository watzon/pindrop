    "u4_home_subline_full": {
      "comment": "u4_home_subline_full",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ من الإملاء. نحو %@ موفَّرة مقارنة بالكتابة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ডিকটেশন। টাইপ করার তুলনায় প্রায় %@ সাশ্রয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diktování. Přibližně %@ ušetřeno oproti psaní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ diktering. Cirka %@ sparet i forhold til at skrive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Diktat. Etwa %@ gegenüber Tippen gespart."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ υπαγόρευσης. Περίπου %@ εξοικονόμηση σε σχέση με την πληκτρολόγηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of dictation. About %@ saved over typing it out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de dictado. Unos %@ ahorrados frente a escribirlo."
          }
