    "recording_continues_while_you_work": {
      "comment": "Recording continues while you work",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر التسجيل أثناء عملك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কাজ করার সময় রেকর্ডিং চলতে থাকে"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávka pokračuje, zatímco pracujete"
          }
        },
        "da": {
          "stringUnit": {
