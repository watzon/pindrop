    "choose_between_nemotron_punctuated_downloaded_mo": {
      "comment": "choose_between_nemotron_punctuated_downloaded_mod",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بين Nemotron (مع علامات ترقيم، نموذج يتم تنزيله) وApple SpeechTranscriber (macOS 26+، مدمج مع النظام)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemotron (যতিচিহ্নসহ, ডাউনলোড করা মডেল) এবং Apple SpeechTranscriber (macOS 26+, OS-এর সাথে আসে) এর মধ্যে বেছে নিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte mezi Nemotron (s interpunkcí, stahovaný model) a Apple SpeechTranscriber (macOS 26+, součást systému)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg mellem Nemotron (med tegnsætning, downloadet model) og Apple SpeechTranscriber (macOS 26+, følger med systemet)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zwischen Nemotron (mit Interpunktion, heruntergeladenes Modell) und Apple SpeechTranscriber (macOS 26+, im System enthalten)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε μεταξύ Nemotron (με στίξη, μοντέλο με λήψη) και Apple SpeechTranscriber (macOS 26+, ενσωματωμένο στο σύστημα)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose between Nemotron (punctuated, downloaded model) and Apple SpeechTranscriber (macOS 26+, ships with the OS)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige entre Nemotron (con puntuación, modelo descargado) y Apple SpeechTranscriber (macOS 26+, incluido con el sistema)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse Nemotron (välimerkit, ladattava malli) tai Apple SpeechTranscriber (macOS 26+, mukana järjestelmässä)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez entre Nemotron (ponctué, modèle téléchargé) et Apple SpeechTranscriber (macOS 26+, fourni avec le système)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו בין Nemotron (עם פיסוק, מודל להורדה) לבין Apple SpeechTranscriber (macOS 26+, מגיע עם המערכת)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemotron (विराम चिह्न सहित, डाउनलोड किया गया मॉडल) और Apple SpeechTranscriber (macOS 26+, OS के साथ आता है) में से चुनें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon a Nemotron (központozott, letöltött modell) és az Apple SpeechTranscriber (macOS 26+, a rendszer része) között."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
