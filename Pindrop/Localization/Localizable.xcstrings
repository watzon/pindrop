    "control_how_pindrop_appears_in_macos_and_whether": {
      "comment": "control_how_pindrop_appears_in_macos_and_whether",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكم في كيفية ظهور Pindrop في نظام التشغيل macOS وما إذا كان سيبدأ بجلسة سطح المكتب لديك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "MacOS-এ Pindrop কীভাবে উপস্থিত হয় এবং এটি আপনার ডেস্কটপ সেশন দিয়ে শুরু হয় কিনা তা নিয়ন্ত্রণ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Určete, jak se Pindrop zobrazí v macOS a zda se spustí s vaší relací na ploše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller, hvordan Pindrop vises i macOS, og om det starter med din skrivebordssession."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuern Sie, wie Pindrop in macOS angezeigt wird und ob es mit Ihrer Desktop-Sitzung startet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε πώς εμφανίζεται το Pindrop στο macOS και εάν ξεκινά με την περίοδο λειτουργίας του υπολογιστή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control how Pindrop appears in macOS and whether it starts with your desktop session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control how Pindrop appears in macOS and whether it starts with your desktop session."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallitse, kuinka Pindrop näkyy macOS:ssä ja alkaako se työpöytäistunnostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez comment Pindrop apparaît dans macOS et s'il démarre avec votre session."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלוט כיצד Pindrop יופיע ב-macOS והאם הוא מתחיל בהפעלת שולחן העבודה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नियंत्रित करें कि Pindrop macOS में कैसे दिखाई देता है और क्या यह आपके डेस्कटॉप सत्र से शुरू होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szabályozza, hogy a Pindrop hogyan jelenjen meg a macOS rendszerben, és hogy elinduljon-e az asztali munkamenettel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol bagaimana Pindrop muncul di macOS dan apakah Pindrop dimulai dengan sesi desktop Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla come appare Pindrop in macOS e se si avvia con la sessione desktop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop が macOS でどのように表示されるか、およびデスクトップ セッションで開始されるかどうかを制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS에서 Pindrop이 나타나는 방식과 데스크탑 세션에서 Pindrop이 시작되는지 여부를 제어합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kawal cara Pindrop muncul dalam macOS dan sama ada ia bermula dengan sesi desktop anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller hvordan Pindrop vises i macOS og om det starter med skrivebordsøkten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaal hoe Pindrop verschijnt in macOS en of het begint met uw desktopsessie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroluj wygląd Pindropa w systemie macOS oraz to, czy uruchamia się wraz z sesją pulpitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle como o Pindrop aparece no macOS e se ele inicia na sua sessão de desktop."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlați cum apare Pindrop în macOS și dacă începe cu sesiunea desktop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте тем, как Pindrop отображается в macOS и запускается ли он во время сеанса рабочего стола."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr hur Pindrop visas i macOS och om det börjar med din skrivbordssession."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมวิธีที่ Pindrop ปรากฏใน macOS และกำหนดว่าจะเริ่มต้นด้วยเซสชันเดสก์ท็อปของคุณหรือไม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop'un macOS'ta nasıl görüneceğini ve masaüstü oturumunuzla başlayıp başlamayacağını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контролюйте, як Pindrop відображається в macOS і чи запускається він під час сеансу робочого столу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm soát cách Pindrop xuất hiện trong macOS và liệu nó có bắt đầu bằng phiên trên máy tính để bàn của bạn hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制 Pindrop 在 macOS 中的显示方式以及是否随桌面会话启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制 Pindrop 在 macOS 中的顯示方式以及是否隨桌面會話啟動。"
          }
        }
      }
    },
