      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل اجتماعًا من الصفحة الرئيسية لعرضه هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোম থেকে মিটিং রেকর্ড করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrajte schůzku z Domova a uvidíte ji zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag et møde fra Hjem for at se det her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm ein Meeting auf der Startseite auf, um es hier zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταγράψτε σύσκεψη από την Αρχική για να τη δείτε εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a meeting from the Home page to see it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una reunión desde Inicio para verla aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna kokous etusivulta nähdäksesi sen täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une réunion depuis l’accueil pour la voir ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלט פגישה מהבית כדי לראות אותה כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम से मीटिंग रिकॉर्ड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vegyél fel egy találkozót a Kezdőlapról, hogy itt lásd."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam rapat dari Beranda untuk melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una riunione dalla Home per vederla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホームからミーティングを録音するとここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈에서 회의를 녹음하면 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakam mesyuarat dari Laman Utama untuk melihatnya di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp et møte fra Hjem for å se det her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een vergadering op vanaf Home om die hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj spotkanie na stronie głównej, by zobaczyć je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma reunião na Início para vê-la aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează o întâlnire din Acasă pentru a o vedea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите встречу на главной, чтобы увидеть её здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in ett möte från Hem för att se det här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกการประชุมจากหน้าแรกเพื่อดูที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Sayfa’dan toplantı kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть зустріч з Головної, щоб побачити її тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi cuộc họp từ Trang chủ để xem tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从主页录制会议后显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從首頁錄製會議後顯示在這裡。"
          }
        }
      }
    },
