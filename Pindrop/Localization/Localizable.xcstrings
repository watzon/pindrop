    "recording_from_external_and_bluetooth_microphone": {
      "comment": "recording_from_external_and_bluetooth_microphone",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح التسجيل من الميكروفونات الخارجية وميكروفونات Bluetooth ثابتًا الآن، حتى عندما يكون إخراج الصوت موجّهًا إلى مكان آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাহ্যিক ও Bluetooth মাইক্রোফোন থেকে রেকর্ডিং এখন অনেক বেশি নির্ভরযোগ্য, এমনকি অডিও আউটপুট অন্য কোথাও রাউট করা থাকলেও।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání z externích a Bluetooth mikrofonů je nyní spolehlivé, i když je zvukový výstup směrován jinam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelse fra eksterne og Bluetooth-mikrofoner er nu klippestabil, selv når lydoutputtet sendes et andet sted hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen über externe und Bluetooth-Mikrofone sind jetzt absolut zuverlässig, selbst wenn die Audioausgabe woandershin geleitet wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή από εξωτερικά μικρόφωνα και μικρόφωνα Bluetooth είναι πλέον απόλυτα αξιόπιστη, ακόμη κι όταν η έξοδος ήχου δρομολογείται αλλού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording from external and Bluetooth microphones is now rock solid, even when your audio output is routed elsewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación desde micrófonos externos y Bluetooth ahora es muy estable, incluso cuando la salida de audio se dirige a otro lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus ulkoisista ja Bluetooth-mikrofoneista on nyt erittäin luotettavaa, vaikka äänen ulostulo olisi ohjattu muualle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement depuis des micros externes et Bluetooth est maintenant très fiable, même lorsque la sortie audio est routée ailleurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלטה ממיקרופונים חיצוניים וממיקרופוני Bluetooth יציבה עכשיו מאוד, גם כשפלט האודיו מנותב למקום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहरी और Bluetooth माइक्रोफ़ोन से रिकॉर्डिंग अब बेहद स्थिर है, भले ही ऑडियो आउटपुट कहीं और रूट हो रहा हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A külső és Bluetooth mikrofonokról történő rögzítés most már nagyon stabil, még akkor is, ha a hangkimenet máshová van irányítva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman dari mikrofon eksternal dan Bluetooth kini sangat stabil, bahkan saat output audio diarahkan ke tempat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione da microfoni esterni e Bluetooth ora è estremamente affidabile, anche quando l’uscita audio è indirizzata altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部マイクや Bluetooth マイクからの録音が、音声出力が別の場所にルーティングされていても安定して動作するようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 외부 및 Bluetooth 마이크 녹음이 매우 안정적이며, 오디오 출력이 다른 곳으로 라우팅되어도 문제없이 동작합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman daripada mikrofon luaran dan Bluetooth kini sangat stabil, walaupun output audio dihalakan ke tempat lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptak fra eksterne og Bluetooth-mikrofoner er nå svært stabilt, selv når lydutgangen rutes et annet sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen via externe en Bluetooth-microfoons is nu rotsvast, zelfs wanneer je audio-uitvoer ergens anders naartoe wordt geleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie z mikrofonów zewnętrznych i Bluetooth jest teraz bardzo stabilne, nawet gdy wyjście audio jest skierowane gdzie indziej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação por microfones externos e Bluetooth agora é muito estável, mesmo quando a saída de áudio está roteada para outro lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrarea de pe microfoane externe și Bluetooth este acum foarte stabilă, chiar și când ieșirea audio este rutată în altă parte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись с внешних и Bluetooth-микрофонов теперь работает очень стабильно, даже если вывод звука направлен в другое место."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelning från externa och Bluetooth-mikrofoner är nu mycket stabil, även när ljudutgången dirigeras någon annanstans."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกจากไมโครโฟนภายนอกและ Bluetooth ตอนนี้เสถียรมาก แม้ว่าเอาต์พุตเสียงจะถูกส่งไปที่อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici ve Bluetooth mikrofonlardan kayıt artık, ses çıkışı başka yere yönlendirilse bile son derece kararlı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис із зовнішніх і Bluetooth-мікрофонів тепер дуже стабільний, навіть коли аудіовихід спрямовано в інше місце."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm từ mic ngoài và mic Bluetooth giờ rất ổn định, ngay cả khi đầu ra âm thanh được định tuyến sang nơi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在即使音频输出被路由到其他位置，外接和 Bluetooth 麦克风录音也能稳定工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在即使音訊輸出被路由到其他位置，外接與 Bluetooth 麥克風錄音也能穩定運作。"
          }
        }
      }
    },
    "recording_in_progress_transcription_will_start": {
      "comment": "recording_in_progress_transcription_will_start",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل قيد التقدم — سيبدأ النسخ عند انتهائه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং চলছে — এটি শেষ হলে ট্রান্সক্রিপশন শুরু হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Probíhá nahrávání — přepis se spustí po jeho dokončení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optagelse i gang — transskriptionen starter, når den er færdig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme läuft — die Transkription beginnt, sobald sie abgeschlossen ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή σε εξέλιξη — η μεταγραφή θα ξεκινήσει μόλις ολοκληρωθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording in progress — transcription will start when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabación en curso — la transcripción comenzará cuando termine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennus käynnissä — transkriptio alkaa, kun se on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement en cours — la transcription démarrera une fois terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההקלטה מתבצעת — התמלול יתחיל כשהיא תסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग प्रगति पर है — समाप्त होने पर प्रतिलेखन शुरू होगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felvétel folyamatban — az átírás a befejezése után kezdődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman sedang berlangsung — transkripsi akan dimulai setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione in corso — la trascrizione inizierà al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中です — 終了すると文字起こしが開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 진행 중입니다 — 완료되면 전사가 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakaman sedang dijalankan — transkripsi akan bermula apabila selesai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opptak pågår — transkripsjon starter når det er ferdig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opname bezig — transcriptie begint zodra deze is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie w toku — transkrypcja rozpocznie się po jego zakończeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravação em andamento — a transcrição começará quando ela terminar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrare în curs — transcrierea va începe când se termină."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт запись — транскрипция начнётся после её завершения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelning pågår — transkriptionen börjar när den är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำลังบันทึกอยู่ — การถอดเสียงจะเริ่มเมื่อบันทึกเสร็จสิ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt devam ediyor — bittiğinde transkripsiyon başlayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває запис — транскрипція розпочнеться після завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang ghi âm — quá trình phiên âm sẽ bắt đầu khi ghi âm kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在录音 — 转录将在录音结束后开始。"
          }
