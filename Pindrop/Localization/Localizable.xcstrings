        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Więc spotkanie jest o 15:30. Możesz potwierdzić?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Então a reunião é às 15:30. Você pode confirmar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deci întâlnirea e la 15:30. Poți confirma?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так, встреча в 15:30. Можешь подтвердить?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så mötet är kl. 15:30. Kan du bekräfta?"
