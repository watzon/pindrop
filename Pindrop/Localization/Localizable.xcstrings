        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entonces la reunión es a las 15:30. ¿Puedes confirmar?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eli kokous on klo 15.30. Voitko vahvistaa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donc la réunion est à 15 h 30. Peux-tu confirmer ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אז הפגישה ב-15:30. אפשר לאשר?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तो मीटिंग 15:30 बजे है। क्या आप पुष्टि कर सकते हैं?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szóval a megbeszélés 15:30-kor van. Meg tudod erősíteni?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadi rapat jam 15:30. Bisakah kamu konfirmasi?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quindi la riunione è alle 15:30. Puoi confermare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議は 15:30 です。確認できますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래서 회의는 15:30이야. 확인해 줄 수 있어?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadi mesyuarat pada 15:30. Bolehkah anda sahkan?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så møtet er kl. 15:30. Kan du bekrefte?"
