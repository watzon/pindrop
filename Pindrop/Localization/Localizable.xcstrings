    "pillars_dictate_description": {
      "comment": "Speak, then Pindrop writes in the app you are using.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدث، ثم يُدخل Pindrop النص في التطبيق الذي تستخدمه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বলুন, তারপর Pindrop আপনার ব্যবহৃত অ্যাপে লিখে দেবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluvte a Pindrop pak text zapíše do aplikace, kterou používáte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal, så skriver Pindrop i den app, du bruger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprechen Sie, dann schreibt Pindrop in die von Ihnen verwendete App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μιλήστε και το Pindrop θα γράψει στην εφαρμογή που χρησιμοποιείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak, then Pindrop writes in the app you are using."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla y Pindrop escribirá en la app que estés usando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu, niin Pindrop kirjoittaa käyttämääsi sovellukseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez, puis Pindrop écrit dans l’application que vous utilisez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר, ואז Pindrop יכתוב באפליקציה שבה אתה משתמש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बोलें, फिर Pindrop आपके द्वारा उपयोग किए जा रहे ऐप में लिख देगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszélj, majd a Pindrop beírja a szöveget a használt alkalmazásba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bicara, lalu Pindrop mengetik di aplikasi yang sedang Anda gunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla, poi Pindrop scrive nell’app che stai usando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すと、Pindrop が使用中のアプリに文字を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하면 Pindrop이 사용 중인 앱에 글을 입력합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bercakap, kemudian Pindrop menaip dalam apl yang sedang anda gunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk, så skriver Pindrop i appen du bruker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreek, en Pindrop schrijft vervolgens in de app die je gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów, a Pindrop wpisze tekst w używanej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale, e o Pindrop escreverá no aplicativo que você estiver usando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorbește, apoi Pindrop scrie în aplicația pe care o folosești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите, а Pindrop будет печатать в приложении, которым вы пользуетесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata, så skriver Pindrop i appen du använder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูด แล้ว Pindrop จะเขียนลงในแอปที่คุณกำลังใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşun, Pindrop kullandığınız uygulamaya yazsın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говоріть, а Pindrop записуватиме текст у програмі, якою ви користуєтеся."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nói, Pindrop sẽ viết vào ứng dụng bạn đang sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话，然后 Pindrop 会在您正在使用的应用中输入文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說話，Pindrop 就會在您正在使用的 App 中輸入文字。"
          }
        }
      }
    },
    "pillars_finish_current_capture": {
      "comment": "Finish the current capture before starting another.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل الالتقاط الحالي قبل بدء التقاط آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ক্যাপচার শুরু করার আগে বর্তমান ক্যাপচার শেষ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před zahájením dalšího záznamu dokončete aktuální záznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut den aktuelle optagelse, før du starter en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie die aktuelle Aufnahme, bevor Sie eine weitere starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ολοκληρώστε την τρέχουσα καταγραφή πριν ξεκινήσετε άλλη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the current capture before starting another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la captura actual antes de iniciar otra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeistele nykyinen tallennus ennen uuden aloittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la capture en cours avant d’en commencer une autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיים את הלכידה הנוכחית לפני שתתחיל לכידה אחרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा कैप्चर शुरू करने से पहले मौजूदा कैप्चर पूरा करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fejezd be az aktuális rögzítést, mielőtt újat indítanál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan pengambilan saat ini sebelum memulai yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa l’acquisizione corrente prima di iniziarne un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のキャプチャを完了してから、別のキャプチャを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 캡처를 완료한 후 다른 캡처를 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan tangkapan semasa sebelum memulakan yang lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fullfør det nåværende opptaket før du starter et nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond de huidige vastlegging af voordat je een nieuwe start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ bieżące przechwytywanie przed rozpoczęciem kolejnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a captura atual antes de iniciar outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizează captura curentă înainte de a începe alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите текущую запись, прежде чем начинать новую."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutför den aktuella inspelningen innan du startar en ny."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกปัจจุบันให้เสร็จก่อนเริ่มรายการใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir kayıt başlatmadan önce mevcut kaydı tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть поточний запис, перш ніж починати новий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hoàn tất bản ghi hiện tại trước khi bắt đầu bản ghi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成当前录制，再开始新的录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先完成目前的錄製，再開始新的錄製。"
          }
        }
      }
    },
    "pillars_hold_anywhere": {
      "comment": "pillars_hold_anywhere",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على %@ في أي مكان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো জায়গায় %@ ধরে রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte %@ kdekoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ nede hvor som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie %@ an beliebiger Stelle gedrückt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε πατημένο το %@ οπουδήποτε."
          }
        },
        "en": {
          "stringUnit": {
