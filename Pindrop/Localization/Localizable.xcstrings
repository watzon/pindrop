    "transcribing_failed_the_recording_is_saved_try_a": {
      "comment": "Transcribing failed. The recording is saved. Try again, or open the audio from the note.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل النسخ. التسجيل محفوظ. حاول مرة أخرى، أو افتح الصوت من الملاحظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিলিপি করা যায়নি। রেকর্ডিং সংরক্ষিত আছে। আবার চেষ্টা করুন, বা নোট থেকে অডিও খুলুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepis se nezdařil. Nahrávka je uložená. Zkuste to znovu, nebo otevřete zvuk z poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transskriptionen mislykkedes. Optagelsen er gemt. Prøv igen, eller åbn lyden fra noten."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription ist fehlgeschlagen. Die Aufnahme ist gespeichert. Versuchen Sie es erneut, oder öffnen Sie das Audio aus der Notiz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απομαγνητοφώνηση απέτυχε. Η εγγραφή έχει αποθηκευτεί. Δοκιμάστε ξανά ή ανοίξτε τον ήχο από τη σημείωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcribing failed. The recording is saved. Try again, or open the audio from the note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción falló. La grabación está guardada. Vuelve a intentarlo o abre el audio desde la nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Litterointi epäonnistui. Tallenne on tallessa. Yritä uudelleen tai avaa ääni muistiinpanosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription a échoué. L'enregistrement est conservé. Réessayez ou ouvrez l'audio depuis la note."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמלול נכשל. ההקלטה נשמרה. נסו שוב, או פתחו את האודיו מתוך הפתק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिलेखन विफल रहा। रिकॉर्डिंग सहेजी गई है। दोबारा कोशिश करें, या नोट से ऑडियो खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átírás nem sikerült. A felvétel mentve van. Próbálja újra, vagy nyissa meg a hangot a jegyzetből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi gagal. Rekaman tersimpan. Coba lagi, atau buka audio dari catatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione non riuscita. La registrazione è salvata. Riprova oppure apri l’audio dalla nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしに失敗しました。録音は保存されています。もう一度お試しになるか、メモから音声を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사에 실패했습니다. 녹음은 저장되어 있습니다. 다시 시도하거나 메모에서 오디오를 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi gagal. Rakaman disimpan. Cuba lagi, atau buka audio daripada nota."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsjonen mislyktes. Opptaket er lagret. Prøv igjen, eller åpne lyden fra notatet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberen is mislukt. De opname is bewaard. Probeer het opnieuw of open de audio vanuit de notitie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisywanie nie powiodło się. Nagranie jest zapisane. Spróbuj ponownie albo otwórz dźwięk z notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição falhou. A gravação está salva. Tente de novo ou abra o áudio pela nota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrierea a eșuat. Înregistrarea este salvată. Încercați din nou sau deschideți sunetul din notiță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка не удалась. Запись сохранена. Попробуйте снова или откройте аудио из заметки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptionen misslyckades. Inspelningen är sparad. Försök igen, eller öppna ljudet från anteckningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงล้มเหลว การบันทึกถูกเก็บไว้แล้ว ลองอีกครั้ง หรือเปิดเสียงจากโน้ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deşifre başarısız oldu. Kayıt saklandı. Tekrar deneyin veya sesi nottan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розшифрувати. Запис збережено. Спробуйте ще раз або відкрийте аудіо з нотатки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chép lời không thành công. Bản ghi đã được lưu. Thử lại, hoặc mở âm thanh từ ghi chú."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转录失败。录音已保存。请重试，或从笔记中打开音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉錄失敗。錄音已儲存。請重試，或從筆記中開啟音訊。"
          }
        }
      }
    },
