    "no_contributions_yet_pairs_are_stored_when_ai_en": {
      "comment": "no_contributions_yet_pairs_are_stored_when_ai_en",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مساهمات بعد. تُخزَّن الأزواج عندما يغيّر التحسين بالذكاء الاصطناعي أو التعديلات اليدوية نسخًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো অবদান নেই। AI উন্নতি বা ম্যানুয়াল সম্পাদনা কোনো প্রতিলিপি পরিবর্তন করলে জোড়া সংরক্ষিত হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné příspěvky. Páry se ukládají, když vylepšení pomocí AI nebo ruční úpravy změní přepis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bidrag endnu. Par gemmes, når AI-forbedring eller manuelle redigeringer ændrer en transskription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Beiträge. Paare werden gespeichert, wenn KI-Verbesserung oder manuelle Bearbeitungen ein Transkript ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν συνεισφορές ακόμη. Τα ζεύγη αποθηκεύονται όταν η βελτίωση με AI ή οι μη αυτόματες επεξεργασίες αλλάζουν μια μεταγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contributions yet. Pairs are stored when AI enhancement or manual edits change a transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay contribuciones. Los pares se guardan cuando la mejora con IA o las ediciones manuales cambian una transcripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä osallistumisia. Parit tallennetaan, kun tekoälyparannus tai manuaaliset muokkaukset muuttavat transkriptiota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune contribution pour l’instant. Les paires sont stockées lorsque l’amélioration par IA ou des modifications manuelles changent une transcription."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תרומות עדיין. זוגות נשמרים כאשר שיפור באמצעות בינה מלאכותית או עריכות ידניות משנים תמלול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई योगदान नहीं। जब AI संवर्द्धन या मैन्युअल संपादन किसी ट्रांसक्रिप्ट को बदलते हैं, तो जोड़े संग्रहीत होते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincsenek hozzájárulások. A párok akkor tárolódnak, amikor az AI-fejlesztés vagy kézi szerkesztések megváltoztatnak egy átiratot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada kontribusi. Pasangan disimpan saat penyempurnaan AI atau suntingan manual mengubah transkripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun contributo. Le coppie vengono salvate quando il miglioramento con IA o le modifiche manuali cambiano una trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ提供データはありません。AI 強化または手動編集で文字起こしが変更されると、ペアが保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기여가 없습니다. AI 향상 또는 수동 편집이 전사를 변경하면 쌍이 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada sumbangan. Pasangan disimpan apabila penambahbaikan AI atau suntingan manual mengubah transkripsi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen bidrag ennå. Par lagres når AI-forbedring eller manuelle redigeringer endrer en transkripsjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen bijdragen. Paren worden opgeslagen wanneer AI-verbetering of handmatige bewerkingen een transcriptie wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wkładów. Pary są zapisywane, gdy ulepszanie przez AI lub ręczne zmiany zmodyfikują transkrypcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há contribuições. Os pares são armazenados quando o aprimoramento por IA ou edições manuais alteram uma transcrição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio contribuție încă. Perechile sunt stocate când îmbunătățirea prin AI sau modificările manuale schimbă o transcriere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет материалов. Пары сохраняются, когда улучшение с помощью ИИ или ручные правки изменяют транскрипцию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga bidrag ännu. Par lagras när AI-förbättring eller manuella redigeringar ändrar en transkription."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการมีส่วนร่วม คู่ข้อความจะถูกจัดเก็บเมื่อการปรับปรุงด้วย AI หรือการแก้ไขด้วยตนเองเปลี่ยนแปลงการถอดเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz katkı yok. AI geliştirmesi veya el ile düzenlemeler bir transkripsiyonu değiştirdiğinde çiftler depolanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає внесків. Пари зберігаються, коли покращення за допомогою AI або ручні редагування змінюють транскрипцію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có đóng góp nào. Các cặp được lưu khi cải thiện bằng AI hoặc chỉnh sửa thủ công thay đổi một bản phiên âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无贡献。当 AI 增强或手动编辑更改转录时，将存储文本对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無貢獻。當 AI 增強或手動編輯更改轉錄時，將儲存文字配對。"
          }
        }
      }
    },
