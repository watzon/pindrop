    "display_pindrop_in_the_dock_instead_of_running_o": {
      "comment": "display_pindrop_in_the_dock_instead_of_running_o",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بعرض Pindrop في Dock بدلاً من تشغيله كتطبيق شريط قوائم فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধুমাত্র একটি মেনু বার অ্যাপ হিসাবে চালানোর পরিবর্তে ডকে পিনড্রপ প্রদর্শন করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazte Pindrop v doku místo toho, aby běžel pouze jako aplikace na liště nabídek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis Pindrop i Dock i stedet for kun at køre som en menulinjeapp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie Pindrop im Dock an, anstatt es nur als Menüleisten-App auszuführen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίστε το Pindrop στο Dock αντί να εκτελείται μόνο ως εφαρμογή γραμμής μενού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display Pindrop in the Dock instead of running only as a menu bar app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra Pindrop en el Dock en lugar de ejecutarlo solo como app de barra de menús."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä Pindrop Dockissa sen sijaan, että se toimisi vain valikkorivisovelluksena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez Pindrop dans le Dock au lieu de l'exécuter uniquement comme une app de barre de menus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג Pindrop ב-Dock במקום לפעול רק כאפליקציה של שורת תפריטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिनड्रॉप को केवल मेनू बार ऐप के रूप में चलाने के बजाय डॉक में प्रदर्शित करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pindrop megjelenítése a Dockban, ahelyett, hogy csak menüsor-alkalmazásként futna."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan Pindrop di Dock alih-alih menggunakannn hanya sebagai aplikasi bilah menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza Pindrop nel Dock invece di essere eseguito solo come app della barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニュー バー アプリとしてのみ実行するのではなく、Dock に Pindrop を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 앱으로만 실행하는 대신 Dock에 Pindrop을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Paparkan Pindrop dalam Dok dan bukannya berjalan hanya sebagai apl bar menu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis Pindrop i Dock i stedet for å kjøre bare som en menylinjeapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef Pindrop weer in het Dock in plaats van alleen als menubalk-app te draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlaj Pindrop w Docku, zamiast uruchamiać go wyłącznie jako aplikację na pasku menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exiba o Pindrop no Dock em vez de executá-lo apenas como um aplicativo da barra de menus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișați Pindrop în Dock în loc să rulați doar ca aplicație pentru bara de meniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображайте Pindrop в Dock вместо того, чтобы запускать его только как приложение в строке меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa Pindrop i Dock istället för att endast köras som en menyradsapp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดง Pindrop ใน Dock แทนที่จะทำงานเป็นแอปแถบเมนูเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop'u yalnızca bir menü çubuğu uygulaması olarak çalıştırmak yerine Dock'ta görüntüleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображати Pindrop у Dock замість running лише як програму на панелі меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị Pindrop trong Dock thay vì chỉ chạy dưới dạng ứng dụng trên thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dock 中显示 Pindrop，而不是仅作为菜单栏应用运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Dock 中顯示 Pindrop，而不是僅作為選單欄應用執行。"
          }
        }
      }
    },
    "do_you_want_a_notification_when_a_call_starts": {
      "comment": "Do you want a notification when a call starts?",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إشعارًا عند بدء مكالمة؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কল শুরু হলে আপনি কি বিজ্ঞপ্তি চান?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete oznámení, když začne hovor?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du have en notifikation, når et opkald starter?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie eine Mitteilung, wenn ein Anruf beginnt?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θέλετε ειδοποίηση όταν ξεκινά μια κλήση;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want a notification when a call starts?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres una notificación cuando empiece una llamada?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Haluatko ilmoituksen, kun puhelu alkaa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous une notification quand un appel commence ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רוצים התראה כששיחה מתחילה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप कॉल शुरू होने पर सूचना चाहते हैं?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szeretne értesítést, amikor elindul egy hívás?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin notifikasi saat panggilan dimulai?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi una notifica quando inizia una chiamata?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話が始まったときに通知しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화가 시작될 때 알림을 받으시겠습니까?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahu pemberitahuan apabila panggilan bermula?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du ha et varsel når en samtale starter?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wil je een melding als een gesprek start?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy chcesz powiadomienie, gdy rozpocznie się rozmowa?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quer uma notificação quando uma chamada começar?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doriți o notificare când începe un apel?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите получать уведомление, когда начинается звонок?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du ha en notis när ett samtal startar?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการการแจ้งเตือนเมื่อการโทรเริ่มขึ้นไหม?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çağrı başladığında bildirim ister misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хочете отримувати сповіщення, коли починається дзвінок?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có muốn nhận thông báo khi cuộc gọi bắt đầu không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话开始时要收到通知吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通話開始時要收到通知嗎？"
          }
        }
      }
    },
    "dock_the_sidebar_to_the_left_or_right_edge_of_th": {
      "comment": "dock_the_sidebar_to_the_left_or_right_edge_of_th",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإرساء الشريط الجانبي على الحافة اليسرى أو اليمنى من النافذة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উইন্ডোর বাম বা ডান প্রান্তে সাইডবার ডক করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukotvete postranní panel k levému nebo pravému okraji okna."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dok sidebjælken til venstre eller højre kant af vinduet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docken Sie die Seitenleiste an den linken oder rechten Rand des Fensters."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στερεώστε την πλαϊνή γραμμή στην αριστερή ή τη δεξιά άκρη του παραθύρου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock the sidebar to the left or right edge of the window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancla la barra lateral al borde izquierdo o derecho de la ventana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä sivupalkki ikkunan vasempaan tai oikeaan reunaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancrez la barre latérale sur le bord gauche ou droit de la fenêtre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עגן את סרגל הצד לקצה השמאלי או הימני של החלון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइडबार को विंडो के बाएँ या दाएँ किनारे पर डॉक करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítse az oldalsávot az ablak bal vagy jobb széléhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempatkan sidebar di tepi kiri atau kanan jendela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora la barra laterale al bordo sinistro o destro della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーをウィンドウの左端または右端にドッキングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바를 창의 왼쪽 또는 오른쪽 가장자리에 고정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
