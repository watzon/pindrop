    "pillars_voice_note_shortcut_hint": {
      "comment": "pillars_voice_note_shortcut_hint",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مع الاستمرار على %1$@ أو اضغط على %2$@ في أي مكان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো জায়গায় %1$@ ধরে রাখুন বা %2$@ চাপুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržte %1$@ nebo stiskněte %2$@ kdekoli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %1$@ nede, eller tryk på %2$@ hvor som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie %1$@ gedrückt oder drücken Sie %2$@ an beliebiger Stelle."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κρατήστε πατημένο το %1$@ ή πατήστε %2$@ οπουδήποτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %1$@ or press %2$@ anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado %1$@ o pulsa %2$@ en cualquier lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä %1$@ painettuna tai paina %2$@ missä tahansa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez %1$@ ou appuyez sur %2$@ où que vous soyez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזק את %1$@ או הקש על %2$@ מכל מקום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहीं भी %1$@ दबाकर रखें या %2$@ दबाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsa lenyomva: %1$@, vagy nyomja meg: %2$@ bárhol."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan %1$@ atau tekan %2$@ di mana saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto %1$@ o premi %2$@ ovunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこでも %1$@ を長押しするか %2$@ を押します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서든 %1$@을(를) 길게 누르거나 %2$@을(를) 누르세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan %1$@ atau tekan %2$@ di mana-mana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %1$@ eller trykk %2$@ hvor som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd %1$@ ingedrukt of druk op %2$@, waar je ook bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj %1$@ lub naciśnij %2$@ w dowolnym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure %1$@ ou pressione %2$@ em qualquer lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține apăsat %1$@ sau apasă %2$@ oriunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %1$@ или нажмите %2$@ в любом месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll %1$@ eller tryck på %2$@ var som helst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด %1$@ ค้างไว้หรือกด %2$@ จากที่ใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir yerde %1$@ tuşunu basılı tutun veya %2$@ tuşuna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте %1$@ або натисніть %2$@ будь-де."
          }
        },
        "vi": {
          "stringUnit": {
