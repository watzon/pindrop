    "this_note_could_not_be_opened_close_it_and_open": {
      "comment": "This note could not be opened. Close it and open it again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذه الملاحظة. أغلقها ثم افتحها مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নোটটি খোলা যায়নি। এটি বন্ধ করে আবার খুলুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto poznámku se nepodařilo otevřít. Zavřete ji a otevřete znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne note kunne ikke åbnes. Luk den, og åbn den igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz konnte nicht geöffnet werden. Schließen Sie sie, und öffnen Sie sie erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η σημείωση δεν άνοιξε. Κλείστε την και ανοίξτε την ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note could not be opened. Close it and open it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir esta nota. Ciérrala y ábrela de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä muistiinpanoa ei voitu avata. Sulje se ja avaa uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note n'a pas pu être ouverte. Fermez-la, puis rouvrez-la."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפתוח את הפתק הזה. סגרו אותו ופתחו אותו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नोट नहीं खुल सका। इसे बंद करें और फिर से खोलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a jegyzetet nem sikerült megnyitni. Zárja be, majd nyissa meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan ini tidak bisa dibuka. Tutup, lalu buka lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire questa nota. Chiudila e riaprila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモを開けませんでした。閉じてもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모를 열지 못했습니다. 닫았다가 다시 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota ini tidak dapat dibuka. Tutup dan buka semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette notatet kunne ikke åpnes. Lukk det, og åpne det på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze notitie kon niet worden geopend. Sluit haar en open haar opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć tej notatki. Zamknij ją i otwórz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir esta nota. Feche e abra de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această notiță nu a putut fi deschisă. Închideți-o și deschideți-o din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть эту заметку. Закройте её и откройте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här anteckningen kunde inte öppnas. Stäng den och öppna den igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดโน้ตนี้ไม่ได้ ปิดแล้วเปิดใหม่อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu not açılamadı. Kapatıp tekrar açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити цю нотатку. Закрийте її та відкрийте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở ghi chú này. Hãy đóng rồi mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开这条笔记。请关闭后重新打开。"
          }
        },
