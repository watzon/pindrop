    "there_is_nothing_to_ask_about_yet_record_or_writ": {
      "comment": "There is nothing to ask about yet. Record or write something first.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء لسؤاله بعد. سجّل أو اكتب شيئًا أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও জিজ্ঞাসা করার মতো কিছু নেই। প্রথমে কিছু রেকর্ড করুন বা লিখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím se není na co ptát. Nejdřív něco nahrajte nebo napište."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er endnu ikke noget at spørge om. Optag eller skriv noget først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch nichts zu fragen. Nehmen Sie zuerst etwas auf, oder schreiben Sie etwas."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη τίποτα να ρωτήσετε. Ηχογραφήστε ή γράψτε κάτι πρώτα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is nothing to ask about yet. Record or write something first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que preguntar. Graba o escribe algo primero."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ole vielä mitään kysyttävää. Tallenna tai kirjoita ensin jotain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a encore rien à demander. Enregistrez ou écrivez d'abord quelque chose."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין מה לשאול. הקליטו או כתבו משהו קודם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पूछने के लिए कुछ नहीं है। पहले कुछ रिकॉर्ड करें या लिखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs mit kérdezni. Előbb vegyen fel vagy írjon valamit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang bisa ditanyakan. Rekam atau tulis sesuatu dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora nulla da chiedere. Registra o scrivi prima qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ質問できる内容がありません。先に録音するか何か書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 질문할 내용이 없습니다. 먼저 녹음하거나 무언가를 작성하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa-apa untuk ditanya. Rakam atau tulis sesuatu dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er ennå ikke noe å spørre om. Ta opp eller skriv noe først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog niets om te vragen. Neem eerst iets op of schrijf iets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie nie ma o co pytać. Najpierw coś nagraj lub napisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada para perguntar. Grave ou escreva algo primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu este nimic de întrebat. Înregistrați sau scrieți ceva mai întâi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нечего спрашивать. Сначала запишите или напишите что-нибудь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget att fråga om ännu. Spela in eller skriv något först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีอะไรให้ถาม บันทึกหรือเขียนอะไรบางอย่างก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz sorulacak bir şey yok. Önce bir şey kaydedin veya yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що немає про що запитувати. Спершу щось запишіть або напишіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì để hỏi. Hãy ghi âm hoặc viết gì đó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有可提问的内容。请先录音或写点内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還沒有可提問的內容。請先錄音或寫點內容。"
          }
        }
      }
    },
