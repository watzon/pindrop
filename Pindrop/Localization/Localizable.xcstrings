          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie wszystkich zapisanych par tekstu z tego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
