        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nemotron (noktalama destekli, indirilen model) ile Apple SpeechTranscriber (macOS 26+, sistemle birlikte gelir) arasında seçim yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть між Nemotron (з пунктуацією, завантажувана модель) та Apple SpeechTranscriber (macOS 26+, постачається із системою)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn giữa Nemotron (có dấu câu, mô hình tải về) và Apple SpeechTranscriber (macOS 26+, đi kèm hệ điều hành)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Nemotron（带标点、需下载的模型）和 Apple SpeechTranscriber（macOS 26+，随系统提供）之间选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Nemotron（含標點、需下載的模型）與 Apple SpeechTranscriber（macOS 26+，隨系統提供）之間選擇。"
