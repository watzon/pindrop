    "press_escape_twice_to_cancel_a_recording_when_off_a_si": {
      "comment": "Press Escape twice to cancel a recording. When off, a single press cancels.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط Escape مرتين لإلغاء التسجيل. عند الإيقاف، تكفي ضغطة واحدة للإلغاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং বাতিল করতে Escape দুবার চাপুন। বন্ধ থাকলে, একবার চাপলেই বাতিল হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stisknutím klávesy Escape dvakrát zrušíte nahrávání. Pokud je vypnuto, stačí jedno stisknutí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Escape to gange for at annullere en optagelse. Når slået fra, annullerer et enkelt tryk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape zweimal drücken, um eine Aufnahme abzubrechen. Wenn deaktiviert, genügt ein einzelner Druck."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε Escape δύο φορές για να ακυρώσετε μια εγγραφή. Όταν είναι ανενεργό, αρκεί ένα πάτημα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Escape twice to cancel a recording. When off, a single press cancels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Escape dos veces para cancelar una grabación. Si está desactivado, una sola pulsación cancela."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruuta tallennus painamalla Escape kahdesti. Kun pois käytöstä, yksi painallus peruuttaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez deux fois sur Échap pour annuler un enregistrement. Si désactivé, un seul appui annule."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ פעמיים על Escape כדי לבטל הקלטה. כשהאפשרות כבויה, לחיצה אחת מבטלת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग रद्द करने के लिए Escape दो बार दबाएँ। बंद होने पर, एक बार दबाने से रद्द हो जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyomja meg kétszer az Escape billentyűt a felvétel megszakításához. Kikapcsolva egyetlen lenyomás is megszakítja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Escape dua kali untuk membatalkan perekaman. Jika nonaktif, satu kali tekan langsung membatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Esc due volte per annullare una registrazione. Se disattivato, basta una sola pressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Escapeを2回押すと録音をキャンセルします。オフの場合は1回押すだけでキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape 키를 두 번 눌러 녹음을 취소합니다. 끄면 한 번만 눌러도 취소됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Escape dua kali untuk membatalkan rakaman. Jika dimatikan, satu tekanan akan membatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Escape to ganger for å avbryte et opptak. Når av, avbryter ett enkelt trykk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk twee keer op Escape om een opname te annuleren. Indien uitgeschakeld, annuleert één druk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Escape dwa razy, aby anulować nagrywanie. Gdy wyłączone, wystarczy jedno naciśnięcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Escape duas vezes para cancelar uma gravação. Quando desativado, um único toque cancela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați Escape de două ori pentru a anula o înregistrare. Când este dezactivat, o singură apăsare anulează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Escape дважды, чтобы отменить запись. Если выключено, отмена происходит по одному нажатию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Escape två gånger för att avbryta en inspelning. När av avbryter ett enda tryck."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กด Escape สองครั้งเพื่อยกเลิกการบันทึก หากปิดไว้ กดครั้งเดียวก็ยกเลิกได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydı iptal etmek için Escape'e iki kez basın. Kapalıyken tek basış iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть Escape двічі, щоб скасувати запис. Якщо вимкнено, скасування відбувається одним натисканням."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Escape hai lần để hủy bản ghi âm. Khi tắt, chỉ cần nhấn một lần để hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按两次 Escape 取消录音。关闭后，按一次即可取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按兩次 Escape 取消錄音。關閉後，按一次即可取消。"
          }
        }
      }
    },
