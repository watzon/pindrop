          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer en fil eller lim inn en lenke for å transkribere media."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer een bestand of plak een link om media te transcriberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj plik lub wklej link, by transkrybować media."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe um arquivo ou cole um link para transcrever mídia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Importă un fișier sau lipește un link pentru a transcrie media."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте файл или вставьте ссылку для транскрипции."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera en fil eller klistra in en länk för att transkribera media."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าไฟล์หรือวางลิงก์เพื่อถอดเสียงสื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya içe aktarın veya bağlantı yapıştırarak medya yazıya dökün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуйте файл або вставте посилання для транскрипції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
