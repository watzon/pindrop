          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "alice sender decket innen fredag bob tar prissjekken vi trenger en beslutning neste uke"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "alice stuurt het deck vrijdag bob doet de prijsreview we hebben volgende week een beslissing nodig"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "alice wyśle prezentację do piątku bob zajmuje się przeglądem cen potrzebujemy decyzji w przyszłym tygodniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "alice vai enviar o deck até sexta bob cuida da revisão de preços precisamos de uma decisão na próxima semana"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "alice va trimite deck-ul până vineri bob se ocupă de revizuirea prețurilor avem nevoie de o decizie săptămâna viitoare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "элис пришлёт колоду до пятницы боб займётся проверкой цен нам нужно решение на следующей неделе"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "alice skickar decket till fredag bob tar prisgranskningen vi behöver ett beslut nästa vecka"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อลิซจะส่งเด็คภายในวันศุกร์ บ็อบดูแลการตรวจราคา เราต้องการการตัดสินใจสัปดาห์หน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "alice cuma'ya kadar decki gönderecek bob fiyat incelemesini üstleniyor gelecek hafta bir karar lazım"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "еліс надішле колоду до п’ятниці боб займеться перевіркою цін нам потрібне рішення наступного тижня"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "alice sẽ gửi deck trước thứ sáu bob phụ trách xem xét giá chúng ta cần quyết định tuần sau"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "爱丽丝周五前会发材料 鲍勃负责价格审核 下周需要做决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
