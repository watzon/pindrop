        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "vi dækkede onboarding-latens så priser og til sidst lanceringsdatoen den tolvte maj"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wir haben onboarding-latenz besprochen dann preise und schließlich den launch am zwölften mai"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "καλύψαμε την καθυστέρηση onboarding μετά τις τιμές και τέλος την ημερομηνία κυκλοφορίας δώδεκα μαΐου"
