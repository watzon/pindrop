    "answers_come_from_this_note_s_transcript_and_you": {
      "comment": "Answers come from this note's transcript and your AI provider. Check anything important.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي الإجابات من نص هذه الملاحظة ومزوّد الذكاء الاصطناعي لديك. تحقق من أي شيء مهم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তরগুলো এই নোটের প্রতিলিপি এবং আপনার AI প্রদানকারীর কাছ থেকে আসে। গুরুত্বপূর্ণ যেকোনো কিছু যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi vycházejí z přepisu této poznámky a vašeho poskytovatele AI. Cokoli důležitého si ověřte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene kommer fra denne notes udskrift og din AI-udbyder. Tjek alt, der er vigtigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten stammen aus dem Transkript dieser Notiz und Ihrem KI-Anbieter. Überprüfen Sie alles Wichtige."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι απαντήσεις προέρχονται από το απομαγνητοφωνημένο κείμενο αυτής της σημείωσης και τον πάροχο AI σας. Ελέγξτε ό,τι είναι σημαντικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers come from this note's transcript and your AI provider. Check anything important."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas provienen de la transcripción de esta nota y de tu proveedor de IA. Comprueba cualquier dato importante."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaukset perustuvat tämän muistiinpanon tekstitykseen ja tekoälypalveluntarjoajaasi. Tarkista kaikki tärkeä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses proviennent de la transcription de cette note et de votre fournisseur d'IA. Vérifiez tout élément important."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובות מגיעות מהתמלול של הפתק הזה ומספק ה-AI שלכם. בדקו כל דבר חשוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब इस नोट के प्रतिलेख और आपके AI प्रदाता से आते हैं। जो भी महत्वपूर्ण हो, उसे जांच लें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszok ennek a jegyzetnek az átiratából és az AI-szolgáltatójából származnak. Ellenőrizzen mindent, ami fontos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban berasal dari transkrip catatan ini dan penyedia AI Anda. Periksa hal yang penting."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte provengono dalla trascrizione di questa nota e dal tuo provider IA. Controlla tutto ciò che è importante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答はこのメモの文字起こしとAIプロバイダーから得られます。重要な内容は確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변은 이 메모의 대본과 AI 제공업체에서 가져옵니다. 중요한 내용은 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan datang daripada transkrip nota ini dan pembekal AI anda. Semak semua perkara penting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene kommer fra utskriften av dette notatet og AI-leverandøren din. Sjekk alt som er viktig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden komen uit het transcript van deze notitie en je AI-provider. Controleer alles wat belangrijk is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi pochodzą z transkrypcji tej notatki i Twojego dostawcy AI. Sprawdź wszystko, co ważne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas vêm da transcrição desta nota e do seu provedor de IA. Confira tudo que for importante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsurile provin din transcrierea acestei notițe și de la furnizorul dvs. de AI. Verificați orice este important."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы формируются на основе транскрипта этой заметки и вашего провайдера ИИ. Проверяйте всё важное."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaren kommer från den här anteckningens transkript och din AI-leverantör. Kontrollera allt som är viktigt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบมาจากข้อความถอดเสียงของโน้ตนี้และผู้ให้บริการ AI ของคุณ ตรวจสอบสิ่งสำคัญทุกอย่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlar bu notun dökümünden ve AI sağlayıcınızdan gelir. Önemli olan her şeyi kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповіді формуються на основі транскрипту цієї нотатки та вашого постачальника ШІ. Перевіряйте все важливе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời đến từ bản chép lời của ghi chú này và nhà cung cấp AI của bạn. Hãy kiểm tra mọi thứ quan trọng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答案来自这条笔记的转录内容和你的 AI 提供方。请核实所有重要信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "答案來自這則筆記的逐字稿和你的 AI 提供方。請核實所有重要資訊。"
          }
        }
      }
