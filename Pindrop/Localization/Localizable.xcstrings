    "no_audio_was_recorded_for_this_note": {
      "comment": "No audio was recorded for this note.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسجَّل صوت لهذه الملاحظة."
          }
