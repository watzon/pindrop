        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać modelu mówców na żywo. Nagranie trwa dalej, a gotowa notatka i tak nazwie wszystkich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o modelo de falantes ao vivo. A gravação continua, e a nota final ainda nomeia todo mundo."
          }
