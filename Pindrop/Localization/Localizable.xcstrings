    "whatsnew_languages_body": {
      "comment": "This is the final release. Pindrop gets no new features, fixes, or support after it.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو الإصدار الأخير. لن يحصل Pindrop بعده على ميزات جديدة أو إصلاحات أو دعم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি চূড়ান্ত রিলিজ। এরপর Pindrop নতুন ফিচার, সংশোধন বা সহায়তা পাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je poslední verze. Pindrop už nedostane nové funkce, opravy ani podporu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er den sidste version. Pindrop får ingen nye funktioner, rettelser eller support herefter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die letzte Version. Pindrop erhält danach keine neuen Funktionen, Fehlerbehebungen oder Support mehr."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι η τελική έκδοση. Το Pindrop δεν θα λάβει νέες λειτουργίες, διορθώσεις ή υποστήριξη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the final release. Pindrop gets no new features, fixes, or support after it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la versión final. Pindrop no recibirá nuevas funciones, correcciones ni soporte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on viimeinen versio. Pindrop ei saa enää uusia ominaisuuksia, korjauksia eikä tukea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est la dernière version. Pindrop ne recevra plus de nouvelles fonctionnalités, de correctifs ni d’assistance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו הגרסה האחרונה. Pindrop לא יקבל אחריה תכונות חדשות, תיקונים או תמיכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अंतिम रिलीज़ है। इसके बाद Pindrop को नए फ़ीचर, सुधार या सहायता नहीं मिलेगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az utolsó kiadás. A Pindrop ezután nem kap új funkciókat, javításokat és támogatást."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah rilis terakhir. Pindrop tidak akan mendapat fitur baru, perbaikan, atau dukungan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è la versione finale. Pindrop non riceverà più nuove funzioni, correzioni o assistenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これが最終リリースです。Pindrop に新機能、修正、サポートは提供されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전이 최종 릴리스입니다. Pindrop에는 새 기능, 수정, 지원이 더 이상 제공되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah keluaran terakhir. Pindrop tidak akan menerima ciri baharu, pembaikan atau sokongan lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er den siste versjonen. Pindrop får ingen nye funksjoner, feilrettinger eller støtte etter dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is de laatste versie. Pindrop krijgt hierna geen nieuwe functies, fixes of ondersteuning meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest wersja końcowa. Pindrop nie otrzyma już nowych funkcji, poprawek ani wsparcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a versão final. O Pindrop não receberá novos recursos, correções nem suporte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta este versiunea finală. Pindrop nu mai primește funcții noi, remedieri sau asistență."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это последняя версия. Pindrop больше не получит новых функций, исправлений и поддержки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här är den sista versionen. Pindrop får inga nya funktioner, rättningar eller support efter den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือรุ่นสุดท้าย Pindrop จะไม่ได้รับฟีเจอร์ใหม่ การแก้ไข หรือการสนับสนุนอีก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu son sürümdür. Pindrop bundan sonra yeni özellik, düzeltme veya destek almayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це остання версія. Pindrop більше не отримає нових функцій, виправлень і підтримки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là bản phát hành cuối. Pindrop sẽ không có tính năng mới, bản sửa lỗi hay hỗ trợ nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是最终版本。此后 Pindrop 不再提供新功能、修复或支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是最終版本。此後 Pindrop 不再提供新功能、修正或支援。"
          }
        }
      }
    },
