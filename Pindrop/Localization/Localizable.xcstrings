    "the_answer_came_back_in_a_form_pindrop_could_not": {
      "comment": "The answer came back in a form Pindrop could not read. Ask again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت الإجابة بصيغة تعذّر على Pindrop قراءتها. اسأل مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তরটি এমন একটি রূপে ফিরে এসেছে যা Pindrop পড়তে পারেনি। আবার জিজ্ঞাসা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď přišla ve formátu, který Pindrop nedokázal přečíst. Zeptejte se znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret kom tilbage i en form, Pindrop ikke kunne læse. Spørg igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort kam in einer Form zurück, die Pindrop nicht lesen konnte. Fragen Sie erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση επέστρεψε σε μορφή που το Pindrop δεν μπόρεσε να διαβάσει. Ρωτήστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer came back in a form Pindrop could not read. Ask again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta llegó en un formato que Pindrop no pudo leer. Vuelve a preguntar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaus tuli muodossa, jota Pindrop ei osannut lukea. Kysy uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse est revenue dans un format que Pindrop n'a pas pu lire. Posez à nouveau la question."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה חזרה בפורמט ש-Pindrop לא הצליח לקרוא. שאלו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब ऐसे रूप में आया जिसे Pindrop पढ़ नहीं सका। फिर से पूछें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válasz olyan formában érkezett, amelyet a Pindrop nem tudott értelmezni. Kérdezzen újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban kembali dalam bentuk yang tidak bisa dibaca Pindrop. Tanya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta è tornata in un formato che Pindrop non è riuscito a leggere. Chiedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答がPindropで読み取れない形式で返されました。もう一度質問してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop이 읽을 수 없는 형식으로 답변이 돌아왔습니다. 다시 질문하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan kembali dalam bentuk yang Pindrop tidak dapat baca. Tanya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret kom tilbake i en form Pindrop ikke kunne lese. Spør på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord kwam terug in een vorm die Pindrop niet kon lezen. Vraag het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź wróciła w formie, której Pindrop nie mógł odczytać. Zapytaj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta voltou em um formato que o Pindrop não conseguiu ler. Pergunte de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul a revenit într-un format pe care Pindrop nu l-a putut citi. Întrebați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ пришёл в формате, который Pindrop не смог прочитать. Спросите снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret kom tillbaka i ett format som Pindrop inte kunde läsa. Fråga igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบกลับมาในรูปแบบที่ Pindrop อ่านไม่ได้ ถามอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt, Pindrop'un okuyamadığı bir biçimde döndü. Tekrar sorun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь повернулася у форматі, який Pindrop не зміг прочитати. Запитайте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời quay lại ở định dạng mà Pindrop không đọc được. Hãy hỏi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回的答案格式 Pindrop 无法读取。请重新提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳回的答案格式 Pindrop 無法讀取。請重新提問。"
          }
        }
      }
    },
    "the_answer_could_not_be_generated_check_your_con": {
      "comment": "The answer could not be generated. Check your connection, then ask again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء الإجابة. تحقق من اتصالك، ثم اسأل مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তরটি তৈরি করা যায়নি। আপনার সংযোগ যাচাই করে আবার জিজ্ঞাসা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď se nepodařilo vygenerovat. Zkontrolujte připojení a zeptejte se znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret kunne ikke genereres. Tjek din forbindelse, og spørg så igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort konnte nicht erzeugt werden. Prüfen Sie Ihre Verbindung, und fragen Sie dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση δεν δημιουργήθηκε. Ελέγξτε τη σύνδεσή σας και ρωτήστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer could not be generated. Check your connection, then ask again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo generar la respuesta. Comprueba tu conexión y vuelve a preguntar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastausta ei voitu luoda. Tarkista yhteytesi ja kysy sitten uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse n'a pas pu être générée. Vérifiez votre connexion, puis reposez la question."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה ליצור את התשובה. בדקו את החיבור שלכם ואז שאלו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब तैयार नहीं किया जा सका। अपना कनेक्शन जांचें, फिर दोबारा पूछें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A választ nem sikerült létrehozni. Ellenőrizze a kapcsolatát, majd kérdezzen újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban tidak bisa dibuat. Periksa koneksi Anda, lalu tanya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile generare la risposta. Controlla la connessione, poi chiedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を生成できませんでした。接続を確認してから、もう一度質問してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변을 생성하지 못했습니다. 연결을 확인한 후 다시 질문하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan tidak dapat dijana. Semak sambungan anda, kemudian tanya semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret kunne ikke genereres. Sjekk tilkoblingen din, og spør på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord kon niet worden gegenereerd. Controleer je verbinding en vraag het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wygenerować odpowiedzi. Sprawdź połączenie, a potem zapytaj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gerar a resposta. Verifique sua conexão e pergunte de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul nu a putut fi generat. Verificați conexiunea, apoi întrebați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сгенерировать ответ. Проверьте подключение и спросите снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret kunde inte genereras. Kontrollera din anslutning och fråga igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างคำตอบไม่ได้ ตรวจสอบการเชื่อมต่อของคุณแล้วถามอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıt oluşturulamadı. Bağlantınızı kontrol edip tekrar sorun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося згенерувати відповідь. Перевірте з'єднання, а потім запитайте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo câu trả lời. Hãy kiểm tra kết nối của bạn rồi hỏi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成答案。请检查网络连接，然后重新提问。"
