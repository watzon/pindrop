        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih antara Nemotron (bertanda baca, model dimuat turun) dan Apple SpeechTranscriber (macOS 26+, disertakan dengan OS)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
