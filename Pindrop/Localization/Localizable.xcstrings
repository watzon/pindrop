    "uses_the_560ms_nemotron_variant_for_snappier_par": {
      "comment": "uses_the_560ms_nemotron_variant_for_snappier_par",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم متغير Nemotron بسرعة 560 مللي ثانية لنص جزئي أسرع. الافتراضي هو متغير 1120 مللي ثانية (أفضل دقة)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুততর আংশিক টেক্সটের জন্য 560ms Nemotron ভ্যারিয়েন্ট ব্যবহার করে। ডিফল্ট হল 1120ms ভ্যারিয়েন্ট (সেরা নির্ভুলতা)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá variantu Nemotron 560 ms pro svižnější průběžný text. Výchozí je varianta 1120 ms (nejlepší přesnost)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger 560 ms Nemotron-varianten til hurtigere løbende tekst. Standard er 1120 ms-varianten (bedst nøjagtighed)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die 560-ms-Nemotron-Variante für flotteren Zwischentext. Standard ist die 1120-ms-Variante (beste Genauigkeit)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιεί την παραλλαγή Nemotron 560ms για πιο γρήγορο ενδιάμεσο κείμενο. Προεπιλογή είναι η παραλλαγή 1120ms (καλύτερη ακρίβεια)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the 560ms Nemotron variant for snappier partial text. Default is the 1120ms variant (best accuracy)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la variante Nemotron de 560 ms para texto parcial más ágil. La predeterminada es la variante de 1120 ms (mejor precisión)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttää 560 ms:n Nemotron-varianttia nopeampaan välitekstiin. Oletus on 1120 ms:n variantti (paras tarkkuus)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la variante Nemotron 560 ms pour un texte partiel plus réactif. La variante par défaut est 1120 ms (meilleure précision)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש בגרסת Nemotron של 560ms לטקסט חלקי מהיר יותר. ברירת המחדל היא גרסת 1120ms (הדיוק הטוב ביותר)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तेज़ आंशिक टेक्स्ट के लिए 560ms Nemotron वैरिएंट का उपयोग करता है। डिफ़ॉल्ट 1120ms वैरिएंट है (सर्वोत्तम सटीकता)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az 560 ms-os Nemotron-változatot használja a gyorsabb részszöveghez. Az alapértelmezett az 1120 ms-os változat (legjobb pontosság)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan varian Nemotron 560 md untuk teks parsial yang lebih responsif. Default adalah varian 1120 md (akurasi terbaik)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la variante Nemotron da 560 ms per testo parziale più reattivo. La predefinita è la variante da 1120 ms (migliore precisione)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "560msのNemotronバリアントを使用して途中テキストの表示を速くします。デフォルトは1120msバリアント（最高精度）です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 빠른 부분 텍스트를 위해 560ms Nemotron 변형을 사용합니다. 기본값은 1120ms 변형입니다(최고 정확도)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggunakan varian Nemotron 560ms untuk teks separa yang lebih pantas. Lalai ialah varian 1120ms (ketepatan terbaik)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker 560 ms Nemotron-varianten for raskere underveistekst. Standard er 1120 ms-varianten (best nøyaktighet)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt de 560ms Nemotron-variant voor vlottere tussentekst. Standaard is de 1120ms-variant (beste nauwkeurigheid)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa wariantu Nemotron 560 ms dla szybszego tekstu częściowego. Domyślny jest wariant 1120 ms (najlepsza dokładność)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a variante Nemotron de 560 ms para texto parcial mais ágil. O padrão é a variante de 1120 ms (melhor precisão)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește varianta Nemotron de 560 ms pentru text parțial mai rapid. Implicită este varianta de 1120 ms (cea mai bună acuratețe)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует вариант Nemotron 560 мс для более быстрого промежуточного текста. По умолчанию — вариант 1120 мс (лучшая точность)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder 560 ms Nemotron-varianten för snabbare deltext. Standard är 1120 ms-varianten (bäst noggrannhet)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Nemotron รุ่น 560ms เพื่อข้อความระหว่างพูดที่เร็วขึ้น ค่าเริ่มต้นคือรุ่น 1120ms (ความแม่นยำสูงสุด)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hızlı ara metin için 560 ms Nemotron varyantını kullanır. Varsayılan, 1120 ms varyantıdır (en iyi doğruluk)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує варіант Nemotron 560 мс для швидшого проміжного тексту. Типовим є варіант 1120 мс (найкраща точність)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng biến thể Nemotron 560ms để hiển thị văn bản tạm nhanh hơn. Mặc định là biến thể 1120ms (độ chính xác tốt nhất)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 560ms Nemotron 变体以更快显示中间文本。默认为 1120ms 变体（最佳准确度）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 560ms Nemotron 變體以更快顯示中間文字。預設為 1120ms 變體（最佳準確度）。"
          }
        }
      }
    },
