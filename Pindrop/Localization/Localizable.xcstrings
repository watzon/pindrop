        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles ne quittent jamais ce Mac. L’audio est traité localement sauf si vous choisissez un fournisseur cloud dans Réglages → IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
