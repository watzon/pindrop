            "state": "translated",
            "value": "Ihre verbesserte Notiz ist fertig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βελτιωμένη σημείωσή σας είναι έτοιμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your enhanced note is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nota mejorada está lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parannettu muistiinpanosi on valmis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre note améliorée est prête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפתק המשופר שלכם מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका उन्नत नोट तैयार है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feljavított jegyzete elkészült."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan Anda yang disempurnakan sudah siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua nota migliorata è pronta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強化メモができました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보강 메모가 준비되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota dipertingkat anda sudah sedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det forbedrede notatet ditt er klart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je verbeterde notitie is klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja ulepszona notatka jest gotowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua nota aprimorada está pronta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița dvs. îmbunătățită este gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша улучшенная заметка готова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din förbättrade anteckning är klar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตที่ปรับปรุงแล้วของคุณพร้อมแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirilmiş notunuz hazır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша покращена нотатка готова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú nâng cao của bạn đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的增强笔记已就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的增強筆記已就緒。"
          }
        }
      }
    },
    "your_floating_indicator_is_now_a_living_audio_re": {
      "comment": "your_floating_indicator_is_now_a_living_audio_re",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبح المؤشر العائم الآن كرة حية تتفاعل مع الصوت. يتنفس أثناء الخمول، ويتمدد عندما تتحدث، ويبث كلماتك مباشرة أثناء الإملاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভাসমান সূচকটি এখন একটি জীবন্ত, অডিও-প্রতিক্রিয়াশীল orb। নিষ্ক্রিয় থাকলে এটি শ্বাস নেয়, আপনি কথা বললে ফুলে ওঠে, এবং ডিক্টেট করার সময় আপনার শব্দ সরাসরি দেখায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Váš plovoucí indikátor je teď živý, zvukově reaktivní orb. V klidu dýchá, při řeči se zvětšuje a během diktování živě streamuje vaše slova."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din flydende indikator er nu en levende, lydreaktiv orb. Den ånder i tomgang, vokser når du taler, og streamer dine ord live mens du dikterer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine schwebende Anzeige ist jetzt ein lebendiger, audioreaktiver Orb. Sie atmet im Leerlauf, schwillt an, wenn du sprichst, und streamt deine Wörter live beim Diktieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αιωρούμενη ένδειξή σας είναι πλέον ένα ζωντανό orb που αντιδρά στον ήχο. Αναπνέει όταν είναι ανενεργό, μεγαλώνει όταν μιλάτε και μεταδίδει ζωντανά τις λέξεις σας καθώς υπαγορεύετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your floating indicator is now a living, audio-reactive orb. It breathes while idle, swells when you speak, and streams your words live as you dictate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu indicador flotante ahora es un orb vivo y reactivo al audio. Respira cuando está inactivo, se expande cuando hablas y transmite tus palabras en vivo mientras dictas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelluva ilmaisimesi on nyt elävä, ääneen reagoiva orb. Se hengittää levossa, kasvaa kun puhut ja näyttää sanasi suorana sanelun aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre indicateur flottant est désormais un orb vivant et réactif à l’audio. Il respire au repos, gonfle quand vous parlez et diffuse vos mots en direct pendant la dictée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחוון הצף שלך הוא עכשיו orb חי שמגיב לאודיו. הוא נושם כשהוא לא פעיל, מתרחב כשמדברים, ומשדר את המילים שלך בזמן אמת בזמן ההכתבה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ्लोटिंग इंडिकेटर अब एक जीवंत, ऑडियो-प्रतिक्रियाशील orb है। निष्क्रिय होने पर यह सांस लेता है, आपके बोलने पर फैलता है, और डिक्टेशन के दौरान आपके शब्द लाइव दिखाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lebegő jelző mostantól élő, hangra reagáló orb. Tétlenül lélegzik, beszéd közben megduzzad, és diktálás közben élőben közvetíti a szavaidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Indikator mengambang Anda kini menjadi orb hidup yang reaktif terhadap audio. Ia bernapas saat idle, membesar saat Anda berbicara, dan menayangkan kata-kata Anda secara langsung saat mendikte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo indicatore flottante ora è un orb vivo e reattivo all’audio. Respira quando è inattivo, si espande quando parli e mostra le tue parole in tempo reale mentre detti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フローティングインジケーターは、音声に反応する生きた Orb になりました。待機中は呼吸し、話すとふくらみ、ディクテーション中は言葉をライブで表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 플로팅 표시기는 소리에 반응하는 살아 있는 orb입니다. 대기 중에는 숨 쉬고, 말하면 부풀어 오르며, 받아쓰는 동안 단어를 실시간으로 보여줍니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penunjuk terapung anda kini orb hidup yang bertindak balas kepada audio. Ia bernafas ketika melahu, mengembang apabila anda bercakap, dan menstrim perkataan anda secara langsung semasa imlak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den flytende indikatoren er nå en levende, lydreaktiv orb. Den puster når den er inaktiv, sveller når du snakker, og strømmer ordene dine direkte mens du dikterer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zwevende indicator is nu een levende, audio-reactieve orb. Hij ademt wanneer hij inactief is, zwelt op wanneer je spreekt en streamt je woorden live terwijl je dicteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój pływający wskaźnik jest teraz żywą kulą reagującą na dźwięk. Oddycha w bezczynności, powiększa się, gdy mówisz, i na żywo pokazuje słowa podczas dyktowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu indicador flutuante agora é um orb vivo e reativo ao áudio. Ele respira quando está inativo, cresce quando você fala e transmite suas palavras ao vivo enquanto você dita."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicatorul tău plutitor este acum un orb viu, reactiv la audio. Respiră când este inactiv, se umflă când vorbești și transmite cuvintele în direct în timp ce dictezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающий индикатор теперь стал живым orb, реагирующим на звук. Он дышит в простое, увеличивается, когда вы говорите, и показывает ваши слова в реальном времени во время диктовки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din flytande indikator är nu en levande, ljudreaktiv orb. Den andas i vila, växer när du pratar och strömmar dina ord live medan du dikterar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวบ่งชี้แบบลอยของคุณตอนนี้เป็น orb ที่มีชีวิตและตอบสนองต่อเสียง หายใจเมื่ออยู่นิ่ง ขยายเมื่อคุณพูด และสตรีมคำของคุณแบบสดขณะป้อนตามคำบอก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayan göstergeniz artık sese tepki veren canlı bir orb. Boştayken nefes alır, konuştuğunuzda büyür ve dikte ederken kelimelerinizi canlı olarak aktarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш плаваючий індикатор тепер живий orb, що реагує на звук. Він дихає в режимі очікування, збільшується, коли ви говорите, і наживо показує ваші слова під час диктування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ báo nổi của bạn giờ là một orb sống động, phản ứng với âm thanh. Nó thở khi rảnh, phồng lên khi bạn nói và truyền trực tiếp lời của bạn khi bạn đọc chính tả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的浮动指示器现在是会对音频作出反应的活体 orb。闲置时会呼吸，说话时会膨胀，并在你听写时实时流式显示文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的浮動指示器現在是會對音訊反應的活體 orb。閒置時會呼吸，說話時會膨脹，並在你聽寫時即時串流顯示文字。"
          }
        }
      }
    },
    "your_hotkeys_are_ready_to_use_nyou_can_customize": {
      "comment": "your_hotkeys_are_ready_to_use_nyou_can_customize",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح التشغيل السريع الخاصة بك جاهزة للاستخدام. ويمكنك تخصيصها لاحقًا في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হটকিগুলি ব্যবহারের জন্য প্রস্তুত৷ আপনি পরে সেটিংসে গিয়ে কাস্টমাইজ করতে পারেন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše klávesové zkratky jsou připraveny k použití.nMůžete si je později přizpůsobit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine genvejstaster er klar til brug.nDu kan tilpasse dem senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Tastenkürzel sind bereit zur Verwendung.nSie können sie später in den Einstellungen anpassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα πρόσβασης είναι έτοιμα για χρήση.nΜπορείτε να τα προσαρμόσετε αργότερα στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hotkeys are ready to use.nYou can customize them later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hotkeys are ready to use.nYou can customize them later in Settings."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikanäppäimet ovat käyttövalmiita.nVoit muokata niitä myöhemmin asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos raccourcis sont prêts à être utilisés.nVous pouvez les personnaliser plus tard dans les Paramètres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקשים החמים שלך מוכנים לשימוש. nתוכל להתאים אותם מאוחר יותר בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी हॉटकी उपयोग के लिए तैयार हैं। आप उन्हें बाद में सेटिंग्स में कस्टमाइज़ कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsbillentyűi használatra készek.nKésőbb személyre szabhatja őket a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol pintas Anda siap digunakan.nAnda dapat menyesuaikannya nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tasti di scelta rapida sono pronti per l'uso. Puoi personalizzarli in seguito in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットキーを使用する準備ができました。n後から [設定] でホットキーをカスタマイズできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 사용할 준비가 되었습니다.n나중에 설정에서 단축키를 맞춤설정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci pintas anda sedia untuk digunakan.nAnda boleh menyesuaikannya kemudian dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigtastene dine er klare til bruk.nDu kan tilpasse dem senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw sneltoetsen zijn klaar voor gebruik.nU kunt ze later aanpassen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje skróty klawiszowe są gotowe do użycia.\nMożesz je później dostosować w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas teclas de atalho estão prontas para uso. Você pode personalizá-las posteriormente em Configurações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele rapide sunt gata de utilizare.nLe puteți personaliza mai târziu în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши горячие клавиши готовы к использованию. Вы можете настроить их позже в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina snabbtangenter är redo att användas.nDu kan anpassa dem senare i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดของคุณพร้อมใช้งานแล้ว คุณสามารถปรับแต่งได้ในภายหลังในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayol tuşlarınız kullanıma hazır.nBunları daha sonra Ayarlar'da özelleştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші гарячі клавіші готові до використання.nВи можете налаштувати їх пізніше в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím nóng của bạn đã sẵn sàng để sử dụng.nBạn có thể tùy chỉnh chúng sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的快捷键已准备好使用。n您可以稍后在设置中自定义它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的快捷鍵已準備好使用。n您可以稍後在設定中自定義它們。"
          }
        }
      }
    },
    "your_hotkeys_are_ready_to_use_you_can_customize": {
      "comment": "your_hotkeys_are_ready_to_use_you_can_customize",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفاتيح التشغيل السريع الخاصة بك جاهزة للاستخدام.\nويمكنك تخصيصها لاحقًا في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার হটকিগুলি ব্যবহারের জন্য প্রস্তুত।\n\nআপনি সেগুলিকে পরে সেটিংসে কাস্টমাইজ করতে পারেন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše klávesové zkratky jsou připraveny k použití.\nPozději je můžete upravit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine genvejstaster er klar til brug.\nDu kan tilpasse dem senere i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Tastenkürzel sind bereit zur Verwendung.\nSie können sie später in den Einstellungen anpassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα πλήκτρα πρόσβασης είναι έτοιμα για χρήση.\nΜπορείτε να τα προσαρμόσετε αργότερα στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hotkeys are ready to use.\nYou can customize them later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus atajos ya están listos.\nPuedes personalizarlos más tarde en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikanäppäimet ovat valmiita käytettäväksi.\nVoit muokata niitä myöhemmin asetuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos raccourcis sont prêts à être utilisés.\nVous pouvez les personnaliser plus tard dans les Paramètres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקשים החמים שלך מוכנים לשימוש.\nתוכל להתאים אותם מאוחר יותר בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी हॉटकीज़ उपयोग के लिए तैयार हैं।\nआप उन्हें बाद में सेटिंग्स में कस्टमाइज़ कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsbillentyűi használatra készek.\nKésőbb személyre szabhatja őket a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tombol pintas Anda siap digunakan.\nAnda dapat menyesuaikannya nanti di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi tasti di scelta rapida sono pronti per l'uso.\nPuoi personalizzarli in seguito in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットキーを使用する準備ができました。\n後で [設定] でカスタマイズできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 사용할 준비가 되었습니다.\n나중에 설정에서 맞춤설정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekunci pintas anda sedia untuk digunakan.\nAnda boleh menyesuaikannya kemudian dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigtastene dine er klare til bruk.\nDu kan tilpasse dem senere i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw sneltoetsen zijn klaar voor gebruik.\nJe kunt ze later aanpassen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje skróty klawiszowe są gotowe do użycia.\nMożesz je później dostosować w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas teclas de atalho estão prontas para uso.\nVocê pode personalizá-los posteriormente em Configurações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastele rapide sunt gata de utilizare.\nLe puteți personaliza mai târziu în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши горячие клавиши готовы к использованию.\nВы можете настроить их позже в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina snabbtangenter är redo att användas.\nDu kan anpassa dem senare i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปุ่มลัดของคุณพร้อมใช้งานแล้ว\nคุณสามารถปรับแต่งได้ในภายหลังในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayol tuşlarınız kullanıma hazır.\nBunları daha sonra Ayarlar'da özelleştirebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші гарячі клавіші готові до використання.\nВи можете налаштувати їх пізніше в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím nóng của bạn đã sẵn sàng để sử dụng.\nBạn có thể tùy chỉnh chúng sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的快捷键已准备好使用。\n您可以稍后在设置中自定义它们。"
          }
        },
        "zh-Hant": {
