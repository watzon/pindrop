        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग शुरू होते ही वक्ता तय हो जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
