    "u5_u7_models_privacy_footnote": {
      "comment": "u5_u7_models_privacy_footnote",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle verlassen diesen Mac nie. Audio wird lokal verarbeitet, es sei denn, du wählst einen Cloud-Anbieter unter Einstellungen → KI."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos nunca salen de este Mac. El audio se procesa localmente salvo que elijas un proveedor en la nube en Ajustes → IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
