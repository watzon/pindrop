          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui ha parlato qualcun altro. La nota finale lo contiene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで別の人が話しました。完成したメモには入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
