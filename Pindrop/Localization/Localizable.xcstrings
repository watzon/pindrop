    "detected_from_the_recording_renames_apply_to_the": {
      "comment": "Detected from the recording. Click a name to change it. Renames apply to the transcript and future notes.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتُشف من التسجيل. تنطبق إعادة التسمية على النص والملاحظات المقبلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং থেকে শনাক্ত হয়েছে। নাম পরিবর্তন প্রতিলিপি এবং ভবিষ্যতের নোটে প্রযোজ্য হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznáno z nahrávky. Přejmenování se použije na přepis i budoucí poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreret fra optagelsen. Omdøbninger gælder for udskriften og fremtidige noter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Aufnahme erkannt. Umbenennungen gelten für das Transkript und künftige Notizen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εντοπίστηκε από την εγγραφή. Οι μετονομασίες ισχύουν για το απομαγνητοφωνημένο κείμενο και τις μελλοντικές σημειώσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected from the recording. Click a name to change it. Renames apply to the transcript and future notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectado a partir de la grabación. Los cambios de nombre se aplican a la transcripción y a las notas futuras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistettu tallenteesta. Nimenmuutokset koskevat tekstitystä ja tulevia muistiinpanoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecté à partir de l'enregistrement. Les renommages s'appliquent à la transcription et aux futures notes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוהה מההקלטה. שינויי שם חלים על התמלול ועל פתקים עתידיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग से पहचाना गया। नाम बदलना प्रतिलेख और आने वाले नोट्स पर लागू होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felvételből felismerve. Az átnevezések az átiratra és a jövőbeli jegyzetekre is érvényesek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terdeteksi dari rekaman. Perubahan nama berlaku untuk transkrip dan catatan mendatang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevato dalla registrazione. Le rinomine si applicano alla trascrizione e alle note future."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音から検出されました。名前の変更は文字起こしと今後のメモに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음에서 감지됨. 이름 변경은 대본과 향후 메모에 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikesan daripada rakaman. Penamaan semula terpakai pada transkrip dan nota akan datang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdaget fra opptaket. Navneendringer gjelder for transkripsjonen og fremtidige notater."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedetecteerd op basis van de opname. Naamswijzigingen gelden voor het transcript en toekomstige notities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto z nagrania. Zmiany nazw dotyczą transkrypcji i przyszłych notatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectado a partir da gravação. As renomeações se aplicam à transcrição e às notas futuras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Detectat din înregistrare. Redenumirile se aplică transcrierii și notițelor viitoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определено из записи. Переименования применяются к транскрипту и будущим заметкам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifierad från inspelningen. Namnändringar gäller transkriptet och framtida anteckningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจพบจากการบันทึก การเปลี่ยนชื่อมีผลกับข้อความถอดเสียงและโน้ตในอนาคต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıttan algılandı. Yeniden adlandırmalar dökümde ve gelecekteki notlarda geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначено із запису. Перейменування застосовуються до транскрипту і майбутніх нотаток."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được phát hiện từ bản ghi âm. Việc đổi tên áp dụng cho bản chép lời và các ghi chú sau này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从录音中识别。重命名会应用到转录内容和以后的笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從錄音中辨識。重新命名會套用到逐字稿和之後的筆記。"
          }
        }
      }
    },
