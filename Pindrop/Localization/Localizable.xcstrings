    "capture_directly_into_the_note_editor_with_a_hol": {
      "comment": "capture_directly_into_the_note_editor_with_a_hol",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط الصور مباشرة في محرر الملاحظات من خلال تدفق التثبيت للتسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হোল্ড-টু-রেকর্ড ফ্লো সহ নোট এডিটরে সরাসরি ক্যাপচার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachyťte přímo do editoru poznámek pomocí toku podržení pro záznam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fang direkte ind i noteeditoren med et hold-til-optag flow."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkt in den Notiz-Editor mit Hold-to-Record-Flow aufnehmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποτυπώστε απευθείας στο πρόγραμμα επεξεργασίας σημειώσεων με μια ροή αναμονής για εγγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture directly into the note editor with a hold-to-record flow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura directamente en el editor de notas con un flujo de mantener pulsado para grabar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna suoraan muistiinpanoeditoriin pidä-tallenna -toiminnolla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez directement dans l'éditeur de notes avec un flux maintenir-pour-enregistrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכוד ישירות לתוך עורך ההערות עם זרימת החזקה להקלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होल्ड-टू-रिकॉर्ड प्रवाह के साथ सीधे नोट संपादक में कैप्चर करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítse közvetlenül a jegyzetszerkesztőbe a rögzítés tartása folyamattal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkap langsung ke editor catatan dengan alur tahan untuk merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cattura direttamente nell'editor delle note con un flusso hold-to-record."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホールドして録音するフローを使用して、ノートエディターに直接キャプチャします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 보관 흐름을 통해 노트 편집기에 직접 캡처하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkap terus ke dalam editor nota dengan aliran tahan untuk rekod."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta direkte inn i notatredigeringsprogrammet med en hold-til-opptak-flyt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg direct vast in de notitie-editor met een hold-to-record-stroom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechwytuj bezpośrednio w edytorze notatek za pomocą skrótu wymagającego przytrzymania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture diretamente no editor de notas com um fluxo de retenção para gravação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturați direct în editorul de note cu un flux hold-to-record."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте записи непосредственно в редакторе заметок с помощью процесса удержания для записи."
          }
        },
        "sv": {
