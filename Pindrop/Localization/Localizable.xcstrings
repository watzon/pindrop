    "whatsnew_formatting_body": {
      "comment": "You can continue to use this version. Your transcripts, notes, and settings stay on your Mac.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الاستمرار في استخدام هذا الإصدار. تبقى نصوصك وملاحظاتك وإعداداتك على جهاز Mac."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এই সংস্করণ ব্যবহার চালিয়ে যেতে পারেন। আপনার ট্রান্সক্রিপ্ট, নোট ও সেটিংস আপনার Mac-এই থাকে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto verzi můžete používat dál. Přepisy, poznámky a nastavení zůstávají ve vašem Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsætte med at bruge denne version. Dine transskriptioner, noter og indstillinger bliver på din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Version weiter verwenden. Deine Transkripte, Notizen und Einstellungen bleiben auf deinem Mac."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να συνεχίσετε να χρησιμοποιείτε αυτή την έκδοση. Οι μεταγραφές, οι σημειώσεις και οι ρυθμίσεις σας παραμένουν στο Mac σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can continue to use this version. Your transcripts, notes, and settings stay on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir usando esta versión. Tus transcripciones, notas y ajustes permanecen en tu Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit jatkaa tämän version käyttöä. Litteroinnit, muistiinpanot ja asetukset säilyvät Macissasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer à utiliser cette version. Vos transcriptions, notes et réglages restent sur votre Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להמשיך להשתמש בגרסה זו. התמלולים, הפתקים וההגדרות שלך נשארים ב-Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस संस्करण का उपयोग जारी रख सकते हैं। आपके ट्रांसक्रिप्ट, नोट और सेटिंग आपके Mac पर ही रहते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a verziót tovább használhatja. Az átiratok, jegyzetek és beállítások a Macen maradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat terus memakai versi ini. Transkrip, catatan, dan pengaturan Anda tetap ada di Mac Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare a usare questa versione. Trascrizioni, note e impostazioni restano sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンは引き続き使用できます。文字起こし、メモ、設定は Mac に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전을 계속 사용할 수 있습니다. 전사 내용, 메모, 설정은 Mac에 그대로 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh terus menggunakan versi ini. Transkrip, nota dan tetapan anda kekal pada Mac anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsette å bruke denne versjonen. Transkripsjoner, notater og innstillinger blir værende på Macen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze versie blijven gebruiken. Je transcripties, notities en instellingen blijven op je Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dalej używać tej wersji. Transkrypcje, notatki i ustawienia pozostają na Twoim Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar usando esta versão. Suas transcrições, notas e ajustes permanecem no seu Mac."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți folosi în continuare această versiune. Transcrierile, notițele și setările rămân pe Mac-ul tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете и дальше использовать эту версию. Ваши расшифровки, заметки и настройки остаются на вашем Mac."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsätta använda den här versionen. Dina transkriptioner, anteckningar och inställningar finns kvar på din Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณใช้รุ่นนี้ต่อไปได้ บทถอดเสียง โน้ต และการตั้งค่าของคุณยังอยู่บน Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümü kullanmaya devam edebilirsiniz. Transkriptleriniz, notlarınız ve ayarlarınız Mac'inizde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете й надалі користуватися цією версією. Ваші транскрипції, нотатки й налаштування залишаються на вашому Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tiếp tục dùng phiên bản này. Bản chép lời, ghi chú và cài đặt vẫn nằm trên máy Mac của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以继续使用此版本。你的转写、笔记和设置都保留在 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以繼續使用此版本。你的逐字稿、筆記和設定都保留在 Mac 上。"
          }
        }
      }
    },
