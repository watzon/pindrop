        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppdateringskontroller er midlertidig utilgjengelige."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Updatecontroles zijn tijdelijk niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie aktualizacji jest tymczasowo niedostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As verificações de atualização estão temporariamente indisponíveis."
          }
        },
        "ro": {
