        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबे श्रुतलेख में वाक्य समूहों के बीच खाली पंक्तियाँ जोड़ता है। पूरी तरह स्थानीय, बिना AI।"
          }
