        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонімна діагностика та сигнали використання. Ніколи — текст транскрипцій, аудіо чи особистий вміст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chẩn đoán và tín hiệu sử dụng ẩn danh. Không bao giờ có văn bản phiên âm, âm thanh hay nội dung cá nhân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名诊断和使用信号。绝不包含转录文本、音频或个人内容。"
