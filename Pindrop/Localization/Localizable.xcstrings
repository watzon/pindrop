    "u9_onboarding_accessibility_clipboard_fallback": {
      "comment": "u9_onboarding_accessibility_clipboard_fallback",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون إذن تسهيلات الاستخدام، ينسخ Pindrop النص إلى الحافظة بدلاً من ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাক্সেসিবিলিটি ছাড়া Pindrop পাঠ্যটি ক্লিপবোর্ডে কপি করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez Zpřístupnění Pindrop místo toho zkopíruje text do schránky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden Tilgængelighed kopierer Pindrop i stedet teksten til udklipsholderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Bedienungshilfen kopiert Pindrop den Text stattdessen in die Zwischenablage."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς την Προσβασιμότητα, το Pindrop αντιγράφει το κείμενο στο πρόχειρο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without Accessibility, Pindrop copies text to the clipboard instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Accesibilidad, Pindrop copia el texto al portapapeles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman Käyttöapua Pindrop kopioi tekstin leikepöydälle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans Accessibilité, Pindrop copie le texte dans le presse-papiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללא נגישות, Pindrop מעתיק את הטקסט ללוח במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility के बिना, Pindrop टेक्स्ट को क्लिपबोर्ड पर कॉपी करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kisegítő lehetőségek nélkül a Pindrop a vágólapra másolja a szöveget."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa Aksesibilitas, Pindrop akan menyalin teks ke papan klip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza Accessibilità, Pindrop copia invece il testo negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティがない場合、Pindrop はテキストをクリップボードにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 권한이 없으면 Pindrop이 텍스트를 클립보드에 복사합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa Kebolehcapaian, Pindrop menyalin teks ke papan klip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten Tilgjengelighet kopierer Pindrop teksten til utklippstavlen i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder Toegankelijkheid kopieert Pindrop de tekst naar het klembord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez Dostępności Pindrop kopiuje tekst do schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem Acessibilidade, o Pindrop copia o texto para a área de transferência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără Accesibilitate, Pindrop copiază textul în clipboard."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без Универсального доступа Pindrop копирует текст в буфер обмена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan Hjälpmedel kopierar Pindrop texten till urklipp i stället."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีการช่วยการเข้าถึง Pindrop จะคัดลอกข้อความไปยังคลิปบอร์ดแทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik olmadan Pindrop metni panoya kopyalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без Доступності Pindrop копіює текст у буфер обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không có Trợ năng, Pindrop sẽ sao chép văn bản vào bảng nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有辅助功能权限时，Pindrop 会将文本复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有輔助使用權限時，Pindrop 會將文字複製到剪貼簿。"
          }
        }
      }
    },
    "u9_onboarding_change_hotkey_hint": {
      "comment": "u9_onboarding_change_hotkey_hint",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط تركيبة مختلفة لتغييرها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি বদলাতে অন্য একটি কী সমন্বয় চাপুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změníte ji stisknutím jiné kombinace"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en anden kombination for at ændre den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke eine andere Kombination, um sie zu ändern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε διαφορετικό συνδυασμό για να τον αλλάξετε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a different combination to change it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa otra combinación para cambiarla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda painamalla eri näppäinyhdistelmää"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une autre combinaison pour la modifier"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו על צירוף אחר כדי לשנות אותו"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बदलने के लिए कोई दूसरा संयोजन दबाएँ"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A módosításhoz nyomjon meg egy másik kombinációt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan kombinasi lain untuk mengubahnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi una combinazione diversa per modificarla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更するには別のキーの組み合わせを押してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경하려면 다른 키 조합을 누르세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan gabungan lain untuk mengubahnya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk en annen kombinasjon for å endre den"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk op een andere combinatie om deze te wijzigen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij inną kombinację, aby ją zmienić"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione outra combinação para alterá-la"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apăsați o altă combinație pentru a o schimba"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите другое сочетание, чтобы изменить его"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en annan kombination för att ändra den"
          }
