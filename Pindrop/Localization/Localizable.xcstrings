    "download_the_diarization_model_before_starting_m": {
      "comment": "download_the_diarization_model_before_starting_m",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتنزيل نموذج diarization قبل البدء في نسخ الوسائط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিডিয়া ট্রান্সক্রিপশন শুরু করার আগে ডায়েরাইজেশন মডেল ডাউনলোড করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před zahájením transkripce médií si stáhněte diarizační model."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Download diariseringsmodellen, før du starter medietransskription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie das Diarisierungsmodell herunter, bevor Sie mit der Medientranskription beginnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε λήψη του μοντέλου diarization πριν ξεκινήσετε τη μεταγραφή πολυμέσων."
          }
