    "thanks_to_for_investigating_and_kicking_off_the": {
      "comment": "thanks_to_for_investigating_and_kicking_off_the",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شكرًا لـ %@ على التحقيق وبدء الإصلاح (PR #64)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুসন্ধান করে সমাধান শুরু করার জন্য %@-কে ধন্যবাদ (PR #64)।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky %@ za prozkoumání a nastartování opravy (PR #64)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak til %@ for at undersøge og sætte rettelsen i gang (PR #64)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke an %@ fürs Untersuchen und Anstoßen der Korrektur (PR #64)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ευχαριστούμε τον/την %@ για τη διερεύνηση και την έναρξη της διόρθωσης (PR #64)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks to %@ for investigating and kicking off the fix (PR #64)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias a %@ por investigar e iniciar la corrección (PR #64)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiitos %@ selvitystyöstä ja korjauksen käynnistämisestä (PR #64)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci à %@ pour l’enquête et le lancement du correctif (PR #64)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תודה ל-%@ על החקירה והתחלת התיקון (PR #64)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच करने और सुधार शुरू करने के लिए %@ का धन्यवाद (PR #64)।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Köszönet %@ számára a hiba feltárásáért és a javítás elindításáért (PR #64)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih kepada %@ karena telah menyelidiki dan memulai perbaikan (PR #64)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie a %@ per aver indagato e avviato la correzione (PR #64)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調査し修正のきっかけを作ってくれた %@ に感謝します (PR #64)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 조사하고 수정의 출발점을 마련해 준 %@님께 감사드립니다 (PR #64)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih kepada %@ kerana menyiasat dan memulakan pembaikan (PR #64)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk til %@ for å undersøke og sette i gang rettingen (PR #64)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dank aan %@ voor het onderzoeken en het starten van de oplossing (PR #64)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy %@ za zbadanie problemu i rozpoczęcie poprawki (PR #64)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado a %@ por investigar e iniciar a correção (PR #64)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulțumiri lui %@ pentru investigație și pentru pornirea remedierii (PR #64)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо %@ за расследование и запуск исправления (PR #64)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack till %@ för undersökningen och starten på korrigeringen (PR #64)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณ %@ สำหรับการตรวจสอบและเริ่มต้นการแก้ไข (PR #64)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araştırıp düzeltmeyi başlattığı için %@ kişisine teşekkürler (PR #64)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо %@ за розслідування та початок виправлення (PR #64)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn %@ đã điều tra và khởi đầu bản sửa lỗi (PR #64)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢 %@ 调查并启动修复 (PR #64)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感謝 %@ 調查並啟動修正 (PR #64)。"
          }
        }
      }
    },
