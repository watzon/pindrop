    "writing_your_enhanced_note_comes_next_long_recor": {
      "comment": "Writing your enhanced note comes next. Long recordings can take a few minutes. You can keep typing.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي بعد ذلك كتابة ملاحظتك المعززة. قد تستغرق التسجيلات الطويلة بضع دقائق. يمكنك متابعة الكتابة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এরপর আপনার উন্নত নোট লেখা হয়। দীর্ঘ রেকর্ডিংয়ে কয়েক মিনিট লাগতে পারে। আপনি টাইপ করে যেতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dále se píše vaše vylepšená poznámka. U dlouhých nahrávek to může trvat několik minut. Můžete dál psát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derefter skrives din forbedrede note. Lange optagelser kan tage et par minutter. Du kan skrive videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Nächstes wird Ihre verbesserte Notiz geschrieben. Bei langen Aufnahmen kann das ein paar Minuten dauern. Sie können weitertippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη συνέχεια γράφεται η βελτιωμένη σημείωσή σας. Οι μεγάλες εγγραφές μπορεί να χρειαστούν μερικά λεπτά. Μπορείτε να συνεχίσετε να πληκτρολογείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing your enhanced note comes next. Long recordings can take a few minutes. You can keep typing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después se escribe tu nota mejorada. Las grabaciones largas pueden tardar unos minutos. Puedes seguir escribiendo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraavaksi kirjoitetaan parannettu muistiinpanosi. Pitkissä tallenteissa se voi kestää muutaman minuutin. Voit jatkaa kirjoittamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture de votre note améliorée vient ensuite. Les longs enregistrements peuvent prendre quelques minutes. Vous pouvez continuer à taper."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחר כך נכתב הפתק המשופר שלכם. הקלטות ארוכות עשויות לקחת כמה דקות. אתם יכולים להמשיך להקליד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बाद आपका उन्नत नोट लिखा जाता है। लंबी रिकॉर्डिंग में कुछ मिनट लग सकते हैं। आप टाइप करते रह सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezután készül a feljavított jegyzete. Hosszú felvételeknél ez néhány percig tarthat. Közben tovább gépelhet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikutnya catatan Anda yang disempurnakan ditulis. Rekaman panjang bisa memakan beberapa menit. Anda bisa terus mengetik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi viene scritta la tua nota migliorata. Le registrazioni lunghe possono richiedere qualche minuto. Puoi continuare a scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に強化メモを作成します。長い録音では数分かかることがあります。そのまま入力を続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음으로 보강 메모를 작성합니다. 긴 녹음은 몇 분 걸릴 수 있습니다. 계속 입력해도 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seterusnya nota dipertingkat anda ditulis. Rakaman panjang boleh mengambil beberapa minit. Anda boleh terus menaip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deretter skrives det forbedrede notatet ditt. Lange opptak kan ta noen minutter. Du kan skrive videre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarna wordt je verbeterde notitie geschreven. Bij lange opnames kan dat een paar minuten duren. Je kunt gewoon doortypen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następnie powstaje Twoja ulepszona notatka. Przy długich nagraniach może to potrwać kilka minut. Możesz pisać dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois vem a escrita da sua nota aprimorada. Gravações longas podem levar alguns minutos. Você pode continuar digitando."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmează scrierea notiței dvs. îmbunătățite. Înregistrările lungi pot dura câteva minute. Puteți continua să scrieți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дальше пишется ваша улучшенная заметка. Для длинных записей это может занять несколько минут. Вы можете продолжать печатать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedan skrivs din förbättrade anteckning. Långa inspelningar kan ta några minuter. Du kan fortsätta skriva."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นต่อไปคือการเขียนโน้ตที่ปรับปรุงแล้วของคุณ การบันทึกที่ยาวอาจใช้เวลาสองสามนาที คุณพิมพ์ต่อได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırada geliştirilmiş notunuzun yazılması var. Uzun kayıtlar birkaç dakika sürebilir. Yazmaya devam edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Далі пишемо вашу покращену нотатку. Довгі записи можуть зайняти кілька хвилин. Ви можете писати далі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo là viết ghi chú nâng cao của bạn. Bản ghi dài có thể mất vài phút. Bạn có thể gõ tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来会写你的增强笔记。录音较长时可能需要几分钟。你可以继续打字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來會寫你的增強筆記。錄音較長時可能需要幾分鐘。你可以繼續打字。"
          }
        }
      }
    },
