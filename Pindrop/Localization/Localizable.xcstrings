    "u3_library_import_file_or_paste_link": {
      "comment": "u3_library_import_file_or_paste_link",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد ملفًا أو الصق رابطًا لنسخ الوسائط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিডিয়া ট্রান্সক্রাইব করতে ফাইল আমদানি বা লিংক পেস্ট করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importujte soubor nebo vložte odkaz pro přepis médií."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer en fil eller indsæt et link for at transskribere medier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere eine Datei oder füge einen Link ein, um Medien zu transkribieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε αρχείο ή επικολλήστε σύνδεσμο για μεταγραφή πολυμέσων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a file or paste a link to transcribe media."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un archivo o pega un enlace para transcribir medios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo tiedosto tai liitä linkki median litterointiin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un fichier ou collez un lien pour transcrire un média."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבא קובץ או הדבק קישור לתמלול מדיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया ट्रांसक्राइब करने के लिए फ़ाइल आयात करें या लिंक पेस्ट करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálj fájlt vagy illessz be hivatkozást média átírásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor file atau tempel tautan untuk mentranskripsi media."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un file o incolla un link per trascrivere i media."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込むかリンクを貼り付けてメディアを文字起こしします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 가져오거나 링크를 붙여넣어 미디어를 전사하세요."
          }
        },
        "ms": {
          "stringUnit": {
