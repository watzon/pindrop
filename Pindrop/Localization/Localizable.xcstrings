            "value": "Her snakket noen andre. Det ferdige notatet har det med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier sprak iemand anders. De voltooide notitie bevat het."
          }
        },
        "pl": {
          "stringUnit": {
