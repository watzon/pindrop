          "stringUnit": {
            "state": "translated",
            "value": "Диктування з’являються тут після голосу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính tả xuất hiện ở đây sau khi dùng giọng nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
