        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি এই Mac থেকে সব সংরক্ষিত টেক্সট জোড়া স্থায়ীভাবে মুছে ফেলে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímto se trvale smažou všechny uložené textové páry z tohoto Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter permanent alle gemte tekstpar fra denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle gespeicherten Textpaare dauerhaft von diesem Mac gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει οριστικά όλα τα αποθηκευμένα ζεύγη κειμένου από αυτόν τον Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes all stored text pairs from this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todos los pares de texto guardados de este Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi kaikki tallennetut tekstiparit tästä Macista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement toutes les paires de texte stockées de ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת לצמיתות את כל זוגות הטקסט השמורים מ-Mac זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस Mac से सभी संग्रहीत टेक्स्ट जोड़े स्थायी रूप से हटा देता है।"
