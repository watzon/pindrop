    "manually_check_for_new_versions_now": {
      "comment": "manually_check_for_new_versions_now",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق يدويًا من وجود إصدارات جديدة الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন নতুন সংস্করণের জন্য ম্যানুয়ালি পরীক্ষা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyní ručně zkontrolujte nové verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tjek manuelt for nye versioner nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt manuell auf neue Versionen prüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ελέγξτε με μη αυτόματο τρόπο για νέες εκδόσεις τώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manually check for new versions now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar manualmente nuevas versiones ahora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista uudet versiot manuaalisesti nyt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier manuellement les nouvelles versions maintenant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק ידנית אם יש גרסאות חדשות עכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब नए संस्करणों के लिए मैन्युअल रूप से जाँच करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most manuálisan ellenőrizze az új verziókat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa versi baru secara manual sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla manualmente la presenza di nuove versioni adesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ新しいバージョンを手動で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 새 버전을 수동으로 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak secara manual untuk versi baharu sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se etter nye versjoner manuelt nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer nu handmatig op nieuwe versies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź teraz ręcznie dostępność nowych wersji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique manualmente se há novas versões agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați manual dacă există versiuni noi acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте наличие новых версий вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera manuellt efter nya versioner nu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบเวอร์ชันใหม่ด้วยตนเองทันที"
