    "u8_settings_presets_recolor_caption": {
      "comment": "u8_settings_presets_recolor_caption",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعيد الإعدادات المسبقة تلوين لون التمييز والخلفيات. يتم التحقق من تباين النص تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রিসেটগুলি অ্যাক্সেন্ট রঙ এবং পটভূমি পুনরায় রং করে। টেক্সট কনট্রাস্ট স্বয়ংক্রিয়ভাবে যাচাই করা হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předvolby přebarví akcent a pozadí. Kontrast textu se ověřuje automaticky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forudindstillinger genfarver accent og baggrunde. Tekstkontrast valideres automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voreinstellungen färben Akzent und Hintergründe neu. Textkontrast wird automatisch geprüft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προεπιλογές αλλάζουν το χρώμα της έμφασης και του φόντου. Η αντίθεση κειμένου επικυρώνεται αυτόματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presets recolor the accent and grounds. Text contrast is validated automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes recolorean el acento y los fondos. El contraste del texto se valida automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiasetukset värittävät korostuksen ja taustat uudelleen. Tekstin kontrasti tarkistetaan automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les préréglages recolorent l’accent et les fonds. Le contraste du texte est validé automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההגדרות הקבועות מראש משנות את צבע ההדגשה והרקעים. ניגודיות הטקסט מאומתת אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीसेट एक्सेंट रंग और पृष्ठभूमि को फिर से रंगते हैं। टेक्स्ट कंट्रास्ट स्वचालित रूप से सत्यापित किया जाता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előbeállítások újraszínezik a kiemelő színt és a hátteret. A szövegkontrasztot a rendszer automatikusan ellenőrzi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prasetel mewarnai ulang aksen dan latar belakang. Kontras teks divalidasi secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le preimpostazioni ricolorano l'accento e gli sfondi. Il contrasto del testo viene convalidato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットはアクセントと背景を再配色します。文字のコントラストは自動検証されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 설정은 강조 색상과 배경을 다시 칠합니다. 텍스트 대비는 자동으로 검증됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratetap mewarnakan semula aksen dan latar belakang. Kontras teks disahkan secara automatik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsinnstillinger fargelegger aksent og bakgrunner på nytt. Tekstkontrast valideres automatisk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorinstellingen geven het accent en de achtergronden een nieuwe kleur. Tekstcontrast wordt automatisch gevalideerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia wstępne zmieniają kolor akcentu i teł. Kontrast tekstu jest weryfikowany automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As predefinições recolorem o destaque e os planos de fundo. O contraste do texto é validado automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Presetările recolorează accentul și fundalurile. Contrastul textului este validat automat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресеты перекрашивают акцент и фоны. Контраст текста проверяется автоматически."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förinställningar färgar om accent och bakgrunder. Textkontrast valideras automatiskt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่าที่ตั้งไว้ล่วงหน้าจะเปลี่ยนสีเน้นและพื้นหลังใหม่ คอนทราสต์ของข้อความจะได้รับการตรวจสอบโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ön ayarlar vurgu ve zemin renklerini yeniden boyar. Metin kontrastı otomatik olarak doğrulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресети перефарбовують акцент і фони. Контраст тексту перевіряється автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt trước sẽ đổi màu nhấn và nền. Độ tương phản văn bản được xác thực tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设会重新着色强调色和背景。文本对比度会自动校验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設會重新著色強調色與背景。文字對比會自動驗證。"
          }
        }
      }
    },
