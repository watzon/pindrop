    "notifications_are_turned_off_for_pindrop_turn_th": {
      "comment": "Notifications are turned off for Pindrop. Turn them on in System Settings to be asked about calls.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة لتطبيق Pindrop. شغّلها في إعدادات النظام ليتم سؤالك عن المكالمات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop-এর জন্য বিজ্ঞপ্তি বন্ধ আছে। কল সম্পর্কে জিজ্ঞেস করা হোক চাইলে সিস্টেম সেটিংসে সেগুলি চালু করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznámení jsou pro Pindrop vypnutá. Zapněte je v Nastavení systému, abyste byli na hovory dotázáni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer er slået fra for Pindrop. Slå dem til i Systemindstillinger for at blive spurgt om opkald."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Pindrop deaktiviert. Aktivieren Sie sie in den Systemeinstellungen, um bei Anrufen gefragt zu werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ειδοποιήσεις είναι απενεργοποιημένες για το Pindrop. Ενεργοποιήστε τις στις Ρυθμίσεις συστήματος για να σας ρωτάμε για τις κλήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off for Pindrop. Turn them on in System Settings to be asked about calls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas para Pindrop. Actívalas en Ajustes del Sistema para que te pregunte por las llamadas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilmoitukset on poistettu käytöstä Pindropilta. Ota ne käyttöön Järjestelmäasetuksissa, jotta sinulta kysytään puheluista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour Pindrop. Activez-les dans les paramètres système pour qu'on vous propose d'enregistrer les appels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות מושבתות עבור Pindrop. הפעילו אותן בהגדרות מערכת כדי שנשאל אתכם על שיחות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop के लिए सूचनाएँ बंद हैं। कॉल के बारे में पूछे जाने के लिए उन्हें सिस्टम सेटिंग्स में चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az értesítések ki vannak kapcsolva a Pindrop számára. Kapcsolja be őket a Rendszerbeállításokban, hogy megkérdezzük a hívásokról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikasi dinonaktifkan untuk Pindrop. Aktifkan di Pengaturan Sistem agar Anda ditanya tentang panggilan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate per Pindrop. Attivale in Impostazioni di sistema per ricevere la richiesta sulle chiamate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop の通知はオフになっています。通話について確認するには、システム設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop의 알림이 꺼져 있습니다. 통화에 대해 물어보게 하려면 시스템 설정에서 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemberitahuan dimatikan untuk Pindrop. Hidupkannya dalam Tetapan Sistem supaya anda ditanya tentang panggilan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsler er slått av for Pindrop. Slå dem på i Systeminnstillinger for å bli spurt om samtaler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit voor Pindrop. Zet ze aan in Systeeminstellingen om gevraagd te worden over gesprekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia dla Pindrop są wyłączone. Włącz je w Ustawieniach systemowych, aby otrzymywać pytanie o rozmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas para o Pindrop. Ative-as nas configurações do sistema para ser perguntado sobre as chamadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificările sunt dezactivate pentru Pindrop. Activați-le în Setări sistem pentru a fi întrebat despre apeluri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления для Pindrop отключены. Включите их в настройках системы, чтобы получать вопрос о звонках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiser är avstängda för Pindrop. Slå på dem i Systeminställningar för att bli tillfrågad om samtal."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนถูกปิดอยู่สำหรับ Pindrop เปิดในการตั้งค่าระบบเพื่อให้ระบบถามคุณเกี่ยวกับการโทร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop için bildirimler kapalı. Çağrılar için size sorulmasını istiyorsanız Sistem Ayarları'ndan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення для Pindrop вимкнено. Увімкніть їх у налаштуваннях системи, щоб отримувати запит про дзвінки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo đang tắt cho Pindrop. Bật trong cài đặt hệ thống để được hỏi về cuộc gọi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop 的通知已关闭。在系统设置中打开通知，以便通话时询问你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop 的通知已關閉。請在系統設定中開啟通知，以便通話時詢問你。"
          }
        }
      }
    },
