        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen versio, macOS-versio, laitteistotyyppi, mitä ominaisuuksia käytetään ja virhekategoriat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de l’app, version de macOS, type de matériel, fonctionnalités utilisées et catégories d’erreurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסת האפליקציה, גרסת macOS, סוג החומרה, אילו תכונות בשימוש וקטגוריות שגיאה."
