    "microphone_permission_is_required_to_continue": {
      "comment": "microphone_permission_is_required_to_continue",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن الميكروفون للمتابعة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যাওয়ার জন্য মাইক্রোফোনের অনুমতি প্রয়োজন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro pokračování je vyžadováno povolení k mikrofonu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofontilladelse er påkrævet for at fortsætte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonberechtigung ist erforderlich, um fortzufahren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται άδεια μικροφώνου για να συνεχίσετε"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone permission is required to continue"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso del micrófono para continuar"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkamiseen tarvitaan mikrofonin lupa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation du microphone est requise pour continuer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת הרשאת מיקרופון כדי להמשיך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए माइक्रोफ़ोन की अनुमति आवश्यक है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatáshoz mikrofonengedély szükséges"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin mikrofon diperlukan untuk melanjutkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per continuare è necessaria l'autorizzazione del microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行するにはマイクの許可が必要です"
