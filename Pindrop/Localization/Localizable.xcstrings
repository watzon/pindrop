      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غطينا زمن تأخر الإعداد ثم الأسعار وأخيرًا تاريخ الإطلاق في الثاني عشر من مايو"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা অনবোর্ডিং লেটেন্সি তারপর মূল্য এবং শেষে বারোই মে লঞ্চ তারিখ আলোচনা করেছি"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "probrali jsme latenci onboardingu pak ceny a nakonec datum spuštění dvanáctého května"
