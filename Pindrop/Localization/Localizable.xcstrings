    "a_big_round_of_upgrades_and_two_community_shout": {
      "comment": "a_big_round_of_upgrades_and_two_community_shout",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعة كبيرة من التحسينات — وشكران لمساهمين من المجتمع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বড় আপগ্রেডের এক দফা — আর কমিউনিটির দুইজনকে ধন্যবাদ।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
