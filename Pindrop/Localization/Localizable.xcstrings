    "transcript_so_far_pindrop_is_checking_it_against": {
      "comment": "Transcript so far. Pindrop is checking it against the recording.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص حتى الآن. يتحقق Pindrop منه مقابل التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন পর্যন্ত প্রতিলিপি। Pindrop এটি রেকর্ডিংয়ের সঙ্গে মিলিয়ে দেখছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosavadní přepis. Pindrop ho porovnává s nahrávkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udskriften indtil nu. Pindrop tjekker den mod optagelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisheriges Transkript. Pindrop gleicht es mit der Aufnahme ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απομαγνητοφώνηση μέχρι τώρα. Το Pindrop την ελέγχει με βάση την εγγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript so far. Pindrop is checking it against the recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripción hasta ahora. Pindrop la está comparando con la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tähänastinen tekstitys. Pindrop tarkistaa sen tallennetta vasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription jusqu’ici. Pindrop la compare à l’enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמליל עד כה. Pindrop בודק אותו מול ההקלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तक का प्रतिलेख। Pindrop इसे रिकॉर्डिंग से मिलाकर जाँच रहा है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eddigi átirat. A Pindrop összeveti a felvétellel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip sejauh ini. Pindrop sedang mencocokkannya dengan rekaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascrizione finora. Pindrop la sta confrontando con la registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでの文字起こしです。Pindrop が録音と照合しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지의 대본입니다. Pindrop이 녹음과 대조하고 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip setakat ini. Pindrop sedang menyemaknya dengan rakaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptet så langt. Pindrop sjekker det mot opptaket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcript tot nu toe. Pindrop controleert het aan de hand van de opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotychczasowa transkrypcja. Pindrop porównuje ją z nagraniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrição até agora. O Pindrop está conferindo com a gravação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrierea de până acum. Pindrop o verifică față de înregistrare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт на данный момент. Pindrop сверяет его с записью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptet hittills. Pindrop stämmer av det mot inspelningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความถอดเสียงจนถึงตอนนี้ Pindrop กำลังตรวจสอบกับการบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdiye kadarki deşifre. Pindrop bunu kayıtla karşılaştırıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт наразі. Pindrop звіряє його із записом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chép lời cho đến nay. Pindrop đang đối chiếu với bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的转录。Pindrop 正在与录音核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
