    "ai_enhancement_failed_streamed_text_kept_as_is": {
      "comment": "ai_enhancement_failed_streamed_text_kept_as_is",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحسين الذكاء الاصطناعي. تم الاحتفاظ بالنص المتدفق كما هو."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এআই এনহান্সমেন্ট ব্যর্থ হয়েছে। স্ট্রিম করা টেক্সট যেমন ছিল তেমনই রাখা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vylepšení AI se nezdařilo. Streamovaný text zůstal beze změny."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-forbedring mislykkedes. Streamet tekst blev bevaret uændret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Verbesserung fehlgeschlagen. Gestreamter Text wurde unverändert beibehalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βελτίωση AI απέτυχε. Το κείμενο ροής παρέμεινε ως έχει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI enhancement failed. Streamed text kept as-is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejora con IA falló. El texto transmitido se mantuvo tal cual."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekoälyn parannus epäonnistui. Striimattu teksti säilytettiin sellaisenaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'amélioration IA. Le texte diffusé en continu a été conservé tel quel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיפור ה-AI נכשל. הטקסט המוזרם נשמר כפי שהוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI एन्हांसमेंट विफल रहा। स्ट्रीम किया गया टेक्स्ट यथावत रखा गया।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az AI javítás sikertelen volt. A streamelt szöveg változatlanul megmaradt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peningkatan AI gagal. Teks yang di-streaming tetap dipertahankan apa adanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il miglioramento dell'IA non è riuscito. Il testo in streaming è stato mantenuto così com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI強化に失敗しました。ストリーミングされたテキストはそのまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 강화에 실패했습니다. 스트리밍된 텍스트는 그대로 유지되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peningkatan AI gagal. Teks strim dikekalkan seperti sedia ada."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-forbedring mislyktes. Strømmet tekst ble beholdt som den var."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-verbetering is mislukt. De gestreamde tekst is ongewijzigd behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulepszenie AI nie powiodło się. Tekst przesyłany strumieniowo pozostał niezmieniony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no aprimoramento de IA. O texto transmitido foi mantido como está."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îmbunătățirea AI a eșuat. Textul transmis a fost păstrat ca atare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшение ИИ не удалось. Потоковый текст оставлен как есть."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-förbättring misslyckades. Den strömmade texten behölls som den är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปรับปรุง AI ล้มเหลว ข้อความที่สตรีมไว้จะถูกเก็บไว้ตามเดิม"
