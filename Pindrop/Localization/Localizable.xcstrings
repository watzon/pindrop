    "no_speech_detected_try_speaking_closer_to_your": {
      "comment": "no_speech_detected_try_speaking_closer_to_your",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم اكتشاف أي كلام. حاول التحدث بالقرب من الميكروفون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো কথা শনাক্ত হয়নি। মাইক্রোফোনের কাছাকাছি কথা বলার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyla zjištěna žádná řeč. Zkuste mluvit blíž k mikrofonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tale registreret. Prøv at tale tættere på mikrofonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Sprache erkannt. Versuchen Sie, näher am Mikrofon zu sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν εντοπίστηκε ομιλία. Δοκιμάστε να μιλήσετε πιο κοντά στο μικρόφωνο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No speech detected. Try speaking closer to your microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detectó voz. Prueba a hablar más cerca del micrófono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhetta ei havaittu. Kokeile puhua lähempänä mikrofonia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune parole détectée. Essayez de parler plus près du microphone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא זוהה דיבור. נסה לדבר קרוב יותר למיקרופון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई आवाज़ नहीं मिली। कृपया अपने माइक्रोफ़ोन के करीब बोलने का प्रयास करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem érzékeltünk beszédet. Próbáljon közelebb beszélni a mikrofonjához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada suara yang terdeteksi. Coba bicara lebih dekat dengan mikrofon Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna voce rilevata. Prova a parlare più vicino al microfono."
          }
