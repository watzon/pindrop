    "u3_library_dictations_appear_after_use": {
      "comment": "u3_library_dictations_appear_after_use",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الإملاءات هنا بعد استخدام الإملاء الصوتي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভয়েস ডিকটেশনের পর এখানে দেখা যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktáty se zde objeví po hlasovém diktování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringer vises her efter stemmediktering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktate erscheinen hier nach der Spracherkennung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι υπαγορεύσεις εμφανίζονται εδώ μετά τη φωνή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictations appear here after you use voice dictation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dictados aparecen aquí tras usar la dictada por voz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktoinnit näkyvät täällä puhekirjoituksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dictées apparaissent ici après la reconnaissance vocale."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבות מופיעות כאן אחרי הכתבה קולית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस डिक्टेशन के बाद यहाँ दिखते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A diktálások a hangbevitel után itt jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte muncul di sini setelah dikte suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dettature appaiono qui dopo l’uso della voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ディクテーション後にここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 받아쓰기 후 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte muncul di sini selepas dikte suara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikteringer vises her etter stemmediktering."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictaten verschijnen hier na spraakinvoer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrania dyktowania pojawią się tutaj po rozpoczęciu korzystania z funkcji dyktowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ditações aparecem aqui após o uso da voz."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictările apar aici după dictarea vocală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовки появляются здесь после голосового ввода."
          }
        },
        "sv": {
