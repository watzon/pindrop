    "sources_are_fixed_when_the_recording_starts": {
      "comment": "Sources are fixed when the recording starts.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُثبَّت المصادر عند بدء التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং শুরু হলে উৎস স্থির হয়ে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdroje se určují při spuštění nahrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilderne låses, når optagelsen starter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quellen stehen beim Start der Aufnahme fest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πηγές καθορίζονται όταν ξεκινά η εγγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources are fixed when the recording starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes quedan fijadas cuando empieza la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähteet lukitaan, kun tallennus alkaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources sont fixées au démarrage de l'enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקורות נקבעים כשההקלטה מתחילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग शुरू होते ही स्रोत तय हो जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A források a felvétel indulásakor rögzülnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber ditetapkan saat rekaman dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sorgenti sono fissate all'avvio della registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音源は録音の開始時に決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스는 녹음이 시작될 때 정해집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber ditetapkan apabila rakaman bermula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kildene låses når opptaket starter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bronnen liggen vast zodra de opname start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródła są ustalane w chwili startu nagrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes são fixadas quando a gravação começa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sursele se fixează când începe înregistrarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источники фиксируются в начале записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Källorna låses när inspelningen startar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แหล่งเสียงถูกกำหนดเมื่อเริ่มบันทึก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynaklar kayıt başlarken sabitlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерела фіксуються на початку запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn được cố định khi bản ghi bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音开始时音源就已确定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音開始時音源就已確定。"
          }
        }
      }
    },
