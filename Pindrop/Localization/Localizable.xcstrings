    "u8_settings_some_shortcuts_conflict_each_other": {
      "comment": "u8_settings_some_shortcuts_conflict_each_other",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض الاختصارات تتعارض مع بعضها البعض."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু শর্টকাট একে অপরের সাথে দ্বন্দ্বে রয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Některé zkratky jsou ve vzájemném konfliktu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle genveje er i konflikt med hinanden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Kurzbefehle stehen im Konflikt zueinander."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορισμένες συντομεύσεις συγκρούονται μεταξύ τους."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some shortcuts conflict with each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos atajos entran en conflicto entre sí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkin pikanäppäimet ovat ristiriidassa keskenään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains raccourcis sont en conflit entre eux."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כמה קיצורי מקשים מתנגשים זה עם זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ शॉर्टकट एक-दूसरे से टकराते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Néhány billentyűparancs ütközik egymással."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa pintasan saling berkonflik."
          }
        },
        "it": {
