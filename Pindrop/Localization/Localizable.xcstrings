    "to_dictate_and_let_pindrop_transcribe_for_you": {
      "comment": "to_dictate_and_let_pindrop_transcribe_for_you",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للإملاء والسماح لـ Pindrop بالنسخ لك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্দেশ দিতে এবং আপনার জন্য Pindrop প্রতিলিপি করতে দেয়"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "diktovat a nechat Pindrop přepisovat za vás"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "at diktere og lade Pindrop transskribere for dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "zu diktieren und Pindrop für Sie transkribieren zu lassen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "να υπαγορεύσει και να αφήσει τον Πίντροπ να μεταγράψει για εσάς"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "to dictate and let Pindrop transcribe for you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "para dictar y dejar que Pindrop transcriba por ti"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "sanella ja antaa Pindropin litteroida puolestasi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "pour dicter et laisser Pindrop transcrire pour vous"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להכתיב ולתת לפינדרופ לתמלל עבורך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्देशित करने के लिए और पिनड्रॉप को आपके लिए लिखने की अनुमति देने के लिए"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "diktálni, és hagyni, hogy Pindrop átírja helyetted"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "untuk mendiktekan dan membiarkan Pindrop menuliskannya untuk Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "per dettare e lasciare che Pindrop trascriva per te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop に口述して文字起こししてもらう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop이 당신을 위해 받아쓰기하고 받아쓰기하도록 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "untuk menentukan dan biarkan Pindrop menyalin untuk anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "å diktere og la Pindrop transkribere for deg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "om te dicteren en Pindrop voor u te laten transcriberen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dyktować i pozwolić Pindropowi na transkrypcję"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "para ditar e deixar o Pindrop transcrever para você"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "să dicteze și să-l lase pe Pindrop să transpună pentru tine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "диктовать и позволить Pindrop расшифровывать для вас"
