    "u8_settings_no_conflicts_with_system_or_app": {
      "comment": "u8_settings_no_conflicts_with_system_or_app",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تعارضات مع اختصارات النظام أو التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম বা অ্যাপ শর্টকাটের সাথে কোনো দ্বন্দ্ব নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné konflikty se systémovými nebo aplikačními zkratkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konflikter med system- eller appgenveje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Konflikte mit System- oder App-Kurzbefehlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία σύγκρουση με συντομεύσεις συστήματος ή εφαρμογής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No conflicts with system or app shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conflictos con atajos del sistema o de la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ristiriitoja järjestelmän tai sovellusten pikanäppäinten kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun conflit avec les raccourcis système ou de l’app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין קונפליקטים עם קיצורי מקשים של המערכת או האפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम या ऐप शॉर्टकट के साथ कोई विरोध नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs ütközés a rendszer- vagy alkalmazás-billentyűparancsokkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada konflik dengan pintasan sistem atau aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conflitto con le scorciatoie di sistema o dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムまたはアプリのショートカットとの競合はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 또는 앱 단축키와 충돌하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada konflik dengan pintasan sistem atau aplikasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konflikter med system- eller appsnarveier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen conflicten met systeem- of appsneltoetsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak konfliktów ze skrótami systemowymi lub aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum conflito com atalhos do sistema ou de aplicativos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există conflicte cu comenzile rapide de sistem sau ale aplicației."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет конфликтов с сочетаниями клавиш системы или приложения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga konflikter med system- eller appgenvägar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีความขัดแย้งกับปุ่มลัดของระบบหรือแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem veya uygulama kısayollarıyla çakışma yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає конфліктів із комбінаціями клавіш системи або додатка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có xung đột với phím tắt hệ thống hoặc ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与系统或应用快捷键无冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與系統或應用快捷鍵無衝突。"
          }
        }
      }
    },
