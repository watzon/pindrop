          "stringUnit": {
            "state": "translated",
            "value": "Tätä mallia ei voitu lukea. Valitse toinen malli ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle n'a pas pu être lu. Choisissez un autre modèle et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לקרוא את התבנית הזאת. בחרו תבנית אחרת ונסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टेम्पलेट पढ़ा नहीं जा सका। दूसरा टेम्पलेट चुनें और दोबारा कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a sablont nem sikerült beolvasni. Válasszon másik sablont, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat ini tidak bisa dibaca. Pilih templat lain lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere questo modello. Scegli un altro modello e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテンプレートを読み込めませんでした。別のテンプレートを選んで、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 템플릿을 읽지 못했습니다. 다른 템플릿을 골라 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat ini tidak dapat dibaca. Pilih templat lain dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne malen kunne ikke leses. Velg en annen mal og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit sjabloon kon niet worden gelezen. Kies een ander sjabloon en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego szablonu. Wybierz inny szablon i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler este modelo. Escolha outro modelo e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest șablon nu a putut fi citit. Alegeți alt șablon și încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать этот шаблон. Выберите другой шаблон и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här mallen kunde inte läsas. Välj en annan mall och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านเทมเพลตนี้ไม่ได้ เลือกเทมเพลตอื่นแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şablon okunamadı. Başka bir şablon seçin ve tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати цей шаблон. Виберіть інший шаблон і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được mẫu này. Chọn mẫu khác rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这个模板。请换一个模板后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這個範本。請換一個範本後重試。"
          }
        }
      }
    },
