          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz Nemotron (z interpunkcją, model do pobrania) albo Apple SpeechTranscriber (macOS 26+, dostarczany z systemem)."
          }
        },
        "pt-BR": {
          "stringUnit": {
