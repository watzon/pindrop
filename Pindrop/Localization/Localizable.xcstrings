    "pindrop_can_send_anonymous_privacy_preserving_si": {
      "comment": "pindrop_can_send_anonymous_privacy_preserving_si",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Pindrop إرسال إشارات مجهولة تحافظ على الخصوصية حتى تُصلَح الأخطاء بشكل أسرع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop বেনামী, গোপনীয়তা-রক্ষাকারী সিগন্যাল পাঠাতে পারে যাতে বাগ দ্রুত ঠিক হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop může odesílat anonymní signály chránící soukromí, aby se chyby opravovaly rychleji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kan sende anonyme, privatlivsbevarende signaler, så fejl rettes hurtigere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kann anonyme, datenschutzfreundliche Signale senden, damit Fehler schneller behoben werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pindrop μπορεί να στέλνει ανώνυμα σήματα που προστατεύουν το απόρρητο, ώστε τα σφάλματα να διορθώνονται πιο γρήγορα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop can send anonymous, privacy-preserving signals so bugs get fixed faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop puede enviar señales anónimas que respetan tu privacidad para que los errores se corrijan más rápido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop voi lähettää anonyymejä, yksityisyyttä suojaavia signaaleja, jotta virheet korjataan nopeammin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop peut envoyer des signaux anonymes et respectueux de la vie privée pour corriger les bugs plus vite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop יכול לשלוח אותות אנונימיים ששומרים על הפרטיות כדי שבאגים יתוקנו מהר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop गुमनाम, गोपनीयता-संरक्षी सिग्नल भेज सकता है ताकि बग तेज़ी से ठीक हों।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pindrop névtelen, adatvédelmet tiszteletben tartó jelzéseket küldhet, hogy a hibák gyorsabban elháruljanak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop dapat mengirim sinyal anonim yang menjaga privasi agar bug diperbaiki lebih cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop può inviare segnali anonimi e rispettosi della privacy per correggere i bug più velocemente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop は、バグをより早く修正できるよう、匿名かつプライバシーを保護するシグナルを送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop은 버그를 더 빨리 고칠 수 있도록 익명의 개인정보 보호 신호를 보낼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop boleh menghantar isyarat tanpa nama yang melindungi privasi supaya pepijat diperbaiki dengan lebih cepat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kan sende anonyme, personvernbevarende signaler slik at feil rettes raskere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kan anonieme, privacyvriendelijke signalen versturen zodat bugs sneller worden opgelost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop może wysyłać anonimowe sygnały chroniące prywatność, aby błędy były naprawiane szybciej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pindrop pode enviar sinais anônimos que preservam a privacidade para que os bugs sejam corrigidos mais rápido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop poate trimite semnale anonime, care protejează confidențialitatea, pentru ca erorile să fie remediate mai rapid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop может отправлять анонимные сигналы, не раскрывающие личные данные, чтобы ошибки исправлялись быстрее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kan skicka anonyma, integritetsbevarande signaler så att buggar åtgärdas snabbare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop สามารถส่งสัญญาณแบบไม่ระบุตัวตนที่ปกป้องความเป็นส่วนตัว เพื่อให้แก้ไขข้อบกพร่องได้เร็วขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop, hataların daha hızlı düzeltilmesi için anonim, gizliliği koruyan sinyaller gönderebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop може надсилати анонімні сигнали, що зберігають конфіденційність, щоб помилки виправлялися швидше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop có thể gửi các tín hiệu ẩn danh, bảo vệ quyền riêng tư để lỗi được sửa nhanh hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop 可以发送匿名且保护隐私的信号，以便更快修复错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop 可傳送匿名且保護隱私的訊號，以便更快修正錯誤。"
          }
        }
      }
    },
    "pindrop_checks_the_speakers_again_when_the_recor": {
      "comment": "Pindrop checks the speakers again when the recording ends.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق Pindrop من المتحدثين مرة أخرى عند انتهاء التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রেকর্ডিং শেষ হলে Pindrop বক্তাদের আবার যাচাই করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po skončení nahrávání Pindrop mluvčí znovu ověří."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop tjekker talerne igen, når optagelsen slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop prüft die Sprecher erneut, wenn die Aufnahme endet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pindrop ελέγχει ξανά τους ομιλητές όταν τελειώσει η εγγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop checks the speakers again when the recording ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop revisa los oradores otra vez cuando termina la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop tarkistaa puhujat uudelleen, kun tallennus päättyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop revérifie les intervenants à la fin de l'enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop בודק את הדוברים שוב בסיום ההקלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग खत्म होने पर Pindrop वक्ताओं की फिर से जाँच करता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pindrop a felvétel végén újra ellenőrzi a beszélőket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop memeriksa lagi pembicara saat rekaman selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop ricontrolla i parlanti quando la registrazione finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が終わると Pindrop が話者をもう一度確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 끝나면 Pindrop이 화자를 다시 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop menyemak semula penutur apabila rakaman tamat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop sjekker talerne på nytt når opptaket slutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop controleert de sprekers opnieuw als de opname stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zakończeniu nagrania Pindrop ponownie sprawdza mówców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pindrop confere os falantes de novo quando a gravação termina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop verifică din nou vorbitorii când se termină înregistrarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда запись закончится, Pindrop проверит говорящих ещё раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kontrollerar talarna igen när inspelningen slutar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop จะตรวจผู้พูดอีกครั้งเมื่อการบันทึกสิ้นสุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt bitince Pindrop konuşmacıları yeniden denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли запис завершиться, Pindrop перевірить мовців ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kiểm tra lại người nói khi bản ghi kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音结束后，Pindrop 会重新核对说话人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音結束後，Pindrop 會重新核對說話者。"
          }
        }
      }
    },
    "pindrop_did_not_match_this_voice_to_a_saved_spea": {
      "comment": "Pindrop did not match this voice to a saved speaker, so there is no name to change yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتعرّف Pindrop على هذا الصوت كمتحدث محفوظ، لذا لا يوجد اسم لتغييره بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop এই কণ্ঠস্বরটিকে কোনো সংরক্ষিত বক্তার সাথে মেলাতে পারেনি, তাই এখনও পরিবর্তনের জন্য কোনো নাম নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop tento hlas nespároval se žádným uloženým mluvčím, takže zatím není žádné jméno ke změně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kunne ikke matche denne stemme med en gemt taler, så der er endnu intet navn at ændre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop konnte diese Stimme keinem gespeicherten Sprecher zuordnen, deshalb gibt es noch keinen Namen zum Ändern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pindrop δεν αντιστοίχισε αυτή τη φωνή με αποθηκευμένο ομιλητή, οπότε δεν υπάρχει ακόμη όνομα προς αλλαγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop did not match this voice to a saved speaker, so there is no name to change yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop no logró asociar esta voz con un interlocutor guardado, así que todavía no hay ningún nombre que cambiar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop ei yhdistänyt tätä ääntä tallennettuun puhujaan, joten muutettavaa nimeä ei vielä ole."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop n'a associé cette voix à aucun intervenant enregistré, il n'y a donc pas encore de nom à modifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop לא התאים את הקול הזה לדובר שמור, כך שאין עדיין שם לשנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop इस आवाज़ को किसी सहेजे गए वक्ता से नहीं मिला सका, इसलिए बदलने के लिए अभी कोई नाम नहीं है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pindrop nem tudta ezt a hangot egyetlen mentett beszélőhöz sem társítani, így egyelőre nincs átnevezhető név."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop tidak mencocokkan suara ini dengan pembicara tersimpan mana pun, jadi belum ada nama untuk diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop non ha associato questa voce a nessun interlocutore salvato, quindi non c'è ancora un nome da cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindropはこの声を保存済みの話者と一致させられなかったため、変更できる名前はまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop이 이 목소리를 저장된 화자와 일치시키지 못해 아직 변경할 이름이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop tidak dapat memadankan suara ini dengan mana-mana penutur tersimpan, jadi belum ada nama untuk ditukar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop klarte ikke å matche denne stemmen med en lagret taler, så det finnes ennå ikke noe navn å endre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kon deze stem niet koppelen aan een opgeslagen spreker, dus is er nog geen naam om te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop nie dopasował tego głosu do żadnego zapisanego mówcy, więc nie ma jeszcze nazwy do zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pindrop não conseguiu associar esta voz a nenhum interlocutor salvo, então ainda não há nome para alterar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop nu a putut asocia această voce cu niciun vorbitor salvat, deci nu există încă un nume de schimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop не смог сопоставить этот голос ни с одним сохранённым спикером, поэтому пока нет имени для изменения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kunde inte matcha den här rösten mot en sparad talare, så det finns inget namn att ändra ännu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop จับคู่เสียงนี้กับผู้พูดที่บันทึกไว้ไม่ได้ จึงยังไม่มีชื่อให้เปลี่ยน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop bu sesi kayıtlı bir konuşmacıyla eşleştiremedi, bu yüzden henüz değiştirilecek bir ad yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop не зміг зіставити цей голос із жодним збереженим спікером, тому поки немає імені для зміни."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop không khớp được giọng nói này với người nói đã lưu nào, nên chưa có tên để đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop 未能将这段声音匹配到任何已保存的发言人，因此目前没有可修改的名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop 未能將這段聲音比對到任何已儲存的發言人，因此目前沒有可修改的名稱。"
          }
        }
      }
    },
