        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели никогда не покидают этот Mac. Аудио обрабатывается локально, если вы не выберете облачный провайдер в Настройки → ИИ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeller lämnar aldrig den här Macen. Ljud bearbetas lokalt om du inte väljer en molnleverantör i Inställningar → AI."
