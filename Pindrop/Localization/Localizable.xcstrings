    "show_a_way_to_record_when_a_meeting_app_opens_yo": {
      "comment": "Show a way to record when a meeting app opens your microphone.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أظهر طريقة للتسجيل عندما يفتح تطبيق اجتماعات الميكروفون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো মিটিং অ্যাপ আপনার মাইক্রোফোন চালু করলে রেকর্ড করার উপায় দেখান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí možnost nahrávání, když aplikace pro schůzky zapne mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser en måde at optage på, når en mødeapp åbner din mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
