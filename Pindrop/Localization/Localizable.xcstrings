    "start_fresh_when_you_want_to_clear_preferences_o": {
      "comment": "start_fresh_when_you_want_to_clear_preferences_o",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ من جديد عندما تريد مسح التفضيلات وحالة الإعداد وبيانات الاعتماد المحفوظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যখন পছন্দগুলি, অনবোর্ডিং অবস্থা এবং সংরক্ষিত শংসাপত্রগুলি সাফ করতে চান তখন নতুন করে শুরু করুন৷"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začněte znovu, když chcete vymazat předvolby, stav registrace a uložené přihlašovací údaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start på en frisk, når du vil rydde præferencer, onboarding-tilstand og gemte legitimationsoplysninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie neu, wenn Sie Einstellungen, Onboarding-Status und gespeicherte Anmeldedaten löschen möchten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε από την αρχή όταν θέλετε να διαγράψετε τις προτιμήσεις, την κατάσταση ενσωμάτωσης και τα αποθηκευμένα διαπιστευτήρια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start fresh when you want to clear preferences, onboarding state, and saved credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Start fresh when you want to clear preferences, onboarding state, and saved credentials."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita alusta, kun haluat tyhjentää asetukset, aloitustilan ja tallennetut kirjautumistiedot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommencez à zéro lorsque vous voulez effacer les préférences, l'état d'intégration et les identifiants enregistrés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל מחדש כאשר אתה רוצה לנקות העדפות, מצב הצטרפות ואישורים שמורים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप प्राथमिकताएं, ऑनबोर्डिंग स्थिति और सहेजे गए क्रेडेंशियल साफ़ करना चाहते हैं तो नए सिरे से शुरुआत करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kezdje újra, ha törölni szeretné a beállításokat, a belépési állapotot és a mentett hitelesítő adatokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dari awal ketika Anda ingin menghapus preferensi, status orientasi, dan kredensial yang disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricomincia da capo quando desideri cancellare le preferenze, lo stato di onboarding e le credenziali salvate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定、オンボーディング状態、保存された認証情報をクリアする場合は、最初からやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 설정, 온보딩 상태 및 저장된 자격 증명을 지우려면 새로 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan baru apabila anda ingin mengosongkan pilihan, keadaan onboarding dan bukti kelayakan yang disimpan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynn på nytt når du vil slette preferanser, onboarding-status og lagret legitimasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin opnieuw als u voorkeuren, onboardingstatus en opgeslagen inloggegevens wilt wissen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od nowa, jeśli chcesz wyczyścić preferencje, stan procesu wprowadzającego i zapisane dane uwierzytelniające."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece do zero quando quiser limpar preferências, estado de integração e credenciais salvas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începeți din nou când doriți să ștergeți preferințele, starea de integrare și acreditările salvate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните заново, если хотите очистить настройки, состояние подключения и сохраненные учетные данные."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Börja på nytt när du vill rensa inställningar, introduktionsstatus och sparade autentiseringsuppgifter."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มต้นใหม่เมื่อคุณต้องการล้างการตั้งค่า สถานะการเริ่มต้นใช้งาน และข้อมูลรับรองที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercihleri, katılım durumunu ve kayıtlı kimlik bilgilerini temizlemek istediğinizde yeni bir başlangıç ​​yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть заново, коли захочете очистити налаштування, стан реєстрації та збережені облікові дані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu mới khi bạn muốn xóa tùy chọn, trạng thái giới thiệu và thông tin xác thực đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您想要清除首选项、引导状态和保存的凭证时重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您想要清除首選項、引導狀態和儲存的憑證時重新開始。"
          }
        }
      }
    },
    "start_in_the_menu_bar_without_opening_the_main_w": {
      "comment": "start_in_the_menu_bar_without_opening_the_main_w",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ في شريط القوائم دون فتح النافذة الرئيسية. ما زال بإمكانك فتحها من أيقونة شريط القوائم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল উইন্ডো না খুলে মেনু বারে শুরু করুন। মেনু বার আইকন থেকে পরেও খুলতে পারবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spustit v řádku nabídek bez otevření hlavního okna. Okno stále můžete otevřít z ikony v řádku nabídek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start i menulinjen uden at åbne hovedvinduet. Du kan stadig åbne det fra menulinjeikonet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Menüleiste starten, ohne das Hauptfenster zu öffnen. Sie können es weiterhin über das Menüleistensymbol öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έναρξη στη γραμμή μενού χωρίς άνοιγμα του κύριου παραθύρου. Μπορείτε να το ανοίξετε αργότερα από το εικονίδιο της γραμμής μενού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start in the menu bar without opening the main window. You can still open it from the menu bar icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia en la barra de menús sin abrir la ventana principal. Aún puedes abrirla desde el icono de la barra de menús."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistä valikkoriville avaamatta pääikkunaa. Voit silti avata sen valikkorivin kuvakkeesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer dans la barre de menus sans ouvrir la fenêtre principale. Vous pouvez toujours l’ouvrir depuis l’icône de la barre de menus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל בשורת התפריטים בלי לפתוח את החלון הראשי. עדיין אפשר לפתוח אותו מסמל שורת התפריטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य विंडो खोले बिना मेनू बार में शुरू करें। आप इसे मेनू बार आइकन से बाद में भी खोल सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítás a menüsorban a főablak megnyitása nélkül. Az ablakot továbbra is megnyithatja a menüsor ikonjáról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai di bilah menu tanpa membuka jendela utama. Anda masih dapat membukanya dari ikon bilah menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia nella barra dei menu senza aprire la finestra principale. Puoi comunque aprirla dall’icona della barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインウィンドウを開かずにメニューバーで起動します。メニューバーのアイコンから後で開くこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메인 창을 열지 않고 메뉴 막대에서 시작합니다. 메뉴 막대 아이콘으로 나중에 열 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula dalam bar menu tanpa membuka tetingkap utama. Anda masih boleh membukanya daripada ikon bar menu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start i menylinjen uten å åpne hovedvinduet. Du kan fortsatt åpne det fra menylinjeikonet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start in de menubalk zonder het hoofdvenster te openen. Je kunt het later nog openen via het menubalkpictogram."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom na pasku menu bez otwierania głównego okna. Nadal możesz je otworzyć z ikony na pasku menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie na barra de menus sem abrir a janela principal. Você ainda pode abri-la pelo ícone da barra de menus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește în bara de meniu fără a deschide fereastra principală. O poți deschide ulterior din pictograma barei de meniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать в строке меню, не открывая главное окно. Его по-прежнему можно открыть через значок в строке меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta i menyraden utan att öppna huvudfönstret. Du kan fortfarande öppna det från menyradsikonen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มในแถบเมนูโดยไม่เปิดหน้าต่างหลัก คุณยังสามารถเปิดได้จากไอคอนแถบเมนู"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana pencereyi açmadan menü çubuğunda başlat. Menü çubuğu simgesinden daha sonra da açabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускати в рядку меню, не відкриваючи головне вікно. Його й надалі можна відкрити з піктограми в рядку меню."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu trên thanh menu mà không mở cửa sổ chính. Bạn vẫn có thể mở nó từ biểu tượng thanh menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在菜单栏中启动且不打开主窗口。你仍可通过菜单栏图标打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選單列中啟動且不開啟主視窗。你仍可透過選單列圖示開啟它。"
          }
        }
      }
    },
