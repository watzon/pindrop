    "add_blank_lines_between_sentence_groups_in_longe": {
      "comment": "add_blank_lines_between_sentence_groups_in_longe",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف أسطرًا فارغة بين مجموعات الجمل في الإملاء الطويل. محلي بالكامل، بدون ذكاء اصطناعي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দীর্ঘ ডিকটেশনে বাক্যগোষ্ঠীর মাঝে ফাঁকা লাইন যোগ করে। সম্পূর্ণ স্থানীয়, AI ছাড়া।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá prázdné řádky mezi skupiny vět u delšího diktování. Plně lokálně, bez AI."
