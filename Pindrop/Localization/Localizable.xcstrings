    "the_audio_and_the_live_transcript_are_deleted_yo": {
      "comment": "The audio and the live transcript are deleted. Your typed notes stay.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحذف الصوت والنص المباشر. تبقى الملاحظات التي كتبتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অডিও আর লাইভ প্রতিলিপি মুছে যায়। আপনার টাইপ করা নোট থেকে যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvuk a živý přepis se smažou. Vaše napsané poznámky zůstanou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden og liveudskriften slettes. De noter, du har skrevet, bliver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio und das Live-Transkript werden gelöscht. Ihre getippten Notizen bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος και η ζωντανή απομαγνητοφώνηση διαγράφονται. Οι σημειώσεις που πληκτρολογήσατε μένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio and the live transcript are deleted. Your typed notes stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan el audio y la transcripción en vivo. Tus notas escritas se quedan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni ja reaaliaikainen tekstitys poistetaan. Kirjoittamasi muistiinpanot säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio et la transcription en direct sont supprimés. Vos notes saisies restent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האודיו והתמליל החי נמחקים. הפתקים שהקלדתם נשארים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो और लाइव प्रतिलेख हट जाते हैं। आपके टाइप किए नोट्स बने रहते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hang és az élő átirat törlődik. A begépelt jegyzetei megmaradnak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dan transkrip langsung dihapus. Catatan yang Anda ketik tetap ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio e la trascrizione dal vivo vengono eliminati. Le note che hai scritto restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声とライブ文字起こしを削除します。入力したメモは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오와 실시간 대본이 삭제됩니다. 직접 입력한 메모는 남습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dan transkrip langsung dipadam. Nota yang anda taip kekal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden og direktetranskriptet slettes. Notatene du skrev, blir værende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio en het live transcript worden verwijderd. Je getypte notities blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk i transkrypcja na żywo zostaną usunięte. Twoje wpisane notatki zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio e a transcrição ao vivo são excluídos. As notas que você digitou ficam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio și transcrierea în direct se șterg. Notițele scrise de dvs. rămân."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио и живой транскрипт будут удалены. Ваши набранные заметки останутся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet och livetranskriptet raderas. Dina skrivna anteckningar blir kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงและข้อความถอดเสียงสดจะถูกลบ โน้ตที่คุณพิมพ์ยังอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve canlı deşifre silinir. Yazdığınız notlar kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо та живий транскрипт буде видалено. Ваші набрані нотатки залишаться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh và bản chép lời trực tiếp sẽ bị xóa. Ghi chú bạn gõ vẫn còn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频和实时转录会被删除。你打的笔记会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊和即時逐字稿會被刪除。你打的筆記會保留。"
          }
        }
      }
    },
    "the_enhanced_note_could_not_be_generated_try_aga": {
      "comment": "The enhanced note could not be generated. Try again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إنشاء الملاحظة المعززة. حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উন্নত নোট তৈরি করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vylepšenou poznámku se nepodařilo vytvořit. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forbedrede note kunne ikke laves. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verbesserte Notiz konnte nicht erzeugt werden. Versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βελτιωμένη σημείωση δεν δημιουργήθηκε. Δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enhanced note could not be generated. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo generar la nota mejorada. Vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parannettua muistiinpanoa ei voitu luoda. Yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note améliorée n'a pas pu être générée. Réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה ליצור את הפתק המשופר. נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्नत नोट नहीं बन सका। दोबारा कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feljavított jegyzet nem készült el. Próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang disempurnakan tidak bisa dibuat. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile generare la nota migliorata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強化メモを作成できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보강 메모를 만들지 못했습니다. 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota dipertingkat tidak dapat dijana. Cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det forbedrede notatet kunne ikke lages. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbeterde notitie kon niet worden gemaakt. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć ulepszonej notatki. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gerar a nota aprimorada. Tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița îmbunătățită nu a putut fi generată. Încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать улучшенную заметку. Попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den förbättrade anteckningen kunde inte skapas. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างโน้ตที่ปรับปรุงแล้วไม่ได้ ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirilmiş not oluşturulamadı. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося створити покращену нотатку. Спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tạo được ghi chú nâng cao. Thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强笔记生成失败。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強筆記產生失敗。請重試。"
          }
        }
      }
    },
