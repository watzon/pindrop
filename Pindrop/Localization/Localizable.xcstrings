    "preset_example_clean_input": {
      "comment": "preset_example_clean_input",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اممم إذن الاجتماع في الثالثة والنصف نقطة هل يمكنك التأكيد علامة استفهام"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আম তাহলে মিটিং সাড়ে তিনটায় পিরিয়ড আপনি কি নিশ্চিত করতে পারেন প্রশ্নবোধক"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ehm takže schůzka je ve tři třicet tečka můžeš potvrdit otazník"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "øh så mødet er klokken halv fire punktum kan du bekræfte spørgsmålstegn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "äh also das meeting ist um halb vier punkt kannst du bestätigen fragezeichen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "εεε λοιπόν η συνάντηση είναι στις τρεισήμισι τελεία μπορείς να επιβεβαιώσεις ερωτηματικό"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "um so the meeting is at three thirty period can you confirm question mark"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "eh entonces la reunión es a las tres y media punto puedes confirmar signo de interrogación"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "öö eli kokous on puoli neljältä piste voitko vahvistaa kysymysmerkki"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "euh donc la réunion est à trois heures et demie point tu peux confirmer point d'interrogation"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אממ אז הפגישה בשלוש וחצי נקודה אפשר לאשר סימן שאלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अम तो मीटिंग साढ़े तीन बजे है पूर्ण विराम क्या आप पुष्टि कर सकते हैं प्रश्न चिह्न"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "öö szóval a megbeszélés fél négykor van pont meg tudod erősíteni kérdőjel"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "eh jadi rapat jam setengah empat titik bisakah kamu konfirmasi tanda tanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ehm quindi la riunione è alle tre e mezza punto puoi confermare punto interrogativo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "えっと 会議は三時半です ピリオド 確認できますか クエスチョンマーク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음 그래서 회의는 세 시 반이야 마침표 확인해 줄 수 있어 물음표"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "eh jadi mesyuarat pada pukul tiga setengah noktah bolehkah anda sahkan tanda soal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "øh så møtet er klokka halv fire punktum kan du bekrefte spørsmålstegn"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "eh dus de vergadering is om half vier punt kun je bevestigen vraagteken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "yyy więc spotkanie jest o wpół do czwartej kropka możesz potwierdzić znak zapytania"
