    "anonymous_diagnostics_and_usage_signals_never_tr": {
      "comment": "anonymous_diagnostics_and_usage_signals_never_tr",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشخيصات وإشارات استخدام مجهولة. لا يتضمن أبدًا نص النسخ أو الصوت أو المحتوى الشخصي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বেনামী ডায়াগনস্টিকস এবং ব্যবহারের সিগন্যাল। প্রতিলিপির টেক্সট, অডিও বা ব্যক্তিগত কনটেন্ট কখনও নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymní diagnostika a signály o používání. Nikdy text přepisů, zvuk ani osobní obsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonym diagnostik og brugssignaler. Aldrig transskriptionstekst, lyd eller personligt indhold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Diagnose- und Nutzungssignale. Niemals Transkripttext, Audio oder persönliche Inhalte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανώνυμα διαγνωστικά και σήματα χρήσης. Ποτέ κείμενο μεταγραφής, ήχος ή προσωπικό περιεχόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous diagnostics and usage signals. Never transcript text, audio, or personal content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnósticos y señales de uso anónimos. Nunca el texto de las transcripciones, el audio ni el contenido personal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyymit diagnostiikka- ja käyttösignaalit. Ei koskaan transkriptiotekstiä, ääntä tai henkilökohtaista sisältöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics et signaux d’utilisation anonymes. Jamais le texte des transcriptions, l’audio ni le contenu personnel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אבחון ואותות שימוש אנונימיים. לעולם לא טקסט תמלול, אודיו או תוכן אישי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुमनाम डायग्नोस्टिक्स और उपयोग सिग्नल। ट्रांसक्रिप्ट टेक्स्ट, ऑडियो या व्यक्तिगत सामग्री कभी नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Névtelen diagnosztikai és használati jelzések. Soha nem átirat szövege, hang vagy személyes tartalom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostik dan sinyal penggunaan anonim. Tidak pernah teks transkripsi, audio, atau konten pribadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostica e segnali di utilizzo anonimi. Mai il testo delle trascrizioni, l’audio o contenuti personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名の診断および使用状況シグナル。文字起こしのテキスト、音声、個人的な内容は一切含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 진단 및 사용 신호. 전사 텍스트, 오디오, 개인 콘텐츠는 절대 포함하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostik dan isyarat penggunaan tanpa nama. Tidak sekali-kali teks transkripsi, audio, atau kandungan peribadi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonym diagnostikk og brukssignaler. Aldri transkripsjonstekst, lyd eller personlig innhold."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonieme diagnostiek en gebruikssignalen. Nooit transcriptietekst, audio of persoonlijke inhoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimowa diagnostyka i sygnały użycia. Nigdy tekst transkrypcji, dźwięk ani treści osobiste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnósticos e sinais de uso anônimos. Nunca o texto das transcrições, o áudio ou conteúdo pessoal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosticare și semnale de utilizare anonime. Niciodată textul transcrierilor, audio sau conținut personal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимная диагностика и сигналы об использовании. Никогда — текст транскрипций, аудио или личный контент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonym diagnostik och användningssignaler. Aldrig transkriptionstext, ljud eller personligt innehåll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวินิจฉัยและสัญญาณการใช้งานแบบไม่ระบุตัวตน ไม่มีข้อความถอดเสียง เสียง หรือเนื้อหาส่วนบุคคลเลย"
