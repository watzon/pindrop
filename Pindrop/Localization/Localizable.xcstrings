    "local_models_stay_on_this_mac_cloud_transcriptio": {
      "comment": "Local models stay on this Mac. Cloud transcription sends recorded audio to the provider you choose.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى النماذج المحلية على هذا Mac. يرسل النسخ السحابي الصوت المسجّل إلى الموفر الذي تختاره."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোকাল মডেলগুলো এই Mac-এই থাকে। ক্লাউড ট্রান্সক্রিপশন রেকর্ড করা অডিও আপনার বেছে নেওয়া প্রদানকারীর কাছে পাঠায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní modely zůstávají na tomto Macu. Cloudový přepis odesílá nahraný zvuk poskytovateli, kterého zvolíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale modeller forbliver på denne Mac. Cloud-transskription sender optaget lyd til den udbyder, du vælger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Modelle bleiben auf diesem Mac. Cloud-Transkription sendet aufgezeichnetes Audio an den von dir gewählten Anbieter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα τοπικά μοντέλα παραμένουν σε αυτό το Mac. Η μεταγραφή cloud στέλνει το ηχογραφημένο αρχείο ήχου στον πάροχο που επιλέγετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local models stay on this Mac. Cloud transcription sends recorded audio to the provider you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos locales permanecen en este Mac. La transcripción en la nube envía el audio grabado al proveedor que elijas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikalliset mallit pysyvät tällä Macilla. Pilvitranskriptio lähettää tallennetun äänen valitsemallesi palveluntarjoajalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles locaux restent sur ce Mac. La transcription cloud envoie l’audio enregistré au fournisseur de votre choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודלים מקומיים נשארים ב-Mac הזה. תמלול בענן שולח את השמע המוקלט לספק שתבחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल मॉडल इसी Mac पर रहते हैं। क्लाउड ट्रांसक्रिप्शन रिकॉर्ड किया गया ऑडियो आपके चुने हुए प्रदाता को भेजता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyi modellek ezen a Macen maradnak. A felhőalapú átírás a rögzített hangot a választott szolgáltatónak küldi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model lokal tetap di Mac ini. Transkripsi cloud mengirim audio yang direkam ke penyedia yang Anda pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli locali restano su questo Mac. La trascrizione cloud invia l’audio registrato al provider che scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルはこのMacに留まります。クラウド文字起こしは録音した音声を選択したプロバイダに送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델은 이 Mac에 유지됩니다. 클라우드 받아쓰기는 녹음된 오디오를 선택한 제공업체로 보냅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model setempat kekal pada Mac ini. Transkripsi awan menghantar audio dirakam kepada penyedia yang anda pilih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale modeller blir på denne Mac-en. Skytranskripsjon sender innspilt lyd til leverandøren du velger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale modellen blijven op deze Mac. Cloudtranscriptie stuurt opgenomen audio naar de provider die je kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele lokalne pozostają na tym Macu. Transkrypcja w chmurze wysyła nagrane audio do wybranego dostawcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos locais permanecem neste Mac. A transcrição na nuvem envia o áudio gravado para o provedor que você escolher."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelele locale rămân pe acest Mac. Transcrierea în cloud trimite audio-ul înregistrat către furnizorul pe care îl alegi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные модели остаются на этом Mac. Облачная транскрипция отправляет записанное аудио выбранному вами провайдеру."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokala modeller stannar på denna Mac. Molntranskription skickar inspelat ljud till den leverantör du väljer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลในเครื่องจะอยู่บน Mac เครื่องนี้ การถอดเสียงบนคลาวด์จะส่งเสียงที่บันทึกไปยังผู้ให้บริการที่คุณเลือก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel modeller bu Mac’te kalır. Bulut yazıya dökme, kaydedilen sesi seçtiğiniz sağlayıcıya gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальні моделі залишаються на цьому Mac. Хмарна транскрипція надсилає записане аудіо вибраному вами провайдеру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mô hình cục bộ ở lại trên Mac này. Phiên âm đám mây gửi âm thanh đã ghi tới nhà cung cấp bạn chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型保留在此 Mac 上。云端转录会将录制的音频发送至你选择的提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機模型會保留在此 Mac 上。雲端轉錄會將錄製的音訊傳送至你選擇的提供商。"
          }
        }
      }
    },
    "local_speech_to_text_right_from_your_menu_bar_fa": {
      "comment": "local_speech_to_text_right_from_your_menu_bar_fa",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويل الكلام المحلي إلى نص، مباشرة من شريط القائمة.\nسريع وخاص ومتاح دائمًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মেনু বার থেকে স্থানীয় স্পিচ-টু-টেক্সট।\n\nদ্রুত, ব্যক্তিগত, এবং সর্বদা উপলব্ধ।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní převod řeči na text přímo z panelu nabídek.\nRychlé, soukromé a vždy dostupné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal tale-til-tekst, direkte fra din menulinje.\nHurtig, privat og altid tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Spracherkennung direkt aus Ihrer Menüleiste.\nSchnell, privat und immer verfügbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τοπική ομιλία σε κείμενο, απευθείας από τη γραμμή μενού σας.\nΓρήγορη, ιδιωτική και πάντα διαθέσιμη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local speech-to-text, right from your menu bar.\nFast, private, and always available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz a texto local, directamente desde tu barra de menús.\nRápido, privado y siempre disponible."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paikallinen puhe tekstiksi, suoraan valikkopalkistasi.\nNopea, yksityinen ja aina saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaissance vocale locale, directement depuis votre barre de menus.\nRapide, privé et toujours disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיבור מקומי לטקסט, ישירות משורת התפריטים שלך.\nמהיר, פרטי וזמין תמיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय वाक्-से-पाठ, सीधे आपके मेनू बार से।\nतेज़, निजी और हमेशा उपलब्ध।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyi beszéd-szöveg, közvetlenül a menüsorból.\nGyors, privát és mindig elérhető."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ucapan lokal-ke-teks, langsung dari bilah menu Anda.\nCepat, pribadi, dan selalu tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sintesi vocale locale, direttamente dalla barra dei menu.\nVeloce, riservato e sempre disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの音声テキスト変換をメニュー バーから直接実行できます。\n高速、プライベート、いつでも利用可能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 표시줄에서 바로 로컬 음성을 텍스트로 변환하세요.\n빠르고, 비공개이며, 항상 사용 가능합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertuturan ke teks setempat, terus dari bar menu anda.\nCepat, peribadi dan sentiasa tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal tale-til-tekst, rett fra menylinjen.\nRask, privat og alltid tilgjengelig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale spraak-naar-tekst, rechtstreeks vanuit uw menubalk.\nSnel, privé en altijd beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna zamiana mowy na tekst bezpośrednio z paska menu.\nSzybka, prywatna i zawsze dostępna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversão local de fala para texto, diretamente na barra de menu.\nRápido, privado e sempre disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversie vocală locală în text, direct din bara de meniu.\nRapid, privat și întotdeauna disponibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальное преобразование речи в текст прямо из строки меню.\nБыстро, конфиденциально и всегда доступно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalt tal-till-text, direkt från din menyrad.\nSnabbt, privat och alltid tillgängligt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงพูดเป็นข้อความท้องถิ่นจากแถบเมนูของคุณ\nรวดเร็ว เป็นส่วนตัว และพร้อมให้บริการตลอดเวลา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan menü çubuğunuzdan yerel konuşmayı metne dönüştürme.\nHızlı, özel ve her zaman ulaşılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцеве перетворення мовлення в текст прямо з панелі меню.\nШвидко, приватно та завжди доступно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển lời nói thành văn bản cục bộ, ngay từ thanh menu của bạn.\nNhanh chóng, riêng tư và luôn có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接从菜单栏进行本地语音转文本。\n快速、私密且始终可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從選單欄進行本地語音轉文字。\n快速、私密且始終可用。"
          }
        }
      }
    },
