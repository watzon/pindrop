    "change_your_choice_anytime_in_settings_privacy": {
      "comment": "change_your_choice_anytime_in_settings_privacy",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر اختيارك في أي وقت من الإعدادات → الخصوصية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস → গোপনীয়তা-তে যেকোনো সময় আপনার পছন্দ পরিবর্তন করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svou volbu můžete kdykoli změnit v Nastavení → Soukromí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift dit valg når som helst i Indstillinger → Anonymitet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere deine Wahl jederzeit unter Einstellungen → Datenschutz."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αλλάξτε την επιλογή σας ανά πάσα στιγμή στις Ρυθμίσεις → Απόρρητο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change your choice anytime in Settings → Privacy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia tu elección cuando quieras en Ajustes → Privacidad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuta valintasi milloin tahansa kohdassa Asetukset → Tietosuoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez votre choix à tout moment dans Paramètres → Confidentialité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שנה את הבחירה שלך בכל עת בהגדרות → פרטיות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स → गोपनीयता में कभी भी अपना चयन बदलें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Módosítsd a döntésed bármikor itt: Beállítások → Adatvédelem."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah pilihan Anda kapan saja di Pengaturan → Privasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la tua scelta in qualsiasi momento in Impostazioni → Privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → プライバシー でいつでも選択を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 개인정보 보호에서 언제든지 선택을 변경할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar pilihan anda pada bila-bila masa dalam Tetapan → Privasi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endre valget ditt når som helst i Innstillinger → Personvern."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig je keuze op elk moment in Instellingen → Privacy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień swój wybór w dowolnym momencie w Ustawienia → Prywatność."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere sua escolha quando quiser em Configurações → Privacidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbă-ți alegerea oricând în Setări → Confidențialitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените свой выбор в любой момент в Настройки → Конфиденциальность."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändra ditt val när som helst i Inställningar → Integritet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนตัวเลือกของคุณได้ทุกเมื่อใน การตั้งค่า → ความเป็นส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçiminizi istediğiniz zaman Ayarlar → Gizlilik bölümünden değiştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть свій вибір будь-коли в Налаштування → Конфіденційність."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi lựa chọn của bạn bất cứ lúc nào trong Cài đặt → Quyền riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可在设置 → 隐私中更改你的选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可在設定 → 隱私權中更改你的選擇。"
          }
        }
      }
    },
