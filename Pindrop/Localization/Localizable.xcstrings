        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her talte en anden. Den færdige note har det med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier hat jemand anderes gesprochen. Die fertige Notiz enthält es."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εδώ μίλησε κάποιος άλλος. Η τελική σημείωση το περιλαμβάνει."
