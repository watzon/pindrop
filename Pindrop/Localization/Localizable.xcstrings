    "pillars_meeting_description": {
      "comment": "Record microphone and system audio, then keep the meeting in Library.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل صوت الميكروفون وصوت النظام، ثم احتفظ بالاجتماع في المكتبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মাইক্রোফোন ও সিস্টেমের অডিও রেকর্ড করুন, তারপর মিটিংটি লাইব্রেরিতে রেখে দিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrajte zvuk mikrofonu i systému a poté schůzku uchovejte v Knihovně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag mikrofon- og systemlyd, og gem derefter mødet i Bibliotek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nehmen Sie Mikrofon- und Systemaudio auf und bewahren Sie die Besprechung anschließend in der Bibliothek auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ηχογραφήστε τον ήχο του μικροφώνου και του συστήματος και κρατήστε τη σύσκεψη στη Βιβλιοθήκη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record microphone and system audio, then keep the meeting in Library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba el audio del micrófono y del sistema, y guarda después la reunión en la Biblioteca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna mikrofonin ja järjestelmän ääni ja säilytä sitten kokous kirjastossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le son du micro et du système, puis conservez la réunion dans la Bibliothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלט את שמע המיקרופון והמערכת, ואז שמור את הפגישה בספרייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन और सिस्टम ऑडियो रिकॉर्ड करें, फिर मीटिंग को लाइब्रेरी में रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsd a mikrofon és a rendszer hangját, majd tartsd meg az értekezletet a Könyvtárban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam audio mikrofon dan sistem, lalu simpan rapat di Pustaka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra l’audio del microfono e del sistema, poi conserva la riunione nella Libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクとシステム音声を録音し、ミーティングをライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크와 시스템 오디오를 녹음한 후 회의를 라이브러리에 보관하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakam audio mikrofon dan sistem, kemudian simpan mesyuarat dalam Pustaka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp mikrofon- og systemlyd, og behold møtet i Bibliotek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem microfoon- en systeemaudio op en bewaar de vergadering in de bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj dźwięk z mikrofonu i systemu, a następnie zachowaj spotkanie w Bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave o áudio do microfone e do sistema e mantenha a reunião na Biblioteca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează sunetul microfonului și al sistemului, apoi păstrează întâlnirea în Bibliotecă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте звук с микрофона и системы, а затем сохраняйте встречу в Библиотеке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in mikrofonens och systemets ljud och spara sedan mötet i Bibliotek."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเสียงจากไมโครโฟนและระบบ แล้วเก็บการประชุมไว้ในไลบรารี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon ve sistem sesini kaydedin, ardından toplantıyı Kitaplık'ta saklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте звук із мікрофона та системи, а потім збережіть зустріч у Бібліотеці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi âm thanh từ micrô và hệ thống, sau đó lưu cuộc họp vào Thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制麦克风和系统音频，然后将会议保存在资料库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製麥克風和系統音訊，然後將會議儲存在資料庫中。"
          }
        }
      }
    },
    "pillars_meetings_empty": {
      "comment": "pillars_meetings_empty",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر اجتماعاتك المسجلة هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রেকর্ড করা মিটিংগুলো এখানে দেখা যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše nahrané schůzky se zobrazí zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine optagne møder vises her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre aufgezeichneten Besprechungen werden hier angezeigt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ηχογραφημένες συναντήσεις σας θα εμφανίζονται εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recorded meetings will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reuniones grabadas aparecerán aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauhoitetut kokouksesi näkyvät tässä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réunions enregistrées apparaîtront ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפגישות שהקלטת יופיעו כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिकॉर्ड की गई मीटिंग यहाँ दिखेंगी।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A rögzített megbeszélései itt jelennek meg."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapat yang Anda rekam akan muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue riunioni registrate appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音したミーティングはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음된 회의가 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesyuarat yang dirakam akan dipaparkan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De innspilte møtene dine vises her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgenomen vergaderingen verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje nagrane spotkania pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas reuniões gravadas aparecerão aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întâlnirile tale înregistrate vor apărea aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записанные встречи появятся здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inspelade möten visas här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การประชุมที่บันทึกไว้ของคุณจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz toplantılar burada görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші записані зустрічі з'являться тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc họp đã ghi của bạn sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您录制的会议将显示在这里。"
          }
