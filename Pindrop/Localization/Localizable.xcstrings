            "value": "ダークモードを出荷したところだ。\\n\\nすごく良く見える — 試すべきだよ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 다크 모드를 출시했어.\\n\\n정말 멋져 보여 — 너도 써 봐야 해."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami baru sahaja hantar mod gelap.\\n\\nNampak hebat — anda patut cubanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har nettopp sluppet dark mode.\\n\\nDen ser fantastisk ut — du burde prøve den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben net dark mode uitgebracht.\\n\\nHet ziet er geweldig uit — je moet het proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Właśnie wydaliśmy tryb ciemny.\n\nWygląda niesamowicie — powinieneś spróbować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabamos de lançar o modo escuro.\\n\\nFicou incrível — você deveria experimentar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocmai am lansat dark mode.\\n\\nArată incredibil — ar trebui să îl încerci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы только что выпустили тёмный режим.\\n\\nОн выглядит потрясающе — тебе стоит попробовать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har precis släppt dark mode.\\n\\nDen ser fantastisk ut — du borde prova den."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราเพิ่งปล่อยโหมดมืด\\n\\nดูยอดเยี่ยมมาก — คุณควรลอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce karanlık modu yayınladık.\\n\\nHarika görünüyor — denemelisin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми щойно випустили темний режим.\\n\\nВін виглядає чудово — тобі варто спробувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi vừa ra mắt chế độ tối.\\n\\nTrông tuyệt vời — bạn nên thử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们刚发布了深色模式。\\n\\n看起来很棒 — 你应该试试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們剛發布了深色模式。\\n\\n看起來很棒 — 你應該試試。"
          }
        }
      }
    },
    "preset_example_technical_input": {
      "comment": "preset_example_technical_input",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استدع fetch user سهم ثم عيّن الاستجابة يساوي يساوي مئتين"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "fetch user কল করো তীর তারপর রেসপন্স সমান সমান দুইশো ম্যাপ করো"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "zavolej fetch user šipka pak namapuj odpověď rovná se rovná se dvě stě"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "kald fetch user pil map så svaret lig med lig med to hundrede"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "rufe fetch user pfeil dann mappe die antwort gleich gleich zweihundert"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "κάλεσε fetch user βέλος μετά χάρταξε την απάντηση ίσον ίσον διακόσια"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "call fetch user arrow then map the response equals equals two hundred"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "llama a fetch user flecha luego mapea la respuesta igual igual doscientos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "kutsu fetch user nuoli sitten mapaa vastaus yhtäsuuri yhtäsuuri kaksisataa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "appelle fetch user flèche puis mappe la réponse égal égal deux cents"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קרא ל-fetch user חץ ואז מפה את התשובה שווה שווה מאתיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "fetch user कॉल करो तीर फिर प्रतिक्रिया को बराबर बराबर दो सौ मैप करो"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "hívd a fetch user nyíl aztán mapeld a választ egyenlő egyenlő kettőszáz"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "panggil fetch user panah lalu peta respons sama dengan sama dengan dua ratus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "chiama fetch user freccia poi mappa la risposta uguale uguale duecento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "fetch user を呼んで 矢印 それからレスポンスを イコール イコール 二百にマップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "fetch user 호출 화살표 그다음 응답을 등호 등호 이백으로 매핑"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "panggil fetch user anak panah kemudian peta respons sama sama dua ratus"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "kall fetch user pil map så svaret lik lik to hundre"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "roep fetch user pijl aan map dan de response is gelijk aan tweehonderd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "wywołaj fetch user strzałka potem zmapuj odpowiedź równa się równa się dwieście"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "chame fetch user seta depois mapeie a resposta igual igual duzentos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "apelează fetch user săgeată apoi mapează răspunsul egal egal două sute"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "вызови fetch user стрелка затем сопоставь ответ равно равно двести"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "anropa fetch user pil mappa sedan svaret lika med lika med tvåhundra"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียก fetch user ลูกศร แล้วแม็ปการตอบกลับ เท่ากับ เท่ากับ สองร้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "fetch user çağır ok sonra yanıtı eşittir eşittir iki yüz olarak eşle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "викликай fetch user стрілка потім зістав відповідь дорівнює дорівнює двісті"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "gọi fetch user mũi tên rồi ánh xạ phản hồi bằng bằng hai trăm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调用 fetch user 箭头 然后把响应 等于 等于 二百 做映射"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "呼叫 fetch user 箭頭 然後把回應 等於 等於 二百 做對應"
          }
        }
      }
    },
