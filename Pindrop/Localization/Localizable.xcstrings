            "value": "Viene visualizzato accanto al campo di testo/accento circonflesso evidenziato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカスされたテキストフィールド/キャレットの横に表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초점이 맞춰진 텍스트 필드/캐럿 옆에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan di sebelah medan teks fokus/karet"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises ved siden av det fokuserte tekstfeltet/karetten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt weergegeven naast het gefocuste tekstveld/caret"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla się obok aktywnego pola tekstowego/karetki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ao lado do campo de texto/acento circunflexo em foco"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se afișează lângă câmpul de text focalizat/marca de simbol"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает рядом с выделенным текстовым полем/кареткой"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas bredvid det fokuserade textfältet/careten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงข้างช่องข้อความ/คาเร็ตที่โฟกัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaklanılan metin alanının/işaret işaretinin yanında gösterilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відображається поруч із виділеним текстовим полем/кареткою"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị bên cạnh trường văn bản/dấu mũ tập trung"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在聚焦的文本字段/光标旁边"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在聚焦的文字欄位/游標旁邊"
