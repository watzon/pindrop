    "click_new_note_to_start_one": {
      "comment": "Click New note to start one. Pindrop records while you type.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر ملاحظة جديدة للبدء. يسجّل Pindrop أثناء كتابتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে নতুন নোট-এ ক্লিক করুন। আপনি টাইপ করার সময় Pindrop রেকর্ড করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikněte na Nová poznámka a začněte. Pindrop nahrává, zatímco píšete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på Ny note for at starte en. Pindrop optager, mens du skriver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf Neue Notiz, um eine zu beginnen. Pindrop nimmt auf, während Sie tippen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο Νέα σημείωση για να ξεκινήσετε. Το Pindrop ηχογραφεί όσο πληκτρολογείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click New note to start one. Pindrop records while you type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Nueva nota para empezar una. Pindrop graba mientras escribes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita napsauttamalla Uusi muistiinpano. Pindrop tallentaa samalla, kun kirjoitat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Nouvelle note pour en commencer une. Pindrop enregistre pendant que vous tapez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו על פתק חדש כדי להתחיל. Pindrop מקליט בזמן שאתם מקלידים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए नया नोट पर क्लिक करें। आप टाइप करते रहें, Pindrop रिकॉर्ड करता रहेगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson az Új jegyzet gombra a kezdéshez. A Pindrop rögzít, miközben Ön gépel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik Catatan baru untuk memulai. Pindrop merekam sementara Anda mengetik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Nuova nota per iniziarne una. Pindrop registra mentre scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新しいメモ」をクリックして始めます。入力している間も Pindrop が録音します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 메모를 클릭해 시작하세요. 입력하는 동안 Pindrop이 녹음합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
