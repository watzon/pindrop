    "preset_example_meeting_input": {
      "comment": "preset_example_meeting_input",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أليس سترسل العرض بحلول الجمعة بوب يتولى مراجعة الأسعار نحتاج قرارًا الأسبوع القادم"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যালিস শুক্রবারের মধ্যে ডেক পাঠাবে বব মূল্য পর্যালোচনা দেখবে আগামী সপ্তাহে সিদ্ধান্ত দরকার"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "alice pošle deck do pátku bob má na starosti kontrolu cen potřebujeme rozhodnutí příští týden"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "alice sender decket inden fredag bob tager prisgennemgangen vi har brug for en beslutning i næste uge"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "alice schickt das deck bis freitag bob übernimmt die preisprüfung wir brauchen nächste woche eine entscheidung"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "η alice θα στείλει το deck μέχρι την παρασκευή ο bob αναλαμβάνει τον έλεγχο τιμών χρειαζόμαστε απόφαση την επόμενη εβδομάδα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "alice will send the deck by friday bob owns the pricing review we need a decision next week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "alice enviará la presentación el viernes bob se encarga de la revisión de precios necesitamos una decisión la próxima semana"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "alice lähettää dekin perjantaihin mennessä bob hoitaa hintatarkistuksen tarvitsemme päätöksen ensi viikolla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "alice enverra le support vendredi bob s'occupe de la revue des prix il nous faut une décision la semaine prochaine"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אליס תשלח את המצגת עד יום שישי בוב אחראי על בדיקת המחירים צריך החלטה בשבוע הבא"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐलिस शुक्रवार तक डेक भेजेगी बॉब कीमत की समीक्षा संभालेगा अगले सप्ताह निर्णय चाहिए"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "alice péntekig elküldi a decket bob intézi az árellenőrzést jövő héten döntés kell"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "alice akan kirim deck sampai jumat bob urus tinjauan harga kita butuh keputusan minggu depan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "alice invierà il deck entro venerdì bob si occupa della revisione dei prezzi ci serve una decisione la prossima settimana"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アリスが金曜までにデッキを送り ボブが価格レビューを担当 来週決断が必要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨리스가 금요일까지 덱을 보내고 밥이 가격 검토를 맡아 다음 주에 결정이 필요해"
          }
        },
        "ms": {
