          "stringUnit": {
            "state": "translated",
            "value": "이 메모에는 오디오가 녹음되지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada audio dirakam untuk nota ini."
          }
