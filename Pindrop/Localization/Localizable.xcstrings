    "u5_u7_replacements_run_in_order": {
      "comment": "u5_u7_replacements_run_in_order",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzungen laufen der Reihe nach. Ziehe Zeilen zum Umsortieren — der erste Treffer gewinnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los reemplazos se ejecutan en orden. Arrastra filas para reordenar: gana la primera coincidencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les remplacements s’exécutent dans l’ordre. Faites glisser pour réordonner — la première correspondance gagne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sostituzioni vengono eseguite in ordine. Trascina le righe per riordinare — vince la prima corrispondenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置換は順番に実行されます。行をドラッグして並べ替え — 最初の一致が優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치환은 순서대로 실행됩니다. 행을 끌어 재정렬 — 첫 번째 일치가 우선합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacements run in order. Drag rows to re-order — the first match wins."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervangingen lopen op volgorde. Sleep rijen om te herordenen — de eerste match wint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamienniki działają w kolejności. Przeciągnij wiersze, aby zmienić kolejność — wygrywa pierwsze dopasowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As substituições rodam em ordem. Arraste as linhas para reordenar — a primeira correspondência vence."
          }
        },
        "ro": {
          "stringUnit": {
