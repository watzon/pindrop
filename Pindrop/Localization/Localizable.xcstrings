    "also_new_rtl_layout_support_and_20_new_interface": {
      "comment": "also_new_rtl_layout_support_and_20_new_interface",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جديد أيضًا: دعم تخطيط RTL و20 لغة واجهة جديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরও নতুন: RTL লেআউট সমর্থন এবং 20টি নতুন ইন্টারফেস ভাষা।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nově také: podpora rozvržení RTL a 20 nových jazyků rozhraní."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Også nyt: RTL-layoutunderstøttelse og 20 nye grænsefladesprog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebenfalls neu: RTL-Layout-Unterstützung und 20 neue Oberflächensprachen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίσης νέο: υποστήριξη διάταξης RTL και 20 νέες γλώσσες διεπαφής."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also new: RTL layout support and 20 new interface languages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También nuevo: compatibilidad con diseños RTL y 20 nuevos idiomas de interfaz."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myös uutta: RTL-asettelun tuki ja 20 uutta käyttöliittymäkieltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Également nouveau : prise en charge des mises en page RTL et 20 nouvelles langues d’interface."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חדש גם: תמיכה בפריסת RTL ו-20 שפות ממשק חדשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह भी नया: RTL लेआउट समर्थन और 20 नई इंटरफ़ेस भाषाएँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szintén új: RTL elrendezéstámogatás és 20 új felületnyelv."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Juga baru: dukungan tata letak RTL dan 20 bahasa antarmuka baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche nuovo: supporto al layout RTL e 20 nuove lingue dell’interfaccia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのほか、RTL レイアウト対応と20の新しいインターフェイス言語も追加されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또한 RTL 레이아웃 지원과 20개의 새로운 인터페이스 언어가 추가되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Juga baharu: sokongan susun atur RTL dan 20 bahasa antara muka baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Også nytt: støtte for RTL-oppsett og 20 nye grensesnittspråk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ook nieuw: ondersteuning voor RTL-layouts en 20 nieuwe interfacetalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Również nowe: obsługa układu RTL i 20 nowych języków interfejsu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também novo: suporte a layout RTL e 20 novos idiomas de interface."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tot nou: suport pentru layout RTL și 20 de limbi noi pentru interfață."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также новое: поддержка RTL-разметки и 20 новых языков интерфейса."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Också nytt: stöd för RTL-layout och 20 nya gränssnittsspråk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใหม่ด้วย: รองรับเลย์เอาต์ RTL และภาษาอินเทอร์เฟซใหม่ 20 ภาษา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıca yeni: RTL düzen desteği ve 20 yeni arayüz dili."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також нове: підтримка RTL-макета та 20 нових мов інтерфейсу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũng mới: hỗ trợ bố cục RTL và 20 ngôn ngữ giao diện mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时新增：RTL 布局支持和 20 种新的界面语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同時新增：RTL 版面支援與 20 種新的介面語言。"
          }
        }
      }
    },
    "an_earlier_version_of_pindrop_wrote_this_note_it": {
      "comment": "An earlier version of Pindrop wrote this note. It cannot be written again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتب هذه الملاحظة إصدار أقدم من Pindrop. لا يمكن كتابتها من جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নোটটি Pindrop-এর আগের সংস্করণ লিখেছিল। এটি আবার লেখা যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto poznámku napsala starší verze Pindropu. Nelze ji napsat znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tidligere version af Pindrop skrev denne note. Den kan ikke skrives igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Version von Pindrop hat diese Notiz geschrieben. Sie kann nicht neu geschrieben werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή τη σημείωση την έγραψε παλαιότερη έκδοση του Pindrop. Δεν μπορεί να ξαναγραφτεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier version of Pindrop wrote this note. It cannot be written again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión anterior de Pindrop escribió esta nota. No se puede volver a escribir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän muistiinpanon kirjoitti Pindropin vanhempi versio. Sitä ei voi kirjoittaa uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version antérieure de Pindrop a écrit cette note. Elle ne peut pas être réécrite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה מוקדמת יותר של Pindrop כתבה את הפתק הזה. אי אפשר לכתוב אותו מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नोट Pindrop के पुराने संस्करण ने लिखा था। इसे दोबारा नहीं लिखा जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt a jegyzetet a Pindrop egy korábbi verziója írta. Nem írható meg újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan ini ditulis oleh Pindrop versi lama. Catatan ini tidak bisa ditulis ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versione precedente di Pindrop ha scritto questa nota. Non può essere riscritta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモは以前のバージョンの Pindrop が書きました。書き直すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모는 이전 버전의 Pindrop이 작성했습니다. 다시 작성할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota ini ditulis oleh Pindrop versi lama. Ia tidak boleh ditulis semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tidligere versjon av Pindrop skrev dette notatet. Det kan ikke skrives på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eerdere versie van Pindrop heeft deze notitie geschreven. Hij kan niet opnieuw worden geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tę notatkę napisała wcześniejsza wersja Pindrop. Nie można napisać jej ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão anterior do Pindrop escreveu esta nota. Ela não pode ser escrita de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O versiune anterioară a Pindrop a scris această notiță. Nu poate fi scrisă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту заметку написала более ранняя версия Pindrop. Написать её заново нельзя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tidigare version av Pindrop skrev den här anteckningen. Den kan inte skrivas om."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โน้ตนี้เขียนโดย Pindrop รุ่นก่อนหน้า จึงเขียนใหม่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu notu Pindrop'un daha eski bir sürümü yazdı. Yeniden yazılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю нотатку написала давніша версія Pindrop. Її не можна написати знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú này do một phiên bản Pindrop cũ hơn viết. Không thể viết lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条笔记由较早版本的 Pindrop 写成，无法重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則筆記由較早版本的 Pindrop 寫成，無法重新產生。"
          }
        }
      }
    },
    "an_error_occurred_while_enhancing_your_transcrip": {
      "comment": "an_error_occurred_while_enhancing_your_transcrip",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ أثناء تحسين تحويل الصوت إلى نص:\n\n%@\n\nتم حفظ النسخ الأصلي دون تحسين.\nيمكنك محاولة تمكين تحسين الذكاء الاصطناعي مرة أخرى في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ট্রান্সক্রিপশন উন্নত করার সময় একটি ত্রুটি ঘটেছে:\n\n%@\n\nমূল ট্রান্সক্রিপশনটি বর্ধিতকরণ ছাড়াই সংরক্ষণ করা হয়েছিল।\nআপনি সেটিংসে আবার AI বর্ধিতকরণ সক্ষম করার চেষ্টা করতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při vylepšování vašeho přepisu došlo k chybě:\n\n%@\n\nPůvodní přepis byl uložen bez vylepšení.\nVylepšení AI můžete zkusit znovu povolit v Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der opstod en fejl under forbedring af din transskription:\n\n%@\n\nDen originale transskription blev gemt uden forbedring.\nDu kan prøve at aktivere AI-forbedring igen i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Verbesserung Ihrer Transkription ist ein Fehler aufgetreten:\n\n%@\n\nDie ursprüngliche Transkription wurde ohne Verbesserung gespeichert.\nSie können versuchen, die KI-Verbesserung in den Einstellungen erneut zu aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρουσιάστηκε σφάλμα κατά τη βελτίωση της μεταγραφής σας:\n\n%@\n\nΗ αρχική μεταγραφή αποθηκεύτηκε χωρίς βελτίωση.\nΜπορείτε να δοκιμάσετε να ενεργοποιήσετε ξανά τη βελτίωση AI στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An error occurred while enhancing your transcription:\n\n%@\n\nThe original transcription was saved without enhancement.\nYou can try enabling AI enhancement again in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocurrió un error al mejorar tu transcripción:\n\n%@\n\nLa transcripción original se guardó sin mejora.\nPuedes volver a intentar activar la mejora con IA en Ajustes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptiota parannettaessa tapahtui virhe:\n\n%@\n\nAlkuperäinen transkriptio tallennettiin ilman parannuksia.\nVoit yrittää ottaa tekoälyn parannuksen uudelleen käyttöön asetuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s'est produite lors de l'amélioration de votre transcription :\n\n%@\n\nLa transcription originale a été enregistrée sans amélioration.\nVous pouvez réessayer d'activer l'amélioration IA dans les Paramètres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירעה שגיאה בעת שיפור התמלול שלך:\n\n%@\n\nהתמלול המקורי נשמר ללא שיפור.\nאתה יכול לנסות להפעיל שוב שיפור AI בהגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके प्रतिलेखन को बढ़ाते समय एक त्रुटि उत्पन्न हुई:\n\n%@\n\nमूल प्रतिलेखन बिना किसी संवर्द्धन के सहेजा गया था।\nआप सेटिंग्स में AI एन्हांसमेंट को फिर से सक्षम करने का प्रयास कर सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiba történt az átírás javítása közben:\n\n%@\n\nAz eredeti átírást javítás nélkül elmentettük.\nMegpróbálhatja újra engedélyezni az AI-javítást a Beállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan saat menyempurnakan transkripsi Anda:\n\n%@\n\nTranskripsi asli disimpan tanpa penyempurnaan.\nAnda dapat mencoba mengaktifkan lagi peningkatan AI di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un errore durante il miglioramento della trascrizione:\n\n%@\n\nLa trascrizione originale è stata salvata senza miglioramenti.\nPuoi provare ad abilitare nuovamente il miglioramento dell'intelligenza artificiale in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしを強化中にエラーが発生しました:\n\n%@\n\n元の文字起こしは補正なしで保存されました。\n[設定] で AI 強化を再度有効にしてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트를 개선하는 중에 오류가 발생했습니다.\n\n%@\n\n원본 전사본이 향상되지 않고 저장되었습니다.\n설정에서 AI 향상을 다시 활성화해 볼 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralat berlaku semasa meningkatkan transkripsi anda:\n\n%@\n\nTranskripsi asal telah disimpan tanpa penambahan.\nAnda boleh cuba mendayakan peningkatan AI sekali lagi dalam Tetapan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det oppstod en feil under forbedring av transkripsjonen:\n\n%@\n\nDen originale transkripsjonen ble lagret uten forbedring.\nDu kan prøve å aktivere AI-forbedring igjen i Innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een fout opgetreden bij het verbeteren van uw transcriptie:\n\n%@\n\nDe originele transcriptie is zonder verbeteringen opgeslagen.\nU kunt proberen AI-verbetering opnieuw in te schakelen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wystąpił błąd podczas ulepszania transkrypcji:\n\n%@\n\nOryginalna transkrypcja została zapisana bez ulepszeń.\nMożesz spróbować ponownie włączyć ulepszanie AI w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um erro ao aprimorar sua transcrição:\n\n%@\n\nA transcrição original foi salva sem aprimoramento.\nVocê pode tentar ativar o aprimoramento de IA novamente em Configurações."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "A apărut o eroare la îmbunătățirea transcripției:\n\n%@\n\nTranscrierea originală a fost salvată fără îmbunătățire.\nPuteți încerca să activați din nou îmbunătățirea AI în Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При расширении транскрипции произошла ошибка:\n\n%@\n\nИсходная транскрипция была сохранена без улучшений.\nВы можете попробовать снова включить улучшение AI в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fel uppstod när din transkription förbättrades:\n\n%@\n\nDen ursprungliga transkriptionen sparades utan förbättring.\nDu kan försöka aktivera AI-förbättring igen i Inställningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เกิดข้อผิดพลาดขณะปรับปรุงการถอดเสียงของคุณ:\n\n%@\n\nการถอดเสียงต้นฉบับได้รับการบันทึกโดยไม่มีการปรับปรุง\nคุณสามารถลองเปิดใช้งานการเพิ่มประสิทธิภาพ AI อีกครั้งได้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çeviri yazınız geliştirilirken bir hata oluştu:\n\n%@\n\nOrijinal transkripsiyon, geliştirme yapılmadan kaydedildi.\nAyarlar'da AI geliştirmeyi tekrar etkinleştirmeyi deneyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час покращення вашої транскрипції сталася помилка:\n\n%@\n\nОригінальна транскрипція була збережена без покращення.\nВи можете спробувати знову ввімкнути покращення ШІ в налаштуваннях."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi khi nâng cao bản chép lời của bạn:\n\n%@\n\nBản phiên âm gốc đã được lưu mà không cần cải tiến.\nBạn có thể thử bật lại tính năng nâng cao AI trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强您的转录时发生错误：\n\n%@\n\n原始转录已保存，未进行增强。\n您可以尝试在设置中再次启用 AI 增强。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "增強您的轉錄時發生錯誤：\n\n%@\n\n原始轉錄已儲存，未進行增強。\n您可以嘗試在設定中再次啟用 AI 增強。"
          }
        }
      }
    },
    "an_error_occurred_while_enhancing_your_transcrip_1790ad05": {
