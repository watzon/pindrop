    "pindrop_writes_one_from_your_notes_and_the_trans": {
      "comment": "Pindrop writes one from your notes and the transcript.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتبها Pindrop من ملاحظاتك ومن النص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop আপনার নোট আর প্রতিলিপি থেকে এটি লেখে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop ji napíše z vašich poznámek a přepisu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop skriver en ud fra dine noter og udskriften."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop schreibt sie aus Ihren Notizen und dem Transkript."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Pindrop τη γράφει από τις σημειώσεις σας και την απομαγνητοφώνηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop writes one from your notes and the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop la escribe a partir de tus notas y la transcripción."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop kirjoittaa sen muistiinpanoistasi ja tekstityksestä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop en écrit une à partir de vos notes et de la transcription."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop כותב אותו מהפתקים שלכם ומהתמליל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop इसे आपके नोट्स और प्रतिलेख से लिखता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Pindrop megírja a jegyzeteiből és az átiratból."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop menulisnya dari catatan Anda dan transkrip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop la scrive dalle tue note e dalla trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop があなたのメモと文字起こしから書きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop이 메모와 대본으로 작성합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop menulisnya daripada nota anda dan transkrip."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop skriver ett ut fra notatene dine og transkriptet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindrop schrijft er een uit je notities en het transcript."
          }
        },
        "pl": {
