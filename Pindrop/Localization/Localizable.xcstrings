    "speaker_names_were_checked_again_against_the_ful": {
      "comment": "Speaker names were checked again against the full recording.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعيد التحقق من أسماء المتحدثين مقابل التسجيل الكامل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরো রেকর্ডিং মিলিয়ে বক্তাদের নাম আবার যাচাই করা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jména mluvčích byla znovu ověřena proti celé nahrávce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Talernavnene er tjekket igen mod hele optagelsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprechernamen wurden anhand der ganzen Aufnahme erneut geprüft."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ονόματα των ομιλητών ελέγχθηκαν ξανά με βάση όλη την εγγραφή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker names were checked again against the full recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de los oradores se revisaron otra vez con toda la grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhujanimet tarkistettiin uudelleen koko tallennetta vasten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms des intervenants ont été revérifiés sur l'enregistrement complet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמות הדוברים נבדקו שוב מול ההקלטה המלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरी रिकॉर्डिंग से मिलाकर वक्ताओं के नाम फिर से जाँचे गए।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A beszélők nevét a teljes felvétel alapján újra ellenőriztük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama pembicara sudah diperiksa lagi terhadap seluruh rekaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi dei parlanti sono stati ricontrollati sull'intera registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音全体と照らして話者名をもう一度確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 녹음과 대조해 화자 이름을 다시 확인했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama penutur telah disemak semula terhadap keseluruhan rakaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Talernavnene ble sjekket på nytt mot hele opptaket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sprekersnamen zijn opnieuw gecontroleerd op de hele opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imiona mówców zostały ponownie sprawdzone na całym nagraniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes dos falantes foram conferidos de novo com a gravação inteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele vorbitorilor au fost verificate din nou pe toată înregistrarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена говорящих проверены ещё раз по всей записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Talarnamnen kontrollerades igen mot hela inspelningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจชื่อผู้พูดอีกครั้งกับการบันทึกทั้งหมดแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konuşmacı adları kaydın tamamıyla yeniden denetlendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імена мовців перевірено ще раз за всім записом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người nói đã được kiểm tra lại với toàn bộ bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已对照完整录音重新核对说话人姓名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已對照完整錄音重新核對說話者名稱。"
          }
        }
      }
    },
