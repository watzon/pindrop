    "live_speaker_names_need_the_speaker_model_downlo": {
      "comment": "Live speaker names need the speaker model. Download it to name people while you record.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج أسماء المتحدثين المباشرة إلى نموذج المتحدثين. حمّله لتسمية الأشخاص أثناء التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ বক্তার নামের জন্য বক্তা মডেল দরকার। রেকর্ড করার সময় নাম দিতে এটি ডাউনলোড করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živá jména mluvčích potřebují model mluvčích. Stáhněte ho, ať můžete lidi pojmenovat už při nahrávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-talernavne kræver talermodellen. Hent den for at give folk navne, mens du optager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Sprechernamen brauchen das Sprechermodell. Laden Sie es herunter, um Personen schon während der Aufnahme zu benennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ζωντανά ονόματα ομιλητών χρειάζονται το μοντέλο ομιλητών. Κάντε λήψη για να ονομάζετε άτομα ενώ ηχογραφείτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live speaker names need the speaker model. Download it to name people while you record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de oradores en vivo necesitan el modelo de oradores. Descárgalo para nombrar a las personas mientras grabas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikaiset puhujanimet tarvitsevat puhujamallin. Lataa se, niin voit nimetä ihmiset jo tallennuksen aikana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms d'intervenants en direct nécessitent le modèle d'intervenants. Téléchargez-le pour nommer les personnes pendant l'enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמות דוברים בזמן אמת דורשים את מודל הדוברים. הורידו אותו כדי לתת שמות לאנשים כבר בזמן ההקלטה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव वक्ता नामों के लिए वक्ता मॉडल चाहिए। रिकॉर्डिंग के दौरान लोगों को नाम देने के लिए इसे डाउनलोड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő beszélőnevekhez kell a beszélőmodell. Töltse le, hogy már felvétel közben nevet adhasson a résztvevőknek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama pembicara langsung memerlukan model pembicara. Unduh model itu untuk memberi nama orang saat merekam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi dei parlanti dal vivo richiedono il modello dei parlanti. Scaricalo per dare un nome alle persone mentre registri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ話者名には話者モデルが必要です。ダウンロードすると、録音しながら名前を付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 화자 이름에는 화자 모델이 필요합니다. 모델을 다운로드하면 녹음하면서 이름을 지정할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama penutur langsung memerlukan model penutur. Muat turun model itu untuk menamakan orang semasa anda merakam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte talernavn krever talermodellen. Last den ned for å gi folk navn mens du tar opp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live sprekersnamen hebben het sprekersmodel nodig. Download het om mensen al tijdens de opname een naam te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imiona mówców na żywo wymagają modelu mówców. Pobierz go, aby nadawać imiona już podczas nagrywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes de falantes ao vivo precisam do modelo de falantes. Baixe o modelo para nomear as pessoas enquanto você grava."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele vorbitorilor în direct au nevoie de modelul de vorbitori. Descărcați-l ca să dați nume persoanelor chiar în timpul înregistrării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для живых имён говорящих нужна модель говорящих. Скачайте её, чтобы называть людей прямо во время записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-talarnamn kräver talarmodellen. Ladda ner den för att namnge personer redan under inspelningen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อผู้พูดแบบสดต้องใช้โมเดลผู้พูด ดาวน์โหลดเพื่อตั้งชื่อผู้คนขณะบันทึกเสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı konuşmacı adları için konuşmacı modeli gerekir. Kayıt sırasında kişilere ad vermek için modeli indirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для живих імен мовців потрібна модель мовців. Завантажте її, щоб називати людей просто під час запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên người nói trực tiếp cần mô hình người nói. Hãy tải mô hình về để đặt tên cho mọi người ngay khi đang ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时说话人姓名需要说话人模型。下载后即可在录音时为每个人命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時說話者名稱需要說話者模型。下載後即可在錄音時為每個人命名。"
          }
        }
      }
    },
