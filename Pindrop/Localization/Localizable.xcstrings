    "live_names_cover_up_to_four_voices": {
      "comment": "Live names cover up to four voices.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغطي الأسماء المباشرة حتى أربعة أصوات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ নাম চারটি কণ্ঠ পর্যন্ত কাজ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živá jména pokrývají až čtyři hlasy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-navne dækker op til fire stemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Namen decken bis zu vier Stimmen ab."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ζωντανά ονόματα καλύπτουν έως τέσσερις φωνές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live names cover up to four voices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres en vivo cubren hasta cuatro voces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaaliaikaiset nimet kattavat enintään neljä ääntä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms en direct couvrent jusqu'à quatre voix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמות בזמן אמת מכסים עד ארבעה קולות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव नाम चार आवाज़ों तक काम करते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az élő nevek legfeljebb négy hangot fednek le."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama langsung mencakup sampai empat suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi dal vivo coprono fino a quattro voci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブの名前は最大 4 人分の声に対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 이름은 최대 네 사람의 목소리까지 지원합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama langsung meliputi sehingga empat suara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte navn dekker opptil fire stemmer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live namen dekken maximaal vier stemmen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Imiona na żywo obejmują do czterech głosów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes ao vivo cobrem até quatro vozes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele în direct acoperă până la patru voci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живые имена охватывают до четырёх голосов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-namn täcker upp till fyra röster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อแบบสดรองรับได้ถึงสี่เสียง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı adlar en fazla dört sesi kapsar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Живі імена охоплюють до чотирьох голосів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên trực tiếp bao được tối đa bốn giọng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时姓名最多覆盖四个声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
