    "nothing_was_transcribed_yet": {
      "comment": "Nothing was transcribed yet.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنسخ شيء بعد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কিছু প্রতিলিপি হয়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nebylo nic přepsáno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke transskriberet noget endnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde noch nichts transkribiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν απομαγνητοφωνήθηκε τίποτα ακόμη."
          }
