    "there_is_no_transcript_to_enhance_yet_record_thi": {
      "comment": "There is no transcript to enhance yet. Record this note first.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد نص لتعزيزه بعد. سجّل هذه الملاحظة أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উন্নত করার মতো প্রতিলিপি এখনও নেই। আগে এই নোট রেকর্ড করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím není co vylepšovat. Nejdřív tuto poznámku nahrajte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er endnu ingen udskrift at forbedre. Optag denne note først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch kein Transkript zum Verbessern. Nehmen Sie diese Notiz zuerst auf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη απομαγνητοφώνηση για βελτίωση. Ηχογραφήστε πρώτα αυτή τη σημείωση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no transcript to enhance yet. Record this note first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay transcripción que mejorar. Graba primero esta nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Parannettavaa tekstitystä ei ole vielä. Tallenna tämä muistiinpano ensin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de transcription à améliorer. Enregistrez d'abord cette note."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין תמליל לשפר. הקליטו קודם את הפתק הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुधारने के लिए अभी कोई प्रतिलेख नहीं है। पहले यह नोट रिकॉर्ड करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs feljavítható átirat. Előbb vegye fel ezt a jegyzetet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada transkrip untuk disempurnakan. Rekam catatan ini dulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora una trascrizione da migliorare. Registra prima questa nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強化する文字起こしがまだありません。先にこのメモを録音してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 보강할 대본이 없습니다. 먼저 이 메모를 녹음하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada transkrip untuk dipertingkat. Rakam nota ini dahulu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ikke noe transkript å forbedre ennå. Ta opp dette notatet først."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog geen transcript om te verbeteren. Neem deze notitie eerst op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze transkrypcji do ulepszenia. Najpierw nagraj tę notatkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há transcrição para aprimorar. Grave esta nota primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există o transcriere de îmbunătățit. Înregistrați mai întâi această notiță."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет транскрипта для улучшения. Сначала запишите эту заметку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget transkript att förbättra än. Spela in den här anteckningen först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีข้อความถอดเสียงให้ปรับปรุง บันทึกโน้ตนี้ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz geliştirilecek bir deşifre yok. Önce bu notu kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипта для покращення ще немає. Спершу запишіть цю нотатку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có bản chép lời để nâng cao. Hãy ghi ghi chú này trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可增强的转录。请先录制这条笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
