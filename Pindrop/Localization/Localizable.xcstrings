    "cloud_transcription_sends_recorded_audio_to_open": {
      "comment": "Cloud transcription sends recorded audio to OpenAI. OpenAI usage charges apply.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل النسخ السحابي الصوت المسجّل إلى OpenAI. تُطبَّق رسوم استخدام OpenAI."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লাউড ট্রান্সক্রিপশন রেকর্ড করা অডিও OpenAI-তে পাঠায়। OpenAI ব্যবহারের চার্জ প্রযোজ্য।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudový přepis odesílá nahraný zvuk do OpenAI. Platí poplatky za používání OpenAI."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-transskription sender optaget lyd til OpenAI. OpenAI-brugsgebyrer gælder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Transkription sendet aufgezeichnetes Audio an OpenAI. Es fallen OpenAI-Nutzungsgebühren an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μεταγραφή cloud στέλνει το ηχογραφημένο αρχείο ήχου στο OpenAI. Ισχύουν χρεώσεις χρήσης του OpenAI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud transcription sends recorded audio to OpenAI. OpenAI usage charges apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en la nube envía el audio grabado a OpenAI. Se aplican cargos de uso de OpenAI."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilvitranskriptio lähettää tallennetun äänen OpenAI:lle. OpenAI:n käyttömaksut koskevat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription cloud envoie l’audio enregistré à OpenAI. Des frais d’utilisation OpenAI s’appliquent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמלול בענן שולח את השמע המוקלט אל OpenAI. חלות עלויות שימוש של OpenAI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड ट्रांसक्रिप्शन रिकॉर्ड किया गया ऑडियो OpenAI को भेजता है। OpenAI उपयोग शुल्क लागू होते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A felhőalapú átírás a rögzített hangot az OpenAI-nak küldi. OpenAI-használati díjak merülhetnek fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi cloud mengirim audio yang direkam ke OpenAI. Biaya penggunaan OpenAI berlaku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione cloud invia l’audio registrato a OpenAI. Si applicano i costi di utilizzo di OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド文字起こしは録音した音声をOpenAIに送信します。OpenAIの利用料金が発生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 받아쓰기는 녹음된 오디오를 OpenAI로 보냅니다. OpenAI 사용 요금이 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkripsi awan menghantar audio dirakam ke OpenAI. Caj penggunaan OpenAI dikenakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skytranskripsjon sender innspilt lyd til OpenAI. OpenAI-bruksavgifter gjelder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudtranscriptie stuurt opgenomen audio naar OpenAI. Er gelden OpenAI-gebruikskosten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja w chmurze wysyła nagrane audio do OpenAI. Obowiązują opłaty za korzystanie z OpenAI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição na nuvem envia o áudio gravado para a OpenAI. Aplicam-se cobranças de uso da OpenAI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrierea în cloud trimite audio-ul înregistrat către OpenAI. Se aplică taxe de utilizare OpenAI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Облачная транскрипция отправляет записанное аудио в OpenAI. Применяются платы за использование OpenAI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Molntranskription skickar inspelat ljud till OpenAI. OpenAI-användningsavgifter tillkommer."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การถอดเสียงบนคลาวด์จะส่งเสียงที่บันทึกไปยัง OpenAI มีค่าใช้จ่ายการใช้งาน OpenAI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut yazıya dökme, kaydedilen sesi OpenAI’ye gönderir. OpenAI kullanım ücretleri geçerlidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хмарна транскрипція надсилає записане аудіо до OpenAI. Застосовуються платежі за використання OpenAI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên âm đám mây gửi âm thanh đã ghi tới OpenAI. Phí sử dụng OpenAI sẽ được áp dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端转录会将录制的音频发送至 OpenAI。将产生 OpenAI 使用费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端轉錄會將錄製的音訊傳送至 OpenAI。將產生 OpenAI 使用費用。"
          }
        }
      }
    },
