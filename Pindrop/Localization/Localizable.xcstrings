        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 버전, macOS 버전, 하드웨어 유형, 사용된 기능, 오류 범주."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi apl, versi macOS, jenis perkakasan, ciri yang digunakan, dan kategori ralat."
