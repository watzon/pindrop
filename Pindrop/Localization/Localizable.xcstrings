          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen verlaten deze Mac nooit. Audio wordt lokaal verwerkt tenzij je een cloudprovider kiest in Instellingen → AI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele nigdy nie opuszczają tego Maca. Audio jest przetwarzane lokalnie, chyba że wybierzesz dostawcę chmury w sekcji Ustawienia → AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos nunca saem deste Mac. O áudio é processado localmente, a menos que você escolha um provedor na nuvem em Ajustes → IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Models never leave this Mac. Audio is processed locally unless you choose a cloud provider in Settings → AI."
