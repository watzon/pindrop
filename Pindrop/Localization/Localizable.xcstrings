          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A frissítésellenőrzések átmenetileg nem érhetők el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan pembaruan sementara tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I controlli degli aggiornamenti sono temporaneamente non disponibili."
          }
        },
