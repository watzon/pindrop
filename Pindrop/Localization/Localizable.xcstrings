    "no_transcripts_audio_prompts_file_names_or_perso": {
      "comment": "no_transcripts_audio_prompts_file_names_or_perso",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا نسخ ولا صوت ولا مطالبات ولا أسماء ملفات ولا محتوى شخصي — أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো প্রতিলিপি, অডিও, প্রম্পট, ফাইলের নাম বা ব্যক্তিগত কনটেন্ট নয় — কখনও নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné přepisy, zvuk, prompty, názvy souborů ani osobní obsah — nikdy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen transskriptioner, lyd, prompter, filnavne eller personligt indhold — aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Transkripte, kein Audio, keine Prompts, keine Dateinamen und keine persönlichen Inhalte – niemals."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία μεταγραφή, ήχος, προτροπή, όνομα αρχείου ή προσωπικό περιεχόμενο — ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transcripts, audio, prompts, file names, or personal content — ever."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni transcripciones, ni audio, ni prompts, ni nombres de archivos, ni contenido personal — nunca."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei transkriptioita, ääntä, kehotteita, tiedostonimiä tai henkilökohtaista sisältöä — ei koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transcription, aucun audio, aucun prompt, aucun nom de fichier ni contenu personnel — jamais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תמלולים, אודיו, הנחיות, שמות קבצים או תוכן אישי — לעולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई ट्रांसक्रिप्ट, ऑडियो, प्रॉम्प्ट, फ़ाइल नाम या व्यक्तिगत सामग्री नहीं — कभी नहीं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Se átiratok, se hang, se promptok, se fájlnevek, se személyes tartalom — soha."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada transkripsi, audio, prompt, nama file, atau konten pribadi — tidak pernah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna trascrizione, nessun audio, nessun prompt, nessun nome di file né contenuto personale — mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし、音声、プロンプト、ファイル名、個人的な内容は一切ありません — 決して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전사, 오디오, 프롬프트, 파일 이름, 개인 콘텐츠는 결코 포함되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada transkripsi, audio, gesaan, nama fail, atau kandungan peribadi — tidak sekali-kali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen transkripsjoner, lyd, ledetekster, filnavn eller personlig innhold — aldri."
          }
        },
        "nl": {
          "stringUnit": {
