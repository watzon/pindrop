    "the_new_nemotron_streaming_engine_shows_words_as": {
      "comment": "the_new_nemotron_streaming_engine_shows_words_as",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض محرك Nemotron الجديد للبث الكلمات أثناء نطقها، ويتم تسخين المحرك مسبقًا عند التشغيل حتى يبدأ أول إملاء لك دون تأخير."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন Nemotron স্ট্রিমিং ইঞ্জিন আপনি বলার সঙ্গে সঙ্গে শব্দ দেখায়, আর প্রথম ডিক্টেশন যেন দেরি ছাড়াই শুরু হয় সে জন্য ইঞ্জিনটি চালুর সময় প্রিওয়ার্ম হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nový streamovací engine Nemotron zobrazuje slova tak, jak je říkáte, a při spuštění se předehřívá, takže první diktování začne bez zdržení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nye Nemotron-streamingmotor viser ordene, mens du siger dem, og motoren forvarmes ved start, så din første diktering begynder uden forsinkelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Nemotron-Streaming-Engine zeigt Wörter, während du sie sagst, und wird beim Start vorgewärmt, damit dein erstes Diktat ohne Verzögerung beginnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η νέα μηχανή ροής Nemotron εμφανίζει τις λέξεις καθώς τις λέτε και προθερμαίνεται κατά την εκκίνηση ώστε η πρώτη υπαγόρευση να ξεκινά χωρίς καθυστέρηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new Nemotron streaming engine shows words as you say them, and the engine prewarms at launch so your first dictation starts without a delay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo motor de streaming Nemotron muestra las palabras a medida que las dices y se precalienta al iniciar para que tu primer dictado comience sin demora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uusi Nemotron-suoratoistomoottori näyttää sanat sitä mukaa kun sanot ne, ja moottori esilämmitetään käynnistyksessä, jotta ensimmäinen sanelu alkaa viiveettä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau moteur de streaming Nemotron affiche les mots au moment où vous les dites et se préchauffe au lancement pour que votre première dictée démarre sans délai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע הסטרימינג החדש Nemotron מציג מילים תוך כדי הדיבור, ומתחמם מראש בהפעלה כדי שההכתבה הראשונה תתחיל ללא עיכוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया Nemotron स्ट्रीमिंग इंजन आपके बोलते ही शब्द दिखाता है, और लॉन्च पर पहले से तैयार हो जाता है ताकि आपका पहला डिक्टेशन बिना देरी शुरू हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új Nemotron streaming motor kimondás közben jeleníti meg a szavakat, és indításkor előmelegszik, hogy az első diktálás késlekedés nélkül induljon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesin streaming Nemotron baru menampilkan kata saat Anda mengucapkannya, dan mesin dipanaskan saat peluncuran agar dikte pertama Anda dimulai tanpa jeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo motore di streaming Nemotron mostra le parole mentre le dici e si preriscalda all’avvio, così la tua prima dettatura parte senza ritardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい Nemotron ストリーミングエンジンは、話したそばから言葉を表示し、起動時にプリウォームされるため、最初のディクテーションも遅延なく始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 Nemotron 스트리밍 엔진은 말하는 즉시 단어를 표시하고, 실행 시 미리 준비되어 첫 받아쓰기가 지연 없이 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjin penstriman Nemotron baharu memaparkan perkataan semasa anda menyebutnya, dan enjin diprapanaskan semasa pelancaran supaya imlak pertama bermula tanpa lengah."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nye Nemotron-strømmemotoren viser ordene mens du sier dem, og motoren forvarmes ved oppstart slik at første diktering starter uten forsinkelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nieuwe Nemotron-streamingengine toont woorden terwijl je ze uitspreekt en warmt op bij het starten, zodat je eerste dictaat zonder vertraging begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy silnik strumieniowy Nemotron pokazuje słowa w trakcie mówienia i rozgrzewa się przy uruchomieniu, aby pierwsze dyktowanie zaczęło się bez opóźnienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo mecanismo de streaming Nemotron mostra as palavras conforme você fala e é pré-aquecido na inicialização para que seu primeiro ditado comece sem atraso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Noul motor de streaming Nemotron afișează cuvintele pe măsură ce le rostești și se preîncălzește la lansare, astfel încât prima dictare pornește fără întârziere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый потоковый движок Nemotron показывает слова по мере произнесения и прогревается при запуске, чтобы первая диктовка начиналась без задержки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nya Nemotron-strömningsmotorn visar orden medan du säger dem och förvärms vid start så att din första diktering börjar utan fördröjning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอนจินสตรีมมิง Nemotron ใหม่จะแสดงคำตามที่คุณพูด และอุ่นเครื่องตอนเปิดแอปเพื่อให้การป้อนตามคำบอกครั้งแรกเริ่มได้โดยไม่ล่าช้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Nemotron akış motoru kelimeleri söylediğiniz anda gösterir ve açılışta önceden hazırlanır, böylece ilk dikteniz gecikmeden başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Новий потоковий рушій Nemotron показує слова під час мовлення та прогрівається під час запуску, щоб перше диктування починалося без затримки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ streaming Nemotron mới hiển thị từ khi bạn nói và được làm nóng sẵn khi khởi chạy để lần đọc chính tả đầu tiên bắt đầu không chậm trễ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的 Nemotron 流式引擎会在你说话时显示文字，并在启动时预热，让第一次听写也能无延迟开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新的 Nemotron 串流引擎會在你說話時顯示文字，並在啟動時預熱，讓第一次聽寫也能無延遲開始。"
          }
        }
      }
    },
    "the_note_enhancement_model_is_unavailable_check": {
      "comment": "The note enhancement model is unavailable. Check it in Settings, then try again.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نموذج تعزيز الملاحظات غير متاح. تحقق منه في الإعدادات، ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোট উন্নত করার মডেল পাওয়া যাচ্ছে না। সেটিংসে দেখে নিন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model pro vylepšování poznámek není dostupný. Zkontrolujte ho v Nastavení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen til noteforbedring er ikke tilgængelig. Tjek den i Indstillinger, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell für die Notizverbesserung ist nicht verfügbar. Prüfen Sie es in den Einstellungen und versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο βελτίωσης σημειώσεων δεν είναι διαθέσιμο. Ελέγξτε το στις Ρυθμίσεις και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note enhancement model is unavailable. Check it in Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo para mejorar notas no está disponible. Compruébalo en Ajustes y vuelve a intentarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanojen parannusmalli ei ole käytettävissä. Tarkista se Asetuksissa ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'amélioration des notes est indisponible. Vérifiez-le dans les Paramètres, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודל שיפור הפתקים אינו זמין. בדקו אותו בהגדרות, ואז נסו שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट सुधार मॉडल उपलब्ध नहीं है। सेटिंग्स में जाँचें, फिर दोबारा कोशिश करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A jegyzetfeljavító modell nem érhető el. Ellenőrizze a Beállításokban, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model penyempurnaan catatan tidak tersedia. Periksa di Pengaturan, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello per il miglioramento delle note non è disponibile. Controllalo in Impostazioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモ強化のモデルが利用できません。設定で確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모 보강 모델을 사용할 수 없습니다. 설정에서 확인한 다음 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Model peningkatan nota tidak tersedia. Semak dalam Tetapan, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen for notatforbedring er utilgjengelig. Sjekk den i Innstillinger, og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model voor notitieverbetering is niet beschikbaar. Controleer het bij Instellingen en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ulepszania notatek jest niedostępny. Sprawdź go w Ustawieniach i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de aprimoramento de notas está indisponível. Verifique-o em Configurações e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul de îmbunătățire a notițelor nu este disponibil. Verificați-l în Setări, apoi încercați din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель улучшения заметок недоступна. Проверьте её в Настройках и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen för anteckningsförbättring är inte tillgänglig. Kontrollera den i Inställningar och försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โมเดลปรับปรุงโน้ตใช้ไม่ได้ ตรวจสอบในการตั้งค่า แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not geliştirme modeli kullanılamıyor. Ayarlar'dan kontrol edin, sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель покращення нотаток недоступна. Перевірте її в Параметрах і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình nâng cao ghi chú không khả dụng. Kiểm tra trong Cài đặt, rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔记增强模型不可用。请在“设置”中检查后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "筆記增強模型無法使用。請在「設定」中檢查後重試。"
          }
        }
      }
    },
    "the_note_this_recording_belongs_to_could_not_be_opened": {
      "comment": "The note this recording belongs to could not be opened.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح الملاحظة التي ينتمي إليها هذا التسجيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই রেকর্ডিং যে নোটের, সেটি খোলা যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámku, ke které tato nahrávka patří, se nepodařilo otevřít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den note, som denne optagelse hører til, kunne ikke åbnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz, zu der diese Aufnahme gehört, konnte nicht geöffnet werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σημείωση στην οποία ανήκει αυτή η εγγραφή δεν άνοιξε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note this recording belongs to could not be opened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la nota a la que pertenece esta grabación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistiinpanoa, johon tämä tallenne kuuluu, ei voitu avata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note à laquelle appartient cet enregistrement n'a pas pu être ouverte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לפתוח את הפתק שההקלטה הזאת שייכת אליו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस नोट से यह रिकॉर्डिंग जुड़ी है, वह नहीं खुल सका।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült megnyitni a jegyzetet, amelyhez ez a felvétel tartozik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang memuat rekaman ini tidak bisa dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire la nota a cui appartiene questa registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この録音が属するメモを開けませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 녹음이 속한 메모를 열지 못했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota yang memiliki rakaman ini tidak dapat dibuka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatet dette opptaket hører til kunne ikke åpnes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitie waar deze opname bij hoort, kon niet worden geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć notatki, do której należy to nagranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a nota à qual esta gravação pertence."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notița căreia îi aparține această înregistrare nu a putut fi deschisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть заметку, к которой относится эта запись."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningen som den här inspelningen hör till kunde inte öppnas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดโน้ตที่การบันทึกนี้สังกัดอยู่ไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydın ait olduğu not açılamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити нотатку, якій належить цей запис."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được ghi chú mà bản ghi này thuộc về."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开这段录音所属的笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法打開這段錄音所屬的筆記。"
          }
        }
      }
    },
    "the_recorded_audio_could_not_be_prepared": {
      "comment": "The recorded audio could not be prepared for transcription.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تجهيز الصوت المسجَّل للنسخ."
