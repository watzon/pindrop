        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप संस्करण, macOS संस्करण, हार्डवेयर प्रकार, कौन-सी सुविधाएँ उपयोग होती हैं, और त्रुटि श्रेणियाँ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Alkalmazásverzió, macOS-verzió, hardvertípus, mely funkciókat használják, és hibakategóriák."
          }
        },
        "id": {
          "stringUnit": {
