        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appversjon, macOS-versjon, maskinvaretype, hvilke funksjoner som brukes, og feilkategorier."
          }
        },
        "nl": {
          "stringUnit": {
