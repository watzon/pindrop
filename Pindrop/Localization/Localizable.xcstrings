    "define_word_replacements_to_automatically_replac": {
      "comment": "define_word_replacements_to_automatically_replac",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد بدائل الكلمات لاستبدال كلمات أو عبارات محددة تلقائيًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয়ভাবে নির্দিষ্ট শব্দ বা বাক্যাংশ প্রতিস্থাপন করার জন্য শব্দ প্রতিস্থাপন সংজ্ঞায়িত করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Definujte náhrady slov, abyste automaticky nahradili konkrétní slova nebo fráze"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Definer orderstatninger for automatisk at erstatte specifikke ord eller sætninger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Definieren Sie Wortersatz, um bestimmte Wörter oder Phrasen automatisch zu ersetzen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ορίστε αντικαταστάσεις λέξεων για αυτόματη αντικατάσταση συγκεκριμένων λέξεων ή φράσεων"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Define word replacements to automatically replace specific words or phrases"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define word replacements to automatically replace specific words or phrases"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä sanankorvaukset korvataksesi automaattisesti tietyt sanat tai ilmaukset"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez des remplacements de mots pour remplacer automatiquement des mots ou phrases spécifiques"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדר החלפות מילים כדי להחליף אוטומטית מילים או ביטויים ספציפיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विशिष्ट शब्दों या वाक्यांशों को स्वचालित रूप से बदलने के लिए शब्द प्रतिस्थापन को परिभाषित करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Határozzon meg szócseréket bizonyos szavak vagy kifejezések automatikus helyettesítéséhez"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentukan penggantian kata untuk secara otomatis mengganti kata atau frasa tertentu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Definisci sostituzioni di parole per sostituire automaticamente parole o frasi specifiche"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語の置換を定義して、特定の単語や語句を自動的に置き換えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 단어나 문구를 자동으로 바꾸도록 단어 바꾸기를 정의하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentukan penggantian perkataan untuk menggantikan perkataan atau frasa tertentu secara automatik"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Definer orderstatninger for automatisk å erstatte spesifikke ord eller setninger"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definieer woordvervangingen om automatisch specifieke woorden of zinsdelen te vervangen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdefiniuj zamienniki słów, aby automatycznie zastępować określone słowa lub frazy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina substituições de palavras para substituir automaticamente palavras ou frases específicas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Definiți înlocuiri de cuvinte pentru a înlocui automat anumite cuvinte sau expresii"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определите замены слов для автоматической замены определенных слов или фраз."
