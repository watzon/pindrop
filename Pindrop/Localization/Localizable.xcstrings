    "preset_example_social_input": {
      "comment": "preset_example_social_input",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اممم أطلقنا للتو الوضع الداكن ويبدو رائعًا يجب أن تجربه"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আম আমরা এইমাত্র ডার্ক মোড শিপ করেছি আর এটা দারুণ দেখাচ্ছে আপনার চেষ্টা করা উচিত"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ehm právě jsme vydali tmavý režim a vypadá úžasně měl bys to zkusit"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "øh vi har lige udgivet dark mode og den ser fantastisk ud du burde prøve den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "äh wir haben gerade den dark mode veröffentlicht und er sieht fantastisch aus du solltest ihn ausprobieren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "εεε μόλις κυκλοφορήσαμε dark mode και φαίνεται απίστευτο θα έπρεπε να το δοκιμάσεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "um we just shipped dark mode and it looks amazing you should try it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "eh acabamos de lanzar el modo oscuro y se ve increíble deberías probarlo"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "öö julkaisimme juuri tumman tilan ja se näyttää mahtavalta sinun kannattaa kokeilla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "euh on vient de sortir le mode sombre et c'est superbe tu devrais essayer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אממ בדיוק שחררנו מצב כהה וזה נראה מדהים כדאי שתנסה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अम हमने अभी डार्क मोड रिलीज़ किया है और यह शानदार लग रहा है आपको आज़माना चाहिए"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "öö most adtuk ki a sötét módot és fantasztikusan néz ki ki kellene próbálnod"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "eh kami baru rilis mode gelap dan kelihatannya keren banget kamu harus coba"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ehm abbiamo appena rilasciato la dark mode e si vede fantastica dovresti provarla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "えっと ダークモードを出荷したところですごく良く見える 試すべきだよ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음 방금 다크 모드를 출시했는데 정말 멋져 보여 너도 써 봐야 해"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "eh kami baru sahaja hantar mod gelap dan nampak hebat anda patut cubanya"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "øh vi har nettopp sluppet dark mode og den ser fantastisk ut du burde prøve den"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "eh we hebben net dark mode uitgebracht en het ziet er geweldig uit je moet het proberen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "yyy właśnie wydaliśmy tryb ciemny i wygląda niesamowicie powinieneś spróbować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ãh acabamos de lançar o modo escuro e ficou incrível você deveria experimentar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "ăă tocmai am lansat dark mode și arată incredibil ar trebui să îl încerci"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "эм мы только что выпустили тёмный режим и он выглядит потрясающе тебе стоит попробовать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "öh vi har precis släppt dark mode och den ser fantastisk ut du borde prova den"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอ่อ เราเพิ่งปล่อยโหมดมืดและดูยอดเยี่ยมมาก คุณควรลอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ee az önce karanlık modu yayınladık ve harika görünüyor denemelisin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ем ми щойно випустили темний режим і він виглядає чудово тобі варто спробувати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ờ chúng tôi vừa ra mắt chế độ tối và trông tuyệt vời bạn nên thử"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗯 我们刚发布了深色模式 看起来很棒 你应该试试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗯 我們剛發布了深色模式 看起來很棒 你應該試試"
          }
        }
      }
    },
