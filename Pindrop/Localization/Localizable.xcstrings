    "app_version_macos_version_hardware_type_which_fe": {
      "comment": "app_version_macos_version_hardware_type_which_fe",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار التطبيق وإصدار macOS ونوع الجهاز والميزات المستخدمة وفئات الأخطاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ সংস্করণ, macOS সংস্করণ, হার্ডওয়্যারের ধরন, কোন বৈশিষ্ট্যগুলি ব্যবহৃত হয় এবং ত্রুটির শ্রেণি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze aplikace, verze macOS, typ hardwaru, které funkce se používají a kategorie chyb."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appversion, macOS-version, hardwaretype, hvilke funktioner der bruges, og fejlkategorier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Version, macOS-Version, Hardwaretyp, welche Funktionen genutzt werden und Fehlerkategorien."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έκδοση εφαρμογής, έκδοση macOS, τύπος υλικού, ποιες λειτουργίες χρησιμοποιούνται και κατηγορίες σφαλμάτων."
