    "u8_settings_trained_summary_format": {
      "comment": "u8_settings_trained_summary_format",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — يُستخدم لتحديد من قال ماذا في الاجتماعات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — মিটিংয়ে কে কী বলেছে তা লেবেল করতে ব্যবহৃত হয়"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — používá se k označení, kdo co řekl na schůzkách"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — bruges til at angive, hvem der sagde hvad i møder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — kennzeichnet, wer in Meetings was gesagt hat"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — χρησιμοποιείται για να επισημαίνει ποιος είπε τι στις συσκέψεις"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — used to label who said what in meetings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — se usa para etiquetar quién dijo qué en las reuniones"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — käytetään merkitsemään, kuka sanoi mitä kokouksissa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — sert à indiquer qui a dit quoi en réunion"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — משמש לתיוג מי אמר מה בפגישות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — मीटिंग में किसने क्या कहा यह लेबल करने के लिए उपयोग किया जाता है"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — arra szolgál, hogy megjelölje, ki mit mondott az értekezleteken"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — digunakan untuk menandai siapa berkata apa dalam rapat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — usato per etichettare chi ha detto cosa nelle riunioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 会議で誰が何を話したかをラベル付けします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 회의에서 누가 무엇을 말했는지 표시하는 데 사용됩니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — digunakan untuk menandakan siapa berkata apa dalam mesyuarat"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — brukes til å merke hvem som sa hva i møter"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — gebruikt om te labelen wie wat heeft gezegd in vergaderingen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — używane do oznaczania, kto co powiedział na spotkaniach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — usado para identificar quem disse o quê nas reuniões"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — folosit pentru a eticheta cine ce a spus în întâlniri"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — используется, чтобы отмечать, кто что сказал на встречах"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — används för att märka vem som sa vad i möten"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — ใช้เพื่อระบุว่าใครพูดอะไรในการประชุม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — toplantılarda kimin ne söylediğini etiketlemek için kullanılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — використовується, щоб позначати, хто що сказав на зустрічах"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — dùng để gắn nhãn ai đã nói gì trong cuộc họp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 用于标注会议中谁说了什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 用於標註會議中誰說了什麼"
          }
        }
      }
    },
    "u8_settings_update_checks_unavailable": {
      "comment": "u8_settings_update_checks_unavailable",
