    "preset_example_email_input": {
      "comment": "preset_example_email_input",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا جوردان أتحقق فقط إن وصلكَت ملاحظاتي من أمس شكرًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাই জর্ডান শুধু দেখছিলাম গতকালের নোট পেয়েছেন কিনা ধন্যবাদ"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "ahoj jordane jen kontroluju jestli jsi dostal moje poznámky ze včerejška díky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "hej jordan tjekker bare om du fik mine noter fra i går tak"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "hey jordan wollte nur fragen ob du meine notizen von gestern bekommen hast danke"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "γεια jordan απλά ελέγχω αν πήρες τις σημειώσεις μου από χθες ευχαριστώ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "hey jordan just checking if you got my notes from yesterday thanks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "hola jordan solo quería saber si recibiste mis notas de ayer gracias"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "moi jordan tarkistan vain saitko eiliset muistiinpanoni kiitos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "salut jordan je voulais juste savoir si tu as reçu mes notes d'hier merci"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היי ג'ורדן רק בודק אם קיבלת את ההערות שלי מאתמול תודה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते जॉर्डन बस जाँच रहा था कि क्या आपको कल के मेरे नोट्स मिले धन्यवाद"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "szia jordan csak ellenőrzöm hogy megkaptad-e a tegnapi jegyzeteimet köszi"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "hai jordan cuma ngecek apakah kamu dapat catatanku kemarin terima kasih"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ciao jordan volevo solo sapere se hai ricevuto le mie note di ieri grazie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やあジョーダン 昨日のメモは届いたか確認しただけ ありがとう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕 조던 어제 메모 받았는지 확인만 했어 고마워"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "hai jordan hanya menyemak jika anda terima nota saya semalam terima kasih"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "hei jordan sjekker bare om du fikk notatene mine fra i går takk"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "hey jordan even checken of je mijn notities van gisteren hebt gekregen bedankt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "cześć jordan tylko sprawdzam czy dostałeś moje notatki z wczoraj dzięki"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "oi jordan só queria saber se você recebeu minhas anotações de ontem obrigado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "salut jordan verific doar dacă ai primit notițele mele de ieri mulțumesc"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "привет джордан просто проверяю получил ли ты мои заметки вчера спасибо"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "hej jordan kollar bara om du fick mina anteckningar från igår tack"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หวัดดีจอร์แดน แค่เช็คว่าคุณได้โน้ตเมื่อวานของฉันไหม ขอบคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "selam jordan dünkü notlarımı alıp almadığını kontrol ediyordum teşekkürler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "привіт джордане просто перевіряю чи отримав ти мої нотатки вчора дякую"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chào jordan chỉ kiểm tra xem bạn đã nhận ghi chú hôm qua của tôi chưa cảm ơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨 乔丹 只是确认一下你是否收到我昨天的笔记 谢谢"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨 喬丹 只是確認一下你是否收到我昨天的筆記 謝謝"
          }
        }
      }
    },
    "preset_example_email_output": {
      "comment": "preset_example_email_output",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا جوردان،\\n\\nأتحقق فقط إن وصلتك ملاحظاتي من أمس.\\n\\nشكرًا،"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হাই জর্ডান,\\n\\nশুধু দেখছিলাম গতকালের নোট পেয়েছেন কিনা।\\n\\nধন্যবাদ,"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahoj Jordane,\\n\\nJen kontroluju, jestli jsi dostal moje poznámky ze včerejška.\\n\\nDíky,"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej Jordan,\\n\\nTjekker bare, om du fik mine noter fra i går.\\n\\nTak,"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi Jordan,\\n\\nWollte nur fragen, ob du meine Notizen von gestern bekommen hast.\\n\\nDanke,"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Γεια Jordan,\\n\\nΑπλά ελέγχω αν πήρες τις σημειώσεις μου από χθες.\\n\\nΕυχαριστώ,"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi Jordan,\n\nJust checking if you got my notes from yesterday.\n\nThanks,"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola Jordan,\\n\\nSolo quería saber si recibiste mis notas de ayer.\\n\\nGracias,"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moi Jordan,\\n\\nTarkistan vain, saitko eiliset muistiinpanoni.\\n\\nKiitos,"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut Jordan,\\n\\nJe voulais juste savoir si tu as reçu mes notes d'hier.\\n\\nMerci,"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היי ג'ורדן,\\n\\nרק בודק אם קיבלת את ההערות שלי מאתמול.\\n\\nתודה,"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमस्ते जॉर्डन,\\n\\nबस जाँच रहा था कि क्या आपको कल के मेरे नोट्स मिले।\\n\\nधन्यवाद,"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szia Jordan,\\n\\nCsak ellenőrzöm, hogy megkaptad-e a tegnapi jegyzeteimet.\\n\\nKöszi,"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai Jordan,\\n\\nCuma ngecek apakah kamu dapat catatanku kemarin.\\n\\nTerima kasih,"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciao Jordan,\\n\\nVolevo solo sapere se hai ricevuto le mie note di ieri.\\n\\nGrazie,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やあジョーダン、\\n\\n昨日のメモは届いたか確認しただけ。\\n\\nありがとう、"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕 조던,\\n\\n어제 메모 받았는지 확인만 했어.\\n\\n고마워,"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai Jordan,\\n\\nHanya menyemak jika anda terima nota saya semalam.\\n\\nTerima kasih,"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hei Jordan,\\n\\nSjekker bare om du fikk notatene mine fra i går.\\n\\nTakk,"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey Jordan,\\n\\nEven checken of je mijn notities van gisteren hebt gekregen.\\n\\nBedankt,"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cześć Jordan,\n\nTylko sprawdzam, czy dostałeś moje notatki z wczoraj.\n\nDzięki,"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi Jordan,\\n\\nSó queria saber se você recebeu minhas anotações de ontem.\\n\\nObrigado,"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut Jordan,\\n\\nVerific doar dacă ai primit notițele mele de ieri.\\n\\nMulțumesc,"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привет, Джордан,\\n\\nПросто проверяю, получил ли ты мои заметки вчера.\\n\\nСпасибо,"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hej Jordan,\\n\\nKollar bara om du fick mina anteckningar från igår.\\n\\nTack,"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หวัดดีจอร์แดน\\n\\nแค่เช็คว่าคุณได้โน้ตเมื่อวานของฉันไหม\\n\\nขอบคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Selam Jordan,\\n\\nDünkü notlarımı alıp almadığını kontrol ediyordum.\\n\\nTeşekkürler,"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Привіт, Джордане,\\n\\nПросто перевіряю, чи отримав ти мої нотатки вчора.\\n\\nДякую,"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào Jordan,\\n\\nChỉ kiểm tra xem bạn đã nhận ghi chú hôm qua của tôi chưa.\\n\\nCảm ơn,"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨乔丹，\\n\\n只是确认一下你是否收到我昨天的笔记。\\n\\n谢谢，"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗨喬丹，\\n\\n只是確認一下你是否收到我昨天的筆記。\\n\\n謝謝，"
          }
        }
      }
    },
    "preset_example_live_input": {
      "comment": "preset_example_live_input",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اممم أعتقد أنه يجب أن نطلق النسخة التجريبية بحلول الجمعة نقطة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আম মনে হয় শুক্রবারের মধ্যে বিটা শিপ করা উচিত পিরিয়ড"
