    "whatsnew_indicators_body": {
      "comment": "The Pindrop repository on GitHub is archived and read-only.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستودع Pindrop على GitHub مؤرشف وللقراءة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-এ Pindrop রিপোজিটরি আর্কাইভ করা এবং শুধু পড়ার জন্য।"
          }
        },
