    "the_selected_chunk_variant_isn_t_downloaded_yet": {
      "comment": "the_selected_chunk_variant_isn_t_downloaded_yet",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تنزيل متغير القطعة المحدد بعد. سيؤدي التبديل إلى بدء التنزيل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত খণ্ড ভেরিয়েন্টটি এখনও ডাউনলোড করা হয়নি। টগল করলে একটি ডাউনলোড শুরু হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraná varianta bloku ještě není stažena. Přepnutím se zahájí stahování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte chunk-variant er ikke downloadet endnu. Skift vil starte en download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gewählte Chunk-Variante ist noch nicht geladen. Durch das Umschalten wird ein Download gestartet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επιλεγμένη παραλλαγή κομματιού δεν έχει γίνει ακόμη λήψη. Η εναλλαγή θα ξεκινήσει μια λήψη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected chunk variant isn't downloaded yet. Toggling will start a download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La variante seleccionada aún no se ha descargado. Al cambiar se iniciará una descarga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittua kappaleversiota ei ole vielä ladattu. Vaihtaminen käynnistää latauksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La variante sélectionnée n'est pas encore téléchargée. Basculer lancera un téléchargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסת הנתח שנבחרה עדיין לא הורדה. החלפה תתחיל הורדה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित चंक संस्करण अभी तक डाउनलोड नहीं हुआ है। टॉगल करने से डाउनलोड प्रारंभ हो जाएगा."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kiválasztott darabváltozat még nincs letöltve. A váltás elindítja a letöltést."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Varian potongan yang dipilih belum diunduh. Beralih akan memulai pengunduhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La variante selezionata non è ancora scaricata. Cambiare avvierà un download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したチャンク版はまだダウンロードされていません。切り替えるとダウンロードが始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 청크 변형이 아직 다운로드되지 않았습니다. 전환하면 다운로드가 시작됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Varian bahagian yang dipilih belum dimuat turun lagi. Togol akan memulakan muat turun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte delvarianten er ikke lastet ned ennå. Bytte vil starte en nedlasting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde chunk-variant is nog niet gedownload. Omschakelen start een download."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany wariant fragmentu nie został jeszcze pobrany. Przełączenie rozpocznie pobieranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A variante selecionada ainda não foi baixada. Alternar iniciará um download."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Varianta de bucată selectată nu este încă descărcată. Comutarea va începe o descărcare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный вариант фрагмента еще не загружен. При переключении начнется загрузка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda chunkvarianten har inte laddats ner ännu. Växling startar en nedladdning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ได้ดาวน์โหลดชุดย่อยที่เลือก การสลับจะเริ่มการดาวน์โหลด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili yığın varyantı henüz indirilmedi. Değiştirmek bir indirme başlatacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибраний варіант блоку ще не завантажено. Перемикання почне завантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến thể đoạn đã chọn chưa được tải xuống. Chuyển đổi sẽ bắt đầu tải xuống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选的分块变体尚未下载。切换将开始下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選的分塊變體尚未下載。切換將開始下載。"
          }
        }
      }
    },
    "the_transcript_fills_in_as_you_speak": {
      "comment": "The transcript fills in as you speak.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمتلئ النص أثناء حديثك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি বলার সঙ্গে সঙ্গে প্রতিলিপি ভরে ওঠে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepis se doplňuje, zatímco mluvíte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udskriften fyldes ud, mens du taler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript füllt sich, während Sie sprechen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απομαγνητοφώνηση συμπληρώνεται όσο μιλάτε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transcript fills in as you speak."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se llena mientras hablas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstitys täydentyy, kun puhut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription se remplit pendant que vous parlez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמליל מתמלא בזמן שאתם מדברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बोलते जाएँ, प्रतिलेख भरता जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az átirat beszéd közben töltődik fel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip terisi sementara Anda berbicara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione si riempie mentre parli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すにつれて文字起こしが埋まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 동안 대본이 채워집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip terisi sambil anda bercakap."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptet fylles ut mens du snakker."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het transcript vult zich terwijl je praat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrypcja wypełnia się, gdy mówisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição se preenche enquanto você fala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcrierea se completează în timp ce vorbiți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт заполняется, пока вы говорите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkriptet fylls på medan du pratar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความถอดเสียงจะเติมขึ้นขณะที่คุณพูด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz konuştukça deşifre dolar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транскрипт заповнюється, поки ви говорите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chép lời được điền vào trong lúc bạn nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说话时转录会随之填入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你說話時逐字稿會隨之填入。"
          }
        }
      }
    },
